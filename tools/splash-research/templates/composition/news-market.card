# ledger composition-news-market@1.0.0
theme taskplan_light
# News leads; the two quotes support it. Keep article titles short and put
# explanations in wrapping body roles. All editorial content is host data.
source facts sys.dataset(id: "composition", fields: [title, subtitle, summary, coverage, status, as_of, metric1_label, metric1_value, metric2_label, metric2_value, pick1_title, pick1_body, pick1_source, url1, pick2_title, pick2_body, pick2_source, url2, pick3_title, pick3_body, pick3_source, url3, evidence_title, evidence_body])
source page sys.link(fields: [url])
state tab { shape: enum[headlines, markets, sources], initial: .headlines }
event headlines { tab: set(.headlines) }
event markets { tab: set(.markets) }
event sources { tab: set(.sources) }
event open_source { page: set($value) }
copy headlines { class: vocabulary, en: "Headlines" }
copy markets { class: vocabulary, en: "Markets" }
copy sources { class: vocabulary, en: "Sources" }
copy lead { class: vocabulary, en: "IN FOCUS" }
copy outlook { class: vocabulary, en: "THE OUTLOOK" }
copy read { class: vocabulary, en: "Read story ↗" }
copy quote { class: vocabulary, en: "View quote ↗" }
view root Surface(pad: .page) { Col(gap: 20) {
  Col(gap: 6) {
    TextTitle(text: facts.title, width: .fill)
    TextCaption(text: facts.subtitle, width: .fill)
  }
  Row(gap: 8) {
    Chip(text: copy.headlines, on_tap: headlines, active: tab == .headlines)
    Chip(text: copy.markets, on_tap: markets, active: tab == .markets)
    Chip(text: copy.sources, on_tap: sources, active: tab == .sources)
  }
  when tab == .headlines { Col(gap: 20) {
    Col(gap: 10) {
      TextEyebrow(text: copy.lead)
      TextTitle(text: facts.pick2_title, width: .fill)
      TextBody(text: facts.pick2_body, width: .fill)
      Row(gap: 8) {
        TextCaption(text: facts.pick2_source, width: .fill)
        when facts.url2 != "" { Row(width: .fit, on_tap: open_source, value: facts.url2) { TextRow(text: copy.read) } }
      }
    }
    Rule()
    Col(gap: 10) {
      TextEyebrow(text: copy.outlook)
      TextTitle(text: facts.pick3_title, width: .fill)
      TextBody(text: facts.pick3_body, width: .fill)
      Row(gap: 8) {
        TextCaption(text: facts.pick3_source, width: .fill)
        when facts.url3 != "" { Row(width: .fit, on_tap: open_source, value: facts.url3) { TextRow(text: copy.read) } }
      }
    }
    quotes
  } }
  when tab == .markets { Col(gap: 20) {
    quotes
    TextTitle(text: facts.pick1_title, width: .fill)
    TextBody(text: facts.pick1_body, width: .fill)
    TextBody(text: facts.summary, width: .fill)
    when facts.url1 != "" { Chip(text: copy.quote, on_tap: open_source, value: facts.url1) }
  } }
  when tab == .sources { Col(gap: 16) {
    TextTitle(text: facts.evidence_title, width: .fill)
    TextCaption(text: facts.as_of, width: .fill)
    TextBody(text: facts.coverage, width: .fill)
    Rule()
    TextBody(text: facts.evidence_body, width: .fill)
  } }
} }
view quotes Panel { Col(gap: 12) {
  TextCaption(text: facts.pick1_source, width: .fill)
  Row(gap: 16) {
    Col(width: .fill, gap: 6) {
      TextCaption(text: facts.metric1_label, width: .fill)
      TextTitle(text: facts.metric1_value, width: .fill)
    }
    Col(width: .fill, gap: 6) {
      TextCaption(text: facts.metric2_label, width: .fill)
      TextTitle(text: facts.metric2_value, width: .fill)
    }
  }
} }
