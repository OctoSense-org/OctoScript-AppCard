# ledger composition-composition@1.0.0
theme atro_light
source facts sys.dataset(id: "composition", fields: [title, subtitle, summary, coverage, status, as_of, metric1_label, metric1_value, metric2_label, metric2_value, pick1_title, pick1_body, pick1_source, url1, pick2_title, pick2_body, pick2_source, url2, pick3_title, pick3_body, pick3_source, url3, evidence_title, evidence_body])
source page sys.link(fields: [url])
state tab { shape: enum[summary, evidence], initial: .summary }
event summary { tab: set(.summary) }
event evidence { tab: set(.evidence) }
event open_source { page: set($value) }
copy summary { class: vocabulary, en: "Plan" }
copy evidence { class: vocabulary, en: "Evidence" }
copy source { class: vocabulary, en: "Open source ↗" }
view root Surface(pad: .page) { Col(gap: 12) {
TextTitle(text: facts.title, width: .fill)
TextCaption(text: facts.subtitle, width: .fill)
Row(gap: 10) { Chip(text: copy.summary, on_tap: summary) Chip(text: copy.evidence, on_tap: evidence) }
when tab == .summary { Col(gap: 12) {
Panel { Col(gap: 8) { TextBody(text: facts.summary, width: .fill) } }
Row(gap: 12) {
 Col(width: .fill) { Card { Col(gap: 6) { TextCaption(text: facts.metric1_label) TextBody(text: facts.metric1_value, width: .fill) } } }
 Col(width: .fill) { Card { Col(gap: 6) { TextCaption(text: facts.metric2_label) TextBody(text: facts.metric2_value, width: .fill) } } }
}
Panel { Col(gap: 8) {
 TextBody(text: facts.pick1_title, width: .fill)
 TextBody(text: facts.pick1_body, width: .fill)
 TextCaption(text: facts.pick1_source, width: .fill)
 when facts.url1 != "" { Chip(text: copy.source, on_tap: open_source, value: facts.url1) }
} }
Panel { Col(gap: 8) {
 TextBody(text: facts.pick2_title, width: .fill)
 TextBody(text: facts.pick2_body, width: .fill)
 TextCaption(text: facts.pick2_source, width: .fill)
 when facts.url2 != "" { Chip(text: copy.source, on_tap: open_source, value: facts.url2) }
} }
Panel { Col(gap: 8) {
 TextBody(text: facts.pick3_title, width: .fill)
 TextBody(text: facts.pick3_body, width: .fill)
 TextCaption(text: facts.pick3_source, width: .fill)
 when facts.url3 != "" { Chip(text: copy.source, on_tap: open_source, value: facts.url3) }
} }
TextCaption(text: facts.coverage, width: .fill)
} }
when tab == .evidence { Col(gap: 12) { TextTitle(text: facts.evidence_title, width: .fill) TextBody(text: facts.evidence_body, width: .fill) TextCaption(text: facts.as_of, width: .fill) TextBody(text: facts.coverage, width: .fill) } }
} }
