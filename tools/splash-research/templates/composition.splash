use mod.composition
use mod.std.array

// The admitted job list is data. The template fixes scheduling and dependencies.
let tasks = []
for job in request.jobs {
    array.push(tasks, composition.fetch(job))
}
let evidence = []
for task in tasks {
    let result = task.await()
    array.push(evidence, result)
}
// Only interpretation requires the model; tool choice is already resolved.
let answer = composition.synthesize({intent: request.intent, plan: request.plan, evidence: evidence}).await()
{answer: answer, evidence: evidence}
