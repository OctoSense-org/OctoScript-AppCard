use mod.research
use mod.std.array
use mod.std.assert

// Non-English searches need English index terms before parallel discovery.
// This fixed step translates a query; it does not choose or call other tools.
let search = request.search
if request.normalize_query {
    let translated = research.query({query: request.search.topic}).await()
    search = {topic: translated.query, limit: request.search.limit, max_age_hours: request.search.max_age_hours}
}
let found = research.search(search).await()
assert(array.len(found.items) <= 3)
let tasks = []
for item in found.items {
    array.push(tasks, research.article({id: item.id}))
}
let articles = []
let missing = 0
for task in tasks {
    let article = try task.await() catch nil
    if article == nil {
        missing = missing + 1
    } else {
        array.push(articles, article)
    }
}

// Summarize directly in the requested language, in one model call.
// The host supplies the model, prompt, output schema and budgets.
let digest = nil
if array.len(articles) > 0 {
    let resolved = try research.digest({articles: articles, language: request.language}).await() catch nil
    digest = resolved
}
let status = "ready"
if missing > 0 || found.source.partial || array.len(found.items) == 0 {
    status = "partial"
}
if array.len(articles) > 0 && digest == nil {
    status = "partial"
}
{
    schema_id: "news-digest.v1"
    status: status
    data: {articles: articles, digest: digest, language: request.language, missing: missing, discovery: found.source}
}
