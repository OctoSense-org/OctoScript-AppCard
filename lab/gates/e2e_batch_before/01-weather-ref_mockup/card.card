# ledger florence-weather@1.0.0
# level:   L0
# profile: ui/l0
# model:   weather

theme vibrant

# The reading now and the days ahead are two sources, not one. `sys.weather`
# with `days:` answers a collection — `week.days` — and the bounds the bars are
# scaled against; the hero needs a record, so asking a single source for both
# leaves `temp` and `cond` unresolved where the hero reads them.
source place      sys.geocode(name: "Florence, Italy")
source now        sys.weather(lat: place.lat, lon: place.lon, fields: [temp, cond])
source week       sys.weather(lat: place.lat, lon: place.lon, days: 4,
                              fields: [dayname, cond, hi, lo],
                              aggregate: [min_lo, max_hi])
source env.locale sys.locale()

state units { shape: enum[c, f], initial: env.locale.temp_unit }

# Two bands over a page that carries the colour, a wide margin, the number
# dominant and hard left — a Col starts its children, so that is the default.
view root Surface(pad: .page) {
  Col(gap: 24) {

    Panel {
      Col(gap: 4) {
        TextEyebrow(text: place.name)
        TextHero(value: now.temp, unit: units)
        # `width: .fit`: a row fills by default, and a filling row would stretch
        # its gap the whole width of the page.
        Row(width: .fit, align: .center, gap: 8) {
          WeatherIcon(cond: now.cond, size: .row)
          TextRow(text: now.cond)
        }
        when now.$state == .pending { TextRow(text: "Reading the sky") }
        when now.$state == .failed  { TextRow(text: "No weather right now") }
      }
    }

    # The day column is the only fixed width here — `.day` is a laid-out token,
    # while a temperature sizes to its own run so a two-digit reading is never
    # given a column narrower than its glyphs.
    Panel {
      Col(gap: 10) {
        TextTitle(text: "The days ahead")
        for d in week.days key d.dayname {
          Row(align: .center, gap: 12) {
            TextRow(text: d.dayname, width: .day)
            WeatherIcon(cond: d.cond, size: .row)
            TempBar(lo: d.lo, hi: d.hi, min: week.min_lo, max: week.max_hi)
            TextValue(value: d.hi, unit: units)
          }
        }
      }
    }
  }
}