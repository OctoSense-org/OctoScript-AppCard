# ledger city_things_to_do @ 1.0.0
# level: L0
# profile: ui/l0

theme vibrant

state city { shape: text, initial: "Kyoto" }

source place sys.geocode(name: state.city)
source spots sys.places(lat: place.lat, lon: place.lon, category: "attraction", count: 3, fields: [name, distance, category])

component Suggestion(spot: record) {
  view Panel {
         Col(gap: 6) {
           TextTitle(text: spot.name)
           Row(align: .baseline, gap: 8) {
             TextCaption(text: spot.category)
             TextValue(value: spot.distance, unit: .distance)
           }
         }
       }
}

view root Surface(pad: .page) {
  Col(align: .center, gap: 28) {

    Panel {
      Col(align: .center, gap: 10) {
        TextEyebrow(text: "THINGS TO DO")
        TextHero(text: place.name)
      }
    }

    when spots.$state == .pending { TextRow(text: "Looking for somewhere to go …") }
    when spots.$state == .failed  { TextRow(text: "No suggestions right now.") }

    when spots.$state != .pending {
      when spots.$state != .failed {
        Suggestion(spot: spots.0)
        Suggestion(spot: spots.1)
        Suggestion(spot: spots.2)
      }
    }

  }
}