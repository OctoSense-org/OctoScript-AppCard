# ledger citydo @ 1.0.0
# level: L0
# profile: ui/l0

theme vibrant

state city { shape: text, initial: "Lisbon" }

source place sys.geocode(name: state.city)
source spots sys.places(lat: place.lat, lon: place.lon, category: "attraction", count: 3, fields: [id, name, distance, category])

view root Surface(pad: .page) {
  Col(gap: 28) {

    Col(align: .center, gap: 4) {
      TextEyebrow(text: "Things to do in")
      TextHero(text: place.name)
    }

    Col(align: .center) {
      TextCaption(text: place.country)
    }

    Rule()

    Panel {
      when spots.$state == .pending { TextRow(text: "Looking around") }
      when spots.$state == .failed { TextRow(text: "No connection") }
      Col(gap: 20) {
        for s in spots key s.id {
          Col(gap: 4) {
            TextTitle(text: s.name)
            Row(gap: 10) {
              TextCaption(text: s.category)
              TextCaption(value: s.distance, unit: .distance)
            }
          }
        }
      }
    }

    TextCaption(text: "Distances from the city centre")
  }
}