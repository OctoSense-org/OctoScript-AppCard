# ledger florence-weather@1.0.0
# level:   L0
# profile: ui/l0
# model:   weather

# What stood in this file was prose, not a card — the checker read its em dash
# at 3:49 as `unexpected character`, so no gate ever ran and no earlier source
# survived to correct. Re-authored against the same reference: the page holds
# the colour, one number dominates ~8.5:1, the column is centred, four bands.
theme vibrant

# The reading now and the days ahead are two sources, not one. `sys.weather`
# with `days:` answers a collection — `week.days` — and the bounds every bar is
# scaled against; the hero needs a record, so one source cannot serve both.
source place      sys.geocode(name: state.city)
source now        sys.weather(lat: place.lat, lon: place.lon,
                              fields: [temp, feels, hi, lo, cond, humidity, wind])
source week       sys.weather(lat: place.lat, lon: place.lon, days: state.days,
                              fields: [dayname, cond, hi, lo],
                              aggregate: [min_lo, max_hi])
source env.locale sys.locale()

state city  { shape: text, initial: "Florence, Italy" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state days  { shape: number, initial: 4 }

# Four bands, centred, over a page that carries the colour itself. The card
# names roles and never a colour — the palette is spliced in beside it.
view root Surface(pad: .page) {
  Col(align: .center, gap: 26) {

    Col(align: .center, gap: 2) {
      TextEyebrow(text: place.name)
      TextCaption(text: place.country)
    }

    # The hero band. `value:` with `unit:` is a role argument pair — L0 has no
    # arithmetic, so the degree cannot be concatenated onto the number.
    Col(align: .center, gap: 6) {
      WeatherIcon(cond: now.cond, size: .hero)
      TextHero(value: now.temp, unit: units)
      TextBody(text: now.cond)
      # `width: .fit`: a row fills by default, and a filling row would stretch
      # its gap across the whole page.
      Row(width: .fit, align: .baseline, gap: 6) {
        TextCaption(text: "Feels like")
        TextCaption(value: now.feels, unit: units)
      }
      when now.$state == .pending { TextCaption(text: "Reading the sky") }
      when now.$state == .failed  { TextCaption(text: "No weather right now") }
    }

    # The day column is the only fixed width here — `.day` is a laid-out token,
    # while a temperature sizes to its own run, so a two-digit reading is never
    # given a column narrower than its glyphs.
    Col(width: .fill, gap: 10) {
      TextTitle(text: "The days ahead")
      for d in week.days key d.dayname {
        Row(width: .fill, align: .center, gap: 12) {
          TextCaption(text: d.dayname, width: .day)
          WeatherIcon(cond: d.cond, size: .row)
          TextCaption(value: d.lo, unit: units, width: .temp)
          TempBar(lo: d.lo, hi: d.hi, min: week.min_lo, max: week.max_hi)
          TextCaption(value: d.hi, unit: units, width: .temp)
        }
      }
    }

    Row(width: .fill, align: .center, gap: 12) {
      Tile(label: "High",     value: now.hi,       unit: units)
      Tile(label: "Humidity", value: now.humidity, unit: .pct)
      Tile(label: "Wind",     value: now.wind,     unit: .speed)
    }
  }
}