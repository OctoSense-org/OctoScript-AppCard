# ledger transit @ 1.0.0
# level: L0
# profile: ui/l0

theme vibrant

# `sys.transit` is not a helper the catalog grants, and nothing in it answers
# when the next service leaves — no line, no headsign, no platform, no count of
# minutes. A departure time written here would be a figure the card invented,
# and naming a source that was never granted is refused at parse.
#
# So the subject stays transit and the composition stays exactly as it was —
# four bands, one figure dominating everything around it, centred, the page
# carrying the colour — and the question moves to the nearest one the catalog
# can answer honestly: the stops around you, and how long it takes to reach the
# closest. `sys.places` takes no `offset`, so the nearest stop is both the
# hero's subject and the first row; there is no second query that skips it.
source here   sys.gps()
source stops  sys.places(lat: here.lat, lon: here.lon, category: "transit", count: 4,
                         fields: [id, name, distance, lat, lon])
source walk   sys.route(from_lat: here.lat, from_lon: here.lon,
                        to_lat: stops.0.lat, to_lon: stops.0.lon,
                        mode: "walk", fields: [duration, distance])

# A status line is a band of the page, not a fifth line inside a panel's stack.
# Hoisted here, every panel keeps the same rows in every state.
view root Surface(pad: .page) {
  when here.$state  == .failed  { TextBody(text: "Location unavailable") }
  when stops.$state == .pending { TextBody(text: "Finding stops near you") }
  when stops.$state == .failed  { TextBody(text: "No stops could be reached") }

  Col(gap: 24) {

    Panel {
      Col(align: .center, gap: 2) {
        TextEyebrow(text: "NEAREST STOP")
        TextTitle(text: stops.0.name)
      }
    }

    Panel {
      Col(align: .center, gap: 6) {
        TextEyebrow(text: "ON FOOT")
        TextHero(text: walk.duration)
        TextCaption(text: "from where you are now")
      }
    }

    # Two columns, not three. A caption fills by default, so a third would split
    # the row into thirds and the name would never get the slack this line was
    # written to give it.
    Panel {
      Col(gap: 12) {
        TextCaption(text: "Stops nearby")
        for s in stops key s.id {
          Row(width: .fill, align: .center, gap: 12) {
            TextRow(text: s.name, width: .fill)
            TextValue(value: s.distance)
          }
        }
      }
    }

    Panel {
      Col(align: .center, gap: 4) {
        TextEyebrow(text: "WALKING DISTANCE")
        TextValue(value: walk.distance)
      }
    }
  }
}