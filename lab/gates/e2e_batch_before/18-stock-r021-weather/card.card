# ledger stock @ 1.0.0
# level: L0
# profile: ui/l0

theme vibrant

source quote sys.quote(ticker: "NVDA", fields: [ticker, name, last, change, pct, high, low, prev, volume, exchange])

view root Surface(pad: .page) {

  Panel {
    Col(align: .start) {
      TextEyebrow(text: quote.ticker)
      TextTitle(text: quote.name)
    }
  }

  Panel {
    Col(align: .start) {
      TextHero(value: quote.last, format: .money)
      Row(width: .fit, align: .baseline) {
        TextValue(value: quote.change, format: .signed_money, tint: quote.change)
        TextValue(value: quote.pct, format: .signed_pct, tint: quote.change)
      }
    }
  }

  Panel {
    Grid(cols: 2) {
      Tile(label: "Day high", value: quote.high, format: .money)
      Tile(label: "Day low", value: quote.low, format: .money)
      Tile(label: "Prev close", value: quote.prev, format: .money)
      Tile(label: "Volume", value: quote.volume, format: .compact)
    }
  }

  Panel {
    when quote.$state == .pending { TextCaption(text: "Fetching the last trade") }
    when quote.$state == .failed { TextCaption(text: "No connection to the market") }
    when quote.$state == .stale { TextCaption(text: "Last known price") }
    TextCaption(text: quote.exchange)
  }
}