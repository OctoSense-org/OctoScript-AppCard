# ledger news@1.0.0
# level:   L0
# profile: ui/l0

theme vibrant

source lead  sys.news(count: 1, offset: 0, fields: [id, title, author, points])
source rest  sys.news(count: 4, offset: 1, fields: [id, title])

view root Surface(pad: .page) {
  Col(align: .start, gap: 6) {

    when lead.$state == .pending { TextRow(text: "Fetching the wire") }
    when lead.$state == .failed  { TextRow(text: "The wire is unreachable") }

    when lead.$state != .pending {

      Col(align: .start) {
        TextEyebrow(text: "TOP STORY")
        TextHero(text: lead.title)
        Row(width: .fit, align: .center, gap: 8) {
          TextRow(text: lead.author)
          TextValue(value: lead.points)
          TextRow(text: "points")
        }
      }

      Rule()

      Col(align: .start) {
        for s in rest key s.id {
          TextRow(text: s.title, width: .fill)
        }
      }
    }
  }
}