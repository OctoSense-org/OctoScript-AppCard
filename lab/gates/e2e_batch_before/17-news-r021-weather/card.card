# ledger news@1.0.0
# level:   L0
# profile: ui/l0

# The reference puts the colour in the PAGE, so the mood is declared and nothing
# below names a colour, a size or a rule weight. Those are the kit's answer to a
# role, and a card that wrote them would outlive its own theme by one edit.
theme vibrant

# Two binds of one capability, not one bind and a derived slice: the profile
# refuses `feed.rest` (amendment #8), because a sub-collection is the thin end of
# computation. The runtime shapes the data; the view does not reshape it.
source lead sys.news(count: 1, offset: 0, fields: [title, author, points, comments])
source feed sys.news(count: 4, offset: 1, fields: [id, title])

copy lede    { class: vocabulary, en: "Top story" }
copy more    { class: vocabulary, en: "More headlines" }
copy loading { class: vocabulary, en: "Fetching the wire" }
copy offline { class: vocabulary, en: "The wire is unreachable" }

view root Surface(pad: .page) {

  # Three exclusive states, so "still loading" and "the network is down" never
  # render as the same empty page.
  when lead.$state == .pending { TextRow(text: copy.loading) }
  when lead.$state == .failed  { TextRow(text: copy.offline) }

  when lead.$state != .pending {

    # FOUR bands, and the second one is the card. One TextHero on the page and
    # no other large role anywhere: the dominance the reference holds is a
    # property of which roles were chosen, not of a size this card could write.
    # Left throughout — the bands are registers of one measure, flush to the
    # margin the page pad sets.
    Col(align: .start, gap: 22, width: .fill) {

      # one — masthead
      Col(align: .start, gap: 12, width: .fill) {
        TextEyebrow(text: copy.lede)
        Rule()
      }

      # two — the lead. The whole reason the card exists, and the only thing on
      # it at hero weight.
      TextHero(text: lead.title)

      # three — the standfirst, subordinate and full measure under the headline.
      # A count and its word are a value and a suffix on ONE role. There is no
      # `lead.points + " points"` to write: L0 has no arithmetic, and string
      # concatenation is arithmetic.
      Row(width: .fit, align: .center, gap: 12) {
        TextBody(text: lead.author)
        TextCaption(value: lead.points, suffix: " points")
        TextCaption(value: lead.comments, suffix: " comments")
      }

      # four — the rest of the wire as ONE group, not four. A rule per headline
      # would read as a dense list, which is the composition this reference is
      # the opposite of.
      Col(align: .start, gap: 16, width: .fill) {
        Rule()
        TextEyebrow(text: copy.more)
        for s in feed key s.id {
          TextRow(text: s.title, width: .fill)
        }
      }
    }
  }
}