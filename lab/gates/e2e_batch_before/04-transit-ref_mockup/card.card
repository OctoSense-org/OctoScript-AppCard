# ledger transit@1.0.0
# level:   L0
# profile: ui/l0

theme vibrant

# A note that belongs in the card rather than beside it: the catalog has NO
# departures capability. Nothing answers when the next service leaves, and
# there is no timetable source to bind, so a departure time written here would
# be a fact the model invented — which is exactly what the no-facts rule
# refuses, and naming a sys.transit that was never granted is refused at parse.
# What this card shows is the nearest question the catalog can answer honestly:
# the transit stops around you, and how long it takes to reach the closest one.
# The composition the brief asks for is unchanged — one dominant hero over
# subordinate rows, two bands, hero left, the ground carrying the colour.
#
# sys.places takes no offset, so the nearest stop is both the hero's subject
# and the first row. The news card separates a lead from its feed with a second
# query at offset 1; there is no such argument here, and a derived
# sub-collection is refused by amendment 8.

source here  sys.gps()
source stops sys.places(lat: here.lat, lon: here.lon, category: "transit", count: 4, fields: [id, name, distance, lat, lon])
source walk  sys.route(from_lat: here.lat, from_lon: here.lon, to_lat: stops.0.lat, to_lon: stops.0.lon, mode: "walk", fields: [duration, distance])

view root Surface(pad: .page) {
  Col(align: .start, gap: 22) {

    when here.$state == .failed   { TextRow(text: "Location unavailable") }
    when stops.$state == .pending { TextRow(text: "Finding stops near you") }
    when stops.$state == .failed  { TextRow(text: "No stops could be reached") }

    when stops.$state != .pending {

      # Band one. Three lines, and only the middle one is the card — the
      # eyebrow says where and the caption says how, so the hero carries a
      # single figure and nothing competes with it.
      Col(align: .start, gap: 4) {
        TextEyebrow(text: stops.0.name)
        TextHero(text: walk.duration)
        TextCaption(text: "on foot from here")
      }

      Rule()

      # Band two. A Col starts its children, so the rows need no alignment of
      # their own; the name takes the slack and the distance sits at the edge.
      Col(align: .start, gap: 14) {
        TextCaption(text: "Stops nearby")
        for s in stops key s.id {
          Row(width: .fill, align: .center, gap: 12) {
            TextRow(text: s.name, width: .fill)
            TextValue(value: s.distance)
          }
        }
      }
    }
  }
}