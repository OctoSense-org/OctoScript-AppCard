# ledger weather_florence @ 1.0.0
# level: L0

theme vibrant

state city { shape: text, initial: "Florence, Italy" }

source env.locale  sys.locale()
source place       sys.geocode(name: state.city)
source now         sys.weather(lat: place.lat, lon: place.lon, fields: [temp, feels, hi, lo, cond, humidity, wind])
source week        sys.weather(lat: place.lat, lon: place.lon, days: 5, fields: [dayname, hi, lo, cond], aggregate: [min_lo, max_hi])

copy loading  { class: vocabulary, en: "Updating", it: "Aggiornamento" }
copy offline  { class: vocabulary, en: "Offline", it: "Non in linea" }
copy feels    { class: vocabulary, en: "Feels like", it: "Percepita" }
copy ahead    { class: vocabulary, en: "Days ahead", it: "Prossimi giorni" }
copy high     { class: vocabulary, en: "High", it: "Massima" }
copy humid    { class: vocabulary, en: "Humidity", it: "Umidità" }
copy wind     { class: vocabulary, en: "Wind", it: "Vento" }

view root Surface(pad: .page) {
  Col(align: .center, gap: 28) {

    Col(align: .center, gap: 2) {
      TextEyebrow(text: place.name)
      TextCaption(text: place.country)
    }

    Col(align: .center, gap: 4) {
      WeatherIcon(cond: now.cond, size: .hero)
      TextHero(value: now.temp, unit: env.locale.temp_unit)
    }

    Col(align: .center, gap: 6) {
      TextBody(text: now.cond)
      when now.$state == .pending { TextCaption(text: copy.loading) }
      when now.$state == .failed  { TextCaption(text: copy.offline) }
      Row(width: .fit, align: .baseline, gap: 6) {
        TextCaption(text: copy.feels)
        TextCaption(value: now.feels, unit: env.locale.temp_unit)
      }
    }

    Col(width: .fill, gap: 10) {
      TextCaption(text: copy.ahead)
      for d in week.days key d.dayname {
        Row(width: .fill, align: .center, gap: 12) {
          TextCaption(text: d.dayname, width: .day)
          WeatherIcon(cond: d.cond, size: .row)
          TextCaption(value: d.lo, unit: env.locale.temp_unit, width: .temp)
          TempBar(lo: d.lo, hi: d.hi, min: week.min_lo, max: week.max_hi)
          TextCaption(value: d.hi, unit: env.locale.temp_unit, width: .temp)
        }
      }
    }

    Row(width: .fill, align: .center, gap: 12) {
      Tile(label: copy.high,  value: now.hi,       unit: env.locale.temp_unit)
      Tile(label: copy.humid, value: now.humidity, unit: .pct)
      Tile(label: copy.wind,  value: now.wind,     unit: .speed)
    }
  }
}