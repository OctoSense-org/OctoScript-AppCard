# ledger stock@1.0.0
# level: L0
# profile: ui/l0

theme vibrant

state ticker { shape: text, initial: "NVDA" }

source quote sys.quote(ticker: state.ticker, fields: [ticker, name, last, change, pct, open, prev, high, low, volume, mktcap])

view root Surface(pad: .page) {
  Col(align: .center, gap: 28) {

    Col(align: .center, gap: 2) {
      TextEyebrow(text: quote.ticker)
      TextTitle(text: quote.name)
    }

    Col(align: .center, gap: 4) {
      when quote.$state == .pending { TextCaption(text: "Fetching quote") }
      when quote.$state == .failed  { TextCaption(text: "Quote unavailable") }
      TextHero(value: quote.last, format: .money)
    }

    Row(width: .fit, align: .baseline, gap: 10) {
      TextValue(value: quote.change, format: .signed_money, tint: quote.change)
      TextValue(value: quote.pct, format: .signed_pct, tint: quote.change)
    }

    Grid(cols: 2) {
      Tile(label: "Open", value: quote.open, format: .money)
      Tile(label: "Prev close", value: quote.prev, format: .money)
      Tile(label: "Day high", value: quote.high, format: .money)
      Tile(label: "Day low", value: quote.low, format: .money)
      Tile(label: "Volume", value: quote.volume, format: .compact)
      Tile(label: "Mkt cap", value: quote.mktcap, format: .compact)
    }
  }
}