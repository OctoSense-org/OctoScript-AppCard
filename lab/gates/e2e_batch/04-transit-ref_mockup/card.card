# ledger transit @ 1.0.0
# level: L0
# profile: ui/l0

theme vibrant

copy locating { class: vocabulary, en: "Finding stops nearby" }
copy nofix    { class: vocabulary, en: "No position" }
copy nearby   { class: vocabulary, en: "Stops nearby" }

source here  sys.gps()
source board sys.places(lat: here.lat, lon: here.lon, category: "transit", count: 4, fields: [id, name, distance])

# The three rows this card wrote out by hand — `board.1`, `board.2`, `board.3` —
# were the defect. A source that is never iterated is bound as ONE record:
# `board.0` resolves, and every index past it resolves to nothing, so those rows
# reserved their height and painted no text. `for … key` is how L0 reads a
# collection, and it binds the rows to the stops actually returned.
#
# `sys.places` takes no `offset`, so the nearest stop is both the hero's subject
# and the first row of the list; there is no second query that skips it. The
# eyebrow over the list says what the list is rather than implying it starts at
# the second stop.
#
# The status lines sit in the Surface and carry no Panel of their own: while the
# board is pending they stand in for the bands instead of adding one.

view root Surface(pad: .page) {

  when board.$state == .pending { TextCaption(text: copy.locating) }
  when board.$state == .failed  { TextCaption(text: copy.nofix) }

  when board.$state != .pending {
    when board.$state != .failed {

      Panel {
        Col(align: .start, gap: 8) {
          TextEyebrow(text: board.0.name)
          TextHero(value: board.0.distance, unit: .distance)
        }
      }

      Panel {
        Col(align: .start, gap: 14) {
          TextEyebrow(text: copy.nearby)
          for s in board key s.id {
            Row(width: .fill, align: .baseline, gap: 12) {
              TextRow(text: s.name, width: .fill)
              TextValue(value: s.distance, unit: .distance)
            }
          }
        }
      }
    }
  }
}