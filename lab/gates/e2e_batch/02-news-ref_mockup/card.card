# ledger news@1.0.0
# level: L0

theme vibrant

source lead  sys.news(count: 1, offset: 0, fields: [title, author, points, comments])
source more  sys.news(count: 4, offset: 1, fields: [id, title])

view root  Surface(pad: .page) {

  Panel {
    Col(align: .start, gap: 10) {
      TextEyebrow(text: "TOP STORY")

      # The pending line is gone, and that is the overlap. "Loading the wire"
      # did not replace the story, it stacked above it, so the card stood one
      # body line and one gap taller than the box the message reserved for it —
      # and the actions row beneath the card is laid out against that box, which
      # is why it came to rest a few pixels inside the card. Pending is also the
      # state the card is measured in, so that line was on screen above a
      # headline that had already arrived: a card that says it is loading while
      # showing what it loaded.
      #
      # The failure line stays. When the wire fails there is no headline under
      # it to stack on — it stands in for the story instead of adding to it, so
      # it costs the card no height the card did not already have.
      when lead.$state == .failed { TextBody(text: "The wire is unavailable") }

      TextHero(text: lead.0.title)

      Row(align: .baseline, gap: 12) {
        TextBody(text: lead.0.author)
        TextCaption(value: lead.0.points, suffix: " points")
        TextCaption(value: lead.0.comments, suffix: " comments")
      }
    }
  }

  Panel {
    # Gap 12, not 8: a headline that runs to a second line needs more air
    # between items than between the lines inside one item, or the list reads
    # as one paragraph.
    Col(align: .start, gap: 12) {
      TextEyebrow(text: "MORE HEADLINES")

      for s in more key s.id {
        # `TextRow` pins its run to a single line and ellipsises the overflow —
        # right for a day name or a condition, wrong for a headline. Two of
        # these four painted 33 and 36 glyphs for 70 and 67 characters. A news
        # title is prose, so it takes the prose role: `TextBody` wraps, and a
        # long headline runs onto a second line instead of being cut.
        TextBody(text: s.title)
      }
    }
  }
}