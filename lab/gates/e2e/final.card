# ledger florence-weather@1.0.0
# level:   L0
# profile: ui/l0
# model:   weather

# The mood the reference carries: the page itself holds the colour, so the two
# panels read as frosted bands over it rather than as tiles on a neutral sheet.
theme vibrant

# The current reading and the week are two SOURCES, not one. `sys.weather` with
# `days:` answers a collection — `week.days` — and the bounds every bar scales
# against; the hero needs a record. Asking one source for both leaves
# `temp`/`cond` unresolved at the hero.
source place      sys.geocode(name: state.city)
source now        sys.weather(lat: place.lat, lon: place.lon,
                              fields: [temp, cond])
source week       sys.weather(lat: place.lat, lon: place.lon, days: state.days,
                              fields: [dayname, hi, lo],
                              aggregate: [min_lo, max_hi])
source env.locale sys.locale()

state city  { shape: text, initial: "Florence, Italy" }
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state days  { shape: number, initial: 4 }

# Two bands and a wide margin, as the reference has them.
view root  Surface(pad: .page) {
             when now.$state == .pending { TextBody(text: "Reading the sky") }
             when now.$state == .failed  { TextBody(text: "No connection") }
             Col(gap: 24) {
               hero
               forecast
             }
           }

# Hard left — a `Col` starts its children, so the alignment is the default and
# needs no argument. The number dominates; everything around it is subordinate.
view hero  Panel {
             Col(gap: 4) {
               TextEyebrow(text: place.name)
               TextHero(value: now.temp, unit: units)
               # `width: .fit`: a row fills by default, and a filling row would
               # stretch its gap across the page.
               Row(width: .fit, align: .center, gap: 8) {
                 WeatherIcon(cond: now.cond, size: .row)
                 TextRow(text: now.cond)
               }
             }
           }

# One pane holding every day. The day column is the only fixed width here —
# `.day` is a laid-out token; the temperatures size to their own runs so a
# two-digit reading is never given a column narrower than its glyphs.
view forecast  Panel {
                 Col(gap: 10) {
                   TextTitle(text: "Next days")
                   for d in week.days key d.dayname {
                     Row(align: .center, gap: 12) {
                       TextRow(text: d.dayname, width: .day)
                       TextValue(value: d.lo, unit: units)
                       TempBar(lo: d.lo, hi: d.hi, min: week.min_lo, max: week.max_hi)
                       TextValue(value: d.hi, unit: units)
                     }
                   }
                 }
               }