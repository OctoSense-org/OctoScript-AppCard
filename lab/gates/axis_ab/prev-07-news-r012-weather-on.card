# ledger news@1.0.0
# level:   L0
# profile: ui/l0

theme vibrant accent: .amber type: .display emphasis: .poster

source lead sys.news(count: 1, offset: 0, fields: [title, author, points])
source feed sys.news(count: 4, offset: 1, fields: [id, title])

copy lede    { class: vocabulary, en: "Top story" }
copy byline  { class: vocabulary, en: "by" }
copy points  { class: vocabulary, en: "points" }
copy loading { class: vocabulary, en: "Fetching the wire" }
copy offline { class: vocabulary, en: "The wire is unreachable" }

# The two bands were written as `component Lead` and `component StoryBand` and
# instantiated below. L0 admits no user-defined constructor — the catalog is the
# whole vocabulary — so both are inlined here at the site that used them. The
# composition is unchanged: a centred hero band, then one rule-topped headline
# band per story, 34 apart.
view root Surface(pad: .page) {

  # Status is a band of the page, not a line stacked on top of a finished card:
  # kept exclusive with the content so the card is one height in every state.
  when lead.$state == .pending { TextRow(text: copy.loading) }
  when lead.$state == .failed  { TextRow(text: copy.offline) }

  when lead.$state != .pending {

    Col(align: .center, gap: 34, width: .fill) {

      # `lead` is queried at count 1, so it is a record and not a collection —
      # `lead.0` indexes something that was never a list. Its fields are read
      # straight off the source.
      Col(align: .center, gap: 16, width: .fill) {
        TextEyebrow(text: copy.lede)
        TextHero(text: lead.title)

        # `align: .center`, not `.baseline`. This row mixes two ink heights, and
        # baselining runs of different size gives the row a box taller than
        # anything painted in it — that slack is what walks the stack past its
        # own edge. A count with a unit is also two roles, not one argument:
        # there is no `suffix:`.
        Row(width: .fit, align: .center, gap: 10) {
          TextBody(text: copy.byline)
          TextBody(text: lead.author)
          TextCaption(value: lead.points)
          TextCaption(text: copy.points)
        }
      }

      for s in feed key s.id {
        Col(align: .start, gap: 12, width: .fill) {
          Rule()
          TextRow(text: s.title, width: .fill)
        }
      }
    }
  }
}
