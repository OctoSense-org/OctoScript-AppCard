# ledger news @1.0.0
# level: L0
# profile: ui/l0

theme vibrant

source lead sys.news(count: 1, offset: 0, fields: [title, author, points, comments])
source feed sys.news(count: 4, offset: 1, fields: [id, title])

view root Surface(pad: .page) {
  when lead.$state == .pending { TextRow(text: "Loading") }
  when lead.$state == .failed  { TextRow(text: "Offline") }

  when lead.$state != .pending {

    Col(align: .center, gap: 28, width: .fill) {

      Col(align: .center, gap: 10, width: .fill) {
        TextEyebrow(text: "Top story")
        TextHero(text: lead.title)
        TextBody(text: lead.author, width: .fill)
        Row(width: .fit, align: .center, gap: 12) {
          TextCaption(value: lead.points)
          TextCaption(text: "points")
          TextCaption(value: lead.comments)
          TextCaption(text: "comments")
        }
      }

      Rule()

      Col(align: .start, gap: 22, width: .fill) {
        TextEyebrow(text: "More")
        Col(align: .start, gap: 18, width: .fill) {
          for s in feed key s.id {
            TextRow(text: s.title, width: .fill)
          }
        }
      }
    }
  }
}
