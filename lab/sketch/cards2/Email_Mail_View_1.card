# level: L0
# model: atro-app
theme atro_light

view people Col(width: .fill, gap: 8) {
  Grid(cols: 5) {
    Col(align: .center, gap: 4) { Avatar(text: "TC") TextRow(text: "Tom Castle", width: .fit) TextCaption(text: "Vonbury", width: .fit) }
    Col(align: .center, gap: 4) { Avatar(text: "OS") TextRow(text: "Olga Simon", width: .fit) TextCaption(text: "Thaddeus", width: .fit) }
    Col(align: .center, gap: 4) { Avatar(text: "MB") TextRow(text: "Mary Briggs", width: .fit) TextCaption(text: "Yundtfurt", width: .fit) }
    Col(align: .center, gap: 4) { Avatar(text: "HS") TextRow(text: "Hulda Schwartz", width: .fit) TextCaption(text: "Nikoshire", width: .fit) }
    Col(align: .center, gap: 4) { Avatar(text: "JE") TextRow(text: "Jane Erickson", width: .fit) TextCaption(text: "Port Golda", width: .fit) }
  }
}

view mail Col(width: .fill, gap: 8) {
  Col(width: .fill, gap: 3) {
    Row(width: .fill, align: .center, gap: 6) {
      TextCaption(glyph: "◆")
      TextRow(text: "Mollie Stevenson", width: .fill)
      TextCaption(text: "10:27AM")
    }
    TextBody(text: "Interface design", width: .fill)
    TextCaption(text: "Since the advent of personal computers, many graphic designers have become involved in interface design.", width: .fill)
  }
  Rule()
  Col(width: .fill, gap: 3) {
    Row(width: .fill, align: .center, gap: 6) {
      TextCaption(glyph: "◆")
      TextRow(text: "Bernard Poole", width: .fill)
      TextCaption(text: "09:32AM")
    }
    TextBody(text: "Rapid application development", width: .fill)
    TextCaption(text: "Rapid application development (RAD) is a methodology in which a system designer produces prototypes for an end-user.", width: .fill)
  }
  Rule()
  Col(width: .fill, gap: 3) {
    Row(width: .fill, align: .center, gap: 6) {
      TextCaption(glyph: "◆")
      TextRow(text: "Mattie Keller", width: .fill)
      TextCaption(text: "06:07AM")
    }
    TextBody(text: "Architectural design", width: .fill)
    TextCaption(text: "The architectural design of a system emphasizes the design of the system architecture that describes the structure.", width: .fill)
  }
  Rule()
  Col(width: .fill, gap: 3) {
    Row(width: .fill, align: .center, gap: 6) {
      TextCaption(glyph: "◆")
      TextRow(text: "Ernest Griffith", width: .fill)
      TextCaption(text: "11:32PM")
    }
    TextBody(text: "Digital technology", width: .fill)
    TextCaption(text: "MIDI and digital audio technology have contributed to the evolution of sound production techniques in the 1980s.", width: .fill)
  }
  Rule()
  Col(width: .fill, gap: 3) {
    Row(width: .fill, align: .center, gap: 6) {
      TextCaption(glyph: "◆")
      TextRow(text: "Madge Hunt", width: .fill)
      TextCaption(text: "07:36PM")
    }
    TextBody(text: "Information architecture", width: .fill)
    TextCaption(text: "Information architecture (IA) is the structural design of shared information environments, the art and science of organizing.", width: .fill)
  }
  Rule()
  Col(width: .fill, gap: 3) {
    Row(width: .fill, align: .center, gap: 6) {
      TextCaption(glyph: "◆")
      TextRow(text: "Nelle Norris", width: .fill)
      TextCaption(text: "03:31AM")
    }
    TextBody(text: "Yes You Can", width: .fill)
    TextCaption(text: "As we grow, we do so in fits and starts, lurching forward then back, sometimes looking more like clowns than seekers.", width: .fill)
  }
  Rule()
  Col(width: .fill, gap: 3) {
    Row(width: .fill, align: .center, gap: 6) {
      TextCaption(glyph: "◆")
      TextRow(text: "Louise French", width: .fill)
      TextCaption(text: "08:02PM")
    }
    TextBody(text: "Why Re Invent The Light Bulb", width: .fill)
    TextCaption(text: "“It is not because things are difficult that we do not dare; it is because we do not dare that they are difficult.”", width: .fill)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .arrow_left)
    Col(width: .fill, align: .center) { TextTitle(text: "Inbox", width: .fit) }
    Icon(name: .bookmark)
  }
  people
  mail
  Fab(name: .send)
}
