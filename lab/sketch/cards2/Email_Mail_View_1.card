# level: L0
# model: atro-app
theme atro_light

state c1 { shape: text, initial: "3" }
state c3 { shape: text, initial: "23" }

view people Col(width: .fill) {
  Grid(cols: 5) {
    Col(align: .center, width: .fill) {
      Avatar(text: "TC")
      TextRow(text: "Tom Castle")
      TextCaption(text: "Vonbury", value: c1)
    }
    Col(align: .center, width: .fill) {
      Avatar(text: "OS")
      TextRow(text: "Olga Simon")
      TextCaption(text: "Thaddeus")
    }
    Col(align: .center, width: .fill) {
      Avatar(text: "MB")
      TextRow(text: "Mary Briggs")
      TextCaption(text: "Yundtfurt", value: c3)
    }
    Col(align: .center, width: .fill) {
      Avatar(text: "HS")
      TextRow(text: "Hulda Schwartz")
      TextCaption(text: "Nikoshire")
    }
    Col(align: .center, width: .fill) {
      Avatar(text: "JE")
      TextRow(text: "Jane Erickson")
      TextCaption(text: "Port Golda")
    }
  }
}

