view compose Panel {
  TextRow(text: "photo", width: .fill)
  TextRow(text: "Record", width: .fill)
  TextRow(text: "files", width: .fill)
  Chip(text: "new email", tone: .primary, width: .fill)
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Inbox")
  }
  people
  mail
  compose
}
