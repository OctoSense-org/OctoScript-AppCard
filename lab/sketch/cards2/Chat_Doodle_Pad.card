# level: L0
# model: atro-app
theme atro

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }

view bar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Isabelle Barker", width: .fit)
    TextCaption(text: "subtitle", width: .fit)
  }
  Icon(name: .more)
}

view thread Col(gap: 10, width: .fill) {
  Panel {
    TextBody(text: "Wannabe internet trailblazer. Devoted coffee scholar. Lifelo", width: .fill)
  }
  TextCaption(text: "10:55", width: .fill)
  Panel {
    TextBody(text: "If you could have a superpower, what would you choose?", width: .fill)
  }
  Panel {
    TextBody(text: "Do you like roller coasters?", width: .fill)
  }
  Panel {
    TextBody(text: "If you could have any kind of pet, what would you choose?", width: .fill)
  }
  Panel {
    TextBody(text: "Wannabe internet trailblazer. Devoted coffee scholar. Lifelo", width: .fill)
  }
  TextCaption(text: "10:59", width: .fill)
}

view pad Col(gap: 12, width: .fill) {
  Thumb(src: p1, shape: .hero)
  Col(align: .center, width: .fill) {
    Chip(text: "Send", tone: .primary)
  }
}

view root Surface(pad: .page) {
  Col(gap: 14, width: .fill) {
    bar
    thread
    pad
  }
}
