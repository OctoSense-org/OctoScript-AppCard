# level: L0
# model: atro-app
theme atro_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }
state total { shape: text, initial: "$1312.00" }
state pgrado { shape: text, initial: "$295" }
state pbose { shape: text, initial: "$399" }

view steps Row(width: .fill, align: .center) {
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .location, size: .tile)
    TextCaption(text: "Delivery", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .check, size: .tile)
    TextCaption(text: "Confirmation", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .zap, size: .tile)
    TextCaption(text: "Payment", width: .fit)
  }
}

view shipping Col(width: .fill, gap: 4) {
  TextEyebrow(text: "Shipping")
  Row(width: .fill, align: .center, gap: 10) {
    TextBody(text: "Delivery is scheduled for today between 14:00 - 18:00 on 913 Bear Hill Street Flushing, NY 11354.", width: .fill)
    Icon(name: .edit, size: .tile)
  }
}

view summary Col(width: .fill, gap: 12) {
  Row(width: .fill, align: .center, gap: 4) {
    TextCaption(text: "Order summary", width: .fill)
    TextCaption(text: "Total:", width: .fit)
    TextValue(value: total)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "GP")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Grado Prestige SR325e", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1")
      TextValue(value: pgrado)
    }
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "GP")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Grado Prestige SR325e", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1")
      TextValue(value: pgrado)
    }
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "BN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Bose Noise Cancelling 700", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1")
      TextValue(value: pbose)
    }
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "BN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Bose Noise Cancelling 700", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1")
      TextValue(value: pbose)
    }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 18) {
    Row(width: .fill, align: .center) {
      Icon(name: .arrow_left)
      Col(width: .fill, align: .center) {
        TextTitle(text: "Checkout", width: .fit)
      }
      Icon(name: .more)
    }
    steps
    Rule()
    shipping
    summary
    Space()
    Col(width: .fill, align: .center) {
      Chip(text: "Continue with payment", tone: .primary, width: .fill)
    }
  }
}
