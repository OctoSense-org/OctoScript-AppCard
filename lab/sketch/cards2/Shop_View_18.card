# level: L0
# model: atro-app
theme atro_light

state price1 { shape: text, initial: "$295" }
state price2 { shape: text, initial: "$295" }
state price3 { shape: text, initial: "$399" }
state price4 { shape: text, initial: "$399" }
state total  { shape: text, initial: "Total: $1312.00" }

view steps Row(width: .fill, align: .center) {
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .send, size: .tile)
    TextCaption(text: "Delivery", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .check, size: .tile)
    TextCaption(text: "Confirmation", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .zap, size: .tile)
    TextCaption(text: "Payment", width: .fit)
  }
}

view items Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "GP")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Grado Prestige SR325e", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(align: .center, gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: price1)
    }
  }
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "GP")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Grado Prestige SR325e", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(align: .center, gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: price2)
    }
  }
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "BN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Bose Noise Cancelling 700", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(align: .center, gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: price3)
    }
  }
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "BN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Bose Noise Cancelling 700", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(align: .center, gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: price4)
    }
  }
}

view root Surface(pad: .page) {
  TextEyebrow(text: "Atro UI")
  Row(width: .fill, align: .center, gap: 10) {
    Icon(name: .arrow_left)
    TextTitle(text: "Checkout", width: .fill)
    Icon(name: .more)
  }
  steps
  Rule()
  TextEyebrow(text: "Shipping")
  Row(width: .fill, align: .center, gap: 10) {
    TextBody(text: "Delivery is scheduled for today between 14:00 - 18:00 on 913 Bear Hill Street Flushing, NY 11354.", width: .fill)
    Icon(name: .edit)
  }
  Row(width: .fill, align: .center) {
    TextTitle(text: "Order summary", width: .fill)
    TextValue(value: total)
  }
  items
  Space()
  Row(width: .fill, align: .center) {
    Chip(text: "Continue with payment", tone: .primary)
  }
}
