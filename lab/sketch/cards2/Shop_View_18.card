# level: L0
# model: atro-app
theme atro_light

state v1 { shape: text, initial: "$295" }
state v2 { shape: text, initial: "$295" }
state v3 { shape: text, initial: "$399" }
state v4 { shape: text, initial: "$399" }

view stepper Row(width: .fill, align: .center, gap: 8) {
  Col(align: .center, width: .fill, gap: 4) {
    Icon(name: .location, size: .tile)
    TextCaption(text: "Delivery", width: .fit)
  }
  Col(align: .center, width: .fill, gap: 4) {
    Icon(name: .check, size: .tile)
    TextCaption(text: "Confirmation", width: .fit)
  }
  Col(align: .center, width: .fill, gap: 4) {
    Icon(name: .zap, size: .tile)
    TextCaption(text: "Payment", width: .fit)
  }
}

view shipping Col(width: .fill, gap: 6) {
  TextEyebrow(text: "Shipping")
  Row(width: .fill, align: .center, gap: 10) {
    TextBody(text: "Delivery is scheduled for today between 14:00 - 18:00 on 913 Bear Hill Street Flushing, NY 11354.", width: .fill)
    Icon(name: .edit, size: .tile)
  }
}

view items Col(width: .fill, gap: 12) {
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "GP")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Grado Prestige SR325e", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: v1)
    }
  }
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "GP")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Grado Prestige SR325e", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: v2)
    }
  }
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "BN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Bose Noise Cancelling 700", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: v3)
    }
  }
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "BN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Bose Noise Cancelling 700", width: .fill)
      TextCaption(text: "Marshall puts out more than iconic...", width: .fill)
    }
    Col(gap: 2) {
      TextCaption(text: "x1", width: .fit)
      TextValue(value: v4)
    }
  }
}

view root Surface(pad: .page) {
  TextEyebrow(text: "Atro UI")
  Row(width: .fill, align: .center, gap: 10) {
    Icon(name: .arrow_left)
    TextTitle(text: "Checkout", width: .fill)
    Icon(name: .more)
  }
  stepper
  Rule()
  shipping
  Row(width: .fill, align: .center, gap: 10) {
    TextEyebrow(text: "Order summary")
    TextRow(text: "Total: $1312.00", width: .fit)
  }
  items
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "Continue with payment", tone: .primary, width: .fill)
  }
}
