# level: L0
# model: atro-app
theme atro

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }

view menu Col(width: .fill, gap: 10) {
  Chip(text: "Messages", width: .fill)
  Chip(text: "Trending", width: .fill)
  Chip(text: "Bookmarks", width: .fill)
  Chip(text: "Gallery", width: .fill)
  Chip(text: "Settings", width: .fill)
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Col(width: .fill, gap: 4) {
      TextEyebrow(text: "Atro UI")
      Chip(text: "8")
    }
    TextRow(text: "Logout", width: .fit)
  }
  Thumb(src: p1, shape: .hero)
  Space()
  menu
}
