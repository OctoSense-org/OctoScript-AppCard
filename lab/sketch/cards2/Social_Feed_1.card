# level: L0
# model: atro-app

theme atro

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }
state p4 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }
state p5 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }
state p6 { shape: text, initial: "http://127.0.0.1:8787/_ph.png" }

view root Surface(pad: .page) {
  TextEyebrow(text: "Atro UI")
  Row(width: .fill, align: .center) {
    Icon(name: .menu)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Following", width: .fit)
    }
    Icon(name: .bell)
  }
  Grid(cols: 2) {
    Card(tint: .neutral) {
      Col(width: .fill, gap: 6) {
        Thumb(src: p1, shape: .square)
        Row(width: .fill, gap: 8) {
          Avatar(text: "JP")
          Col(width: .fill, gap: 2) {
            TextRow(text: "Jeremías del Pozo", width: .fill)
            TextCaption(text: "Incheon", width: .fill)
          }
        }
        TextBody(text: "You miss 100% of the shots you don’t take.", width: .fill)
      }
    }
    Card(tint: .neutral) {
      Col(width: .fill, gap: 6) {
        Thumb(src: p2, shape: .square)
        Row(width: .fill, gap: 8) {
          Avatar(text: "KW")
          Col(width: .fill, gap: 2) {
            TextRow(text: "Kendasha Wood", width: .fill)
            TextCaption(text: "Doha", width: .fill)
          }
        }
        TextBody(text: "You miss 100% of the shots you don’t take.", width: .fill)
      }
    }
    Card(tint: .neutral) {
      Col(width: .fill, gap: 6) {
        Thumb(src: p3, shape: .square)
        Row(width: .fill, gap: 8) {
          Avatar(text: "DT")
          Col(width: .fill, gap: 2) {
            TextRow(text: "Donat Twerski", width: .fill)
            TextCaption(text: "Montevideo", width: .fill)
          }
        }
        TextBody(text: "You miss 100% of the shots you don’t take.", width: .fill)
      }
    }
    Card(tint: .neutral) {
      Col(width: .fill, gap: 6) {
        Thumb(src: p4, shape: .square)
        Row(width: .fill, gap: 8) {
          Avatar(text: "SW")
          Col(width: .fill, gap: 2) {
            TextRow(text: "Sebastian Westergren", width: .fill)
            TextCaption(text: "Washington D.C.", width: .fill)
          }
        }
        TextBody(text: "You miss 100% of the shots you don’t take.", width: .fill)
      }
    }
    Card(tint: .neutral) {
      Col(width: .fill, gap: 6) {
        Thumb(src: p5, shape: .square)
        Row(width: .fill, gap: 8) {
          Avatar(text: "AP")
          Col(width: .fill, gap: 2) {
            TextRow(text: "Alexandre Paiva", width: .fill)
            TextCaption(text: "Brazzaville", width: .fill)
          }
        }
        TextBody(text: "You miss 100% of the shots you don’t take.", width: .fill)
      }
    }
    Card(tint: .neutral) {
      Col(width: .fill, gap: 6) {
        Thumb(src: p6, shape: .square)
        Row(width: .fill, gap: 8) {
          Avatar(text: "AL")
          Col(width: .fill, gap: 2) {
            TextRow(text: "Angela Longoria", width: .fill)
            TextCaption(text: "Brussels", width: .fill)
          }
        }
        TextBody(text: "You miss 100% of the shots you don’t take.", width: .fill)
      }
    }
  }
  Row(width: .fill, align: .center, gap: 8) {
    Chip(text: "New post available", tone: .primary)
    Icon(name: .close)
  }
}
