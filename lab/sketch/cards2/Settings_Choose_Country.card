# level: L0
# model: atro-app
theme atro_light

state q { shape: text, initial: "Find country" }

view searchbar Row(width: .fill, align: .center, gap: 10) {
  Icon(name: .search)
  Field(placeholder: q)
}

view countries Col(width: .fill, gap: 26) {
  Row(width: .fill, align: .center) {
    TextRow(text: "Somalia", width: .fill)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Greenland", width: .fill)
    TextCaption(glyph: "■")
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Russian Federation", width: .fill)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Croatia", width: .fill)
    TextCaption(glyph: "■")
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Christmas Island", width: .fill)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Belgium", width: .fill)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Martinique", width: .fill)
    TextCaption(glyph: "■")
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "San Marino", width: .fill)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Gibraltar", width: .fill)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Marshall Islands", width: .fill)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Martinique", width: .fill)
  }
}

view root Surface(pad: .page) {
  Band(text: "Select country")
  searchbar
  countries
}
