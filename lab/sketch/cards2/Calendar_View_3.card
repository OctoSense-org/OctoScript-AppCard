# level: L0
# model: atro-app

theme atro_light

view details Col(width: .fill, gap: 14) {
  Row(width: .fill, gap: 12) {
    Icon(name: .clock)
    TextRow(text: "9:00 - 11:00 AM", width: .fill)
  }
  Row(width: .fill, gap: 12) {
    Icon(name: .calendar)
    TextRow(text: "Wendsday, November 2019", width: .fill)
  }
  Row(width: .fill, gap: 12) {
    Icon(name: .location)
    TextRow(text: "Meeting Room", width: .fill)
  }
  Row(width: .fill, gap: 12) {
    Icon(name: .menu)
    Col(width: .fill, gap: 2) {
      TextRow(text: "Description", width: .fill)
      TextCaption(text: "Insanity is doing the same thing, over and over again, but expecting different results.", width: .fill)
    }
  }
  Row(width: .fill, gap: 12) {
    Icon(name: .share)
    Col(width: .fill, gap: 2) {
      TextRow(text: "Prototype link", width: .fill)
      TextCaption(text: "https://ui8.net/products/atro-mobile-ui-kit", width: .fill)
    }
  }
  Row(width: .fill, gap: 12) {
    Icon(name: .video)
    Col(width: .fill, gap: 2) {
      TextRow(text: "Video sharing", width: .fill)
      TextCaption(text: "zoom.us/meeting-#21345", width: .fill)
    }
  }
  Row(width: .fill, gap: 12) {
    Icon(name: .bell)
    Col(width: .fill, gap: 2) {
      TextRow(text: "Preparation", width: .fill)
      TextCaption(text: "You will be notified 15 minute before the meeting", width: .fill)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .arrow_left)
    Space()
    Icon(name: .calendar)
  }
  TextTitle(text: "Mobile App nav patterns explorations", width: .fill)
  Col(width: .fill, gap: 6) {
    TextEyebrow(text: "Invited")
    Col(width: .fill, align: .center) {
      Avatar(text: "+")
    }
  }
  Rule()
  details
  Space()
  Row(width: .fill, align: .center, gap: 8) {
    Icon(name: .calendar)
    Chip(text: "add to calendar", tone: .primary)
  }
}
