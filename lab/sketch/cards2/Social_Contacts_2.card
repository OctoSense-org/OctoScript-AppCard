# level: L0
# model: atro-app
theme atro_light

view root Surface(pad: .page) {
  Band(text: "Contacts")
  Row(width: .fill, gap: 12) {
    Row(width: .fill, align: .center, gap: 6) {
      Icon(name: .user, size: .tile)
      TextCaption(text: "Requests", width: .fit)
    }
    Row(width: .fill, align: .center, gap: 6) {
      Icon(name: .users, size: .tile)
      TextCaption(text: "Suggested", width: .fit)
    }
  }
  people
  Space()
  tabbar
}

view people Col(width: .fill, gap: 12) {
  Grid(cols: 2) {
    Panel {
      Col(align: .center, gap: 6) {
        Avatar(text: "IB")
        TextRow(text: "Isabelle Barker", width: .fit)
        TextCaption(text: "Kuala Lumpur", width: .fit)
        Chip(text: "follow")
      }
    }
    Panel {
      Col(align: .center, gap: 6) {
        Avatar(text: "EB")
        TextRow(text: "Esther Boone", width: .fit)
        TextCaption(text: "Charlotte", width: .fit)
        Chip(text: "follow")
      }
    }
  }
  Rule()
  Grid(cols: 2) {
    Panel {
      Col(align: .center, gap: 6) {
        Avatar(text: "CR")
        TextRow(text: "Carrie Russell", width: .fit)
        TextCaption(text: "Haifa", width: .fit)
        Chip(text: "follow")
      }
    }
    Panel {
      Col(align: .center, gap: 6) {
        Avatar(text: "HH")
        TextRow(text: "Hu Hyon-Suk", width: .fit)
        TextCaption(text: "Edmonton", width: .fit)
        Chip(text: "follow")
      }
    }
  }
  Rule()
  Grid(cols: 2) {
    Panel {
      Col(align: .center, gap: 6) {
        Avatar(text: "WM")
        TextRow(text: "Winnie McKenzie", width: .fit)
        TextCaption(text: "San Antonio", width: .fit)
        Chip(text: "follow")
      }
    }
    Panel {
      Col(align: .center, gap: 6) {
        Avatar(text: "BH")
        TextRow(text: "Birdie Hoffman", width: .fit)
        TextCaption(text: "Budapest", width: .fit)
        Chip(text: "follow")
      }
    }
  }
}

view tabbar Row(width: .fill, align: .center) {
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .home)
    TextCaption(text: "item label", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .image)
    TextCaption(text: "item label", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Row(align: .center, gap: 2) {
      Icon(name: .chat)
      TextCaption(text: "10", width: .fit)
    }
    TextCaption(text: "item label", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .mail)
    TextCaption(text: "item label", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    Icon(name: .menu)
    TextCaption(text: "item label", width: .fit)
  }
}
