# level: L0
# model: atro-app
theme atro_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state followers { shape: text, initial: "35k" }
state stories { shape: text, initial: "315" }
state following { shape: text, initial: "1931" }

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .arrow_left)
  }
  Band(text: "")
  Col(width: .fill, align: .center, gap: 8) {
    Avatar(text: "MB")
    Chip(text: "LIVE", width: .fit)
    TextTitle(text: "Maria José Botín", width: .fit)
    TextCaption(text: "Berlin, Germany", width: .fit)
    TextBody(text: "Typical thinker. Incurable tv geek. Explorer. Friend of animals everywhere. Entrepreneur.", width: .fit)
    Chip(text: "message", tone: .primary, width: .fit)
  }
  Rule()
  stats
  places
}

view stats Row(width: .fill, align: .center) {
  Col(width: .fill, align: .center, gap: 4) {
    TextStat(value: followers)
    TextCaption(text: "Followers", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    TextStat(value: stories)
    TextCaption(text: "Stories", width: .fit)
  }
  Col(width: .fill, align: .center, gap: 4) {
    TextStat(value: following)
    TextCaption(text: "Following", width: .fit)
  }
}

view places Col(width: .fill, gap: 10) {
  TextTitle(text: "Favourite places")
  Grid(cols: 3) {
    Thumb(src: p1, shape: .square)
    Thumb(src: p2, shape: .square)
    Thumb(src: p3, shape: .square)
  }
}
