# level: L0
# model: atro-app
theme atro

state p1 { shape: text, initial: "http://127.0.0.1:8787/07ba47471dcfb1cf35c1f1c38d42614b382d9987.png" }

view dots Col(align: .center, width: .fill) {
  Row(align: .center, gap: 8) {
    TextCaption(glyph: "—", width: .fit)
    TextCaption(glyph: "—", width: .fit)
    TextCaption(glyph: "—", width: .fit)
    TextCaption(glyph: "—", width: .fit)
  }
}

view root Surface(pad: .page) {
  TextEyebrow(text: "Atro UI")
  Thumb(src: p1, shape: .hero)
  dots
  Col(align: .center, gap: 8, width: .fill) {
    TextTitle(text: "Rule of thirds", width: .fit)
    TextBody(text: "The rule of thirds states that an image is most pleasing when its subjects or regions are …", width: .fit)
  }
  Space()
  Col(align: .center, gap: 14, width: .fill) {
    Chip(text: "→", tone: .primary)
    TextCaption(text: "Already have an account? Sign In", width: .fit)
  }
}
