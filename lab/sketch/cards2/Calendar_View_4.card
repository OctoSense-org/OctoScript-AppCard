  Panel { Col(align: .center, gap: 2, width: .fill) { TextCaption(text: "24", width: .fit) TextCaption(glyph: "••", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "25", width: .fit) } }
