# level: L0
# model: atro-app
theme atro_light

view root Surface(pad: .page) {
  header
  weekdays
  Card { TextTitle(text: "April", width: .fill) }
  aprildays
  Card { TextTitle(text: "May", width: .fill) }
  maydays
}

view header Col(align: .start, gap: 4, width: .fill) {
  TextEyebrow(text: "Atro UI")
  Row(width: .fill, align: .center) {
    Icon(name: .arrow_left)
    TextTitle(text: "2020", width: .fill)
    Icon(name: .menu)
    Icon(name: .bookmark)
  }
}

view weekdays Grid(cols: 7) {
  TextEyebrow(text: "Mon")
  TextEyebrow(text: "tue")
  TextEyebrow(text: "wed")
  TextEyebrow(text: "thu")
  TextEyebrow(text: "fri")
  TextEyebrow(text: "sat")
  TextEyebrow(text: "sun")
}

view aprildays Grid(cols: 7) {
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "25", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "26", width: .fit) } }
  Panel { Col(align: .center, gap: 2, width: .fill) { TextCaption(text: "27", width: .fit) TextCaption(glyph: "•", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "28", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "29", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "30", width: .fit) } }
  Panel { Col(align: .center, gap: 2, width: .fill) { TextCaption(text: "1", width: .fit) TextCaption(glyph: "•", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "2", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "3", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "4", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "5", width: .fit) } }
  Panel { Col(align: .center, gap: 2, width: .fill) { TextCaption(text: "6", width: .fit) TextCaption(glyph: "••", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "7", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "8", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "9", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "10", width: .fit) } }
  Panel { Col(align: .center, gap: 2, width: .fill) { TextCaption(text: "11", width: .fit) TextCaption(glyph: "•", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "12", width: .fit) } }
  Panel { Col(align: .center, width: .fill) { TextCaption(text: "13", width: .fit) } }
