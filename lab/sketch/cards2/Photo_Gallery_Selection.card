# level: L0
# model: atro-app
theme atro_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p4 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p5 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p6 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p7 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p8 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p9 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p10 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p11 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }
state p12 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }

view gallerybar Row(width: .fill, align: .center) {
  Icon(name: .arrow_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Gallery", width: .fit)
  }
  Icon(name: .trash)
}

view toprows Grid(cols: 3) {
  Thumb(src: p1, shape: .square)
  Thumb(src: p2, shape: .square)
  Thumb(src: p3, shape: .square)
  Thumb(src: p4, shape: .square)
  Thumb(src: p5, shape: .square)
  Thumb(src: p6, shape: .square)
}

view mosaic Row(width: .fill, gap: 8) {
  Thumb(src: p7, shape: .hero)
  Col(gap: 8) {
    Thumb(src: p8, shape: .square)
    Thumb(src: p9, shape: .square)
  }
}

view lastrow Grid(cols: 3) {
  Thumb(src: p10, shape: .square)
  Thumb(src: p11, shape: .square)
  Thumb(src: p12, shape: .square)
}

view root Surface(pad: .page) {
  gallerybar
  toprows
  mosaic
  lastrow
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "15 images selected", tone: .primary)
  }
}
