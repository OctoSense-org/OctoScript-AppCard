# level: L0
# model: atro-app
theme atro

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextEyebrow(text: "Atro UI")
    Col(width: .fill, align: .center) {
      TextTitle(text: "Inbox", width: .fit)
      TextCaption(text: "subtitle", width: .fit)
    }
  }
  Space()
  Col(align: .center, gap: 18) {
    Row(align: .center, gap: 14) {
      Icon(name: .star, size: .tile)
      Icon(name: .edit, size: .hero)
      Icon(name: .star, size: .tile)
    }
    TextTitle(text: "Start writing something new", width: .fit)
    TextBody(text: "Your device is not connect to internet, please make sure your connection is working.", width: .fit)
  }
  Space()
  Col(align: .center, width: .fill, gap: 24) {
    Chip(text: "New message", tone: .primary, width: .fill)
    Row(align: .center, gap: 12) {
      Chip(text: "Connection error.", tone: .danger)
      Chip(text: "retry")
    }
  }
  tabbar
}

view tabbar Col(width: .fill, gap: 10) {
  Rule()
  Row(width: .fill, align: .center) {
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "item label", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .image, size: .tile)
      TextCaption(text: "item label", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Row(align: .center, gap: 4) {
        Icon(name: .chat, size: .tile)
        TextCaption(text: "10", width: .fit)
      }
      TextCaption(text: "item label", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .mail, size: .tile)
      TextCaption(text: "item label", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .menu, size: .tile)
      TextCaption(text: "item label", width: .fit)
    }
  }
}
