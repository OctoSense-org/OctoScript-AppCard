# level: L0
# model: atro-app
theme atro

view header Col(width: .fill, align: .center, gap: .xs) {
  TextTitle(text: "Inbox")
  TextCaption(text: "subtitle")
}

view empty Col(width: .fill, align: .center, gap: .md) {
  TextTitle(text: "Start writing something new", width: .fill)
  TextBody(text: "Your device is not connect to internet, please make sure your connection is working.", width: .fill)
}

view actions Col(width: .fill, align: .center, gap: .md) {
  Chip(text: "New message", tone: .primary, width: .fill)
  Panel {
    Row(width: .fill, align: .center, gap: .sm) {
      TextRow(text: "Connection error.", width: .fill)
      Chip(text: "retry")
    }
  }
}

view tabbar Grid(cols: 5) {
  TextCaption(text: "item label")
  TextCaption(text: "item label")
  Col(width: .fill, align: .center, gap: .xs) {
    TextCaption(text: "10")
    TextCaption(text: "item label")
  }
  TextCaption(text: "item label")
  TextCaption(text: "item label")
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: .lg) {
    header
    empty
    actions
    Rule()
    tabbar
  }
}
