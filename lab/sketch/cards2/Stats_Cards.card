# level: L0
# model: atro-app
theme atro

state b1 { shape: text, initial: "$235.00" }
state b2 { shape: text, initial: "$12,929.05" }
state b3 { shape: text, initial: "$3,841.84" }

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .menu)
    Col(width: .fill, align: .center) {
      TextTitle(text: "My virtual cards", width: .fit)
    }
    Icon(name: .more)
  }
  Card(tint: .green) {
    Col(width: .fill, gap: 20) {
      Row(width: .fill) {
        Col(width: .fill) {
          TextHero(text: "card balance", value: b1)
        }
        Icon(name: .settings, size: .tile)
      }
      TextRow(text: "3713 5878 2833 34195", width: .fill)
      Row(width: .fill, gap: 40) {
        Col(gap: 2) {
          TextEyebrow(text: "Expire")
          TextRow(text: "12/24", width: .fit)
        }
        Col(gap: 2) {
          TextEyebrow(text: "CVV")
          TextRow(text: "235", width: .fit)
        }
      }
    }
  }
  Card(tint: .neutral) {
    Col(width: .fill, gap: 20) {
      Row(width: .fill) {
        Col(width: .fill) {
          TextHero(text: "card balance", value: b2)
        }
        Icon(name: .settings, size: .tile)
      }
      TextRow(text: "5326 5149 4497 1577", width: .fill)
      Row(width: .fill, gap: 40) {
        Col(gap: 2) {
          TextEyebrow(text: "Expire")
          TextRow(text: "12/24", width: .fit)
        }
        Col(gap: 2) {
          TextEyebrow(text: "CVV")
          TextRow(text: "235", width: .fit)
        }
      }
    }
  }
  Card(tint: .pink) {
    Col(width: .fill, gap: 20) {
      Row(width: .fill) {
        Col(width: .fill) {
          TextHero(text: "card balance", value: b3)
        }
        Icon(name: .settings, size: .tile)
      }
      TextRow(text: "4485 0961 4849 8888", width: .fill)
      Row(width: .fill, gap: 40) {
        Col(gap: 2) {
          TextEyebrow(text: "Expire")
          TextRow(text: "12/24", width: .fit)
        }
        Col(gap: 2) {
          TextEyebrow(text: "CVV")
          TextRow(text: "235", width: .fit)
        }
      }
    }
  }
}
