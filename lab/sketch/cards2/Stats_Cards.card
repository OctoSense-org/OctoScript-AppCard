# level: L0
# model: atro-app
theme atro

view root Surface(pad: .page) {
           Col(gap: 22) {
             topbar
             Col(gap: 10) {
               cardmint
               cardsteel
               cardorchid
             }
           }
         }

view topbar Row(width: .fill, align: .center) {
              Icon(name: .menu)
              Col(width: .fill, align: .center) {
                TextTitle(text: "My virtual cards", width: .fit)
              }
              Icon(name: .plus)
            }

view cardmint Panel {
                Col(gap: 28) {
                  Row(width: .fill) {
                    Col(width: .fill, gap: 2) {
                      TextCaption(text: "card balance")
                      TextHero(text: "$235.00")
                    }
                    Icon(name: .settings)
                  }
                  TextRow(text: "3713 5878 2833 34195")
                  Row(width: .fill, align: .end) {
                    Row(width: .fill, gap: 36) {
                      Col(width: .fit, gap: 2) {
                        TextCaption(text: "Expire")
                        TextRow(text: "12/24", width: .fit)
                      }
                      Col(width: .fit, gap: 2) {
                        TextCaption(text: "CVV")
                        TextRow(text: "235", width: .fit)
                      }
                    }
                  }
                }
              }

view cardsteel Panel {
                 Col(gap: 28) {
                   Row(width: .fill) {
                     Col(width: .fill, gap: 2) {
                       TextCaption(text: "card balance")
                       TextHero(text: "$12,929.05")
                     }
                     Icon(name: .settings)
                   }
                   TextRow(text: "5326 5149 4497 1577")
                   Row(width: .fill, align: .end) {
                     Row(width: .fill, gap: 36) {
                       Col(width: .fit, gap: 2) {
                         TextCaption(text: "Expire")
                         TextRow(text: "12/24", width: .fit)
                       }
                       Col(width: .fit, gap: 2) {
                         TextCaption(text: "CVV")
                         TextRow(text: "235", width: .fit)
                       }
                     }
                     TextCaption(glyph: "◉◉", width: .fit)
                   }
                 }
               }

view cardorchid Card {
                  Col(gap: 28) {
                    Row(width: .fill) {
                      Col(width: .fill, gap: 2) {
                        TextCaption(text: "card balance")
                        TextHero(text: "$3,841.84")
                      }
                      Icon(name: .settings)
                    }
                    TextRow(text: "4485 0961 4849 8888")
                    Row(width: .fill, align: .end) {
                      Row(width: .fill, gap: 36) {
                        Col(width: .fit, gap: 2) {
                          TextCaption(text: "Expire")
                          TextRow(text: "12/24", width: .fit)
                        }
                        Col(width: .fit, gap: 2) {
                          TextCaption(text: "CVV")
                          TextRow(text: "235", width: .fit)
                        }
                      }
                      TextEyebrow(text: "VISA")
                    }
                  }
                }
