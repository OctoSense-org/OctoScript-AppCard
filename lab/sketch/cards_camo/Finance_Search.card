# level: L0
# model: camo-app
theme camo

state q { shape: text, initial: "Bank" }
state q_hint { shape: text, initial: "Search" }
state op_a { shape: text, initial: "-$240.00" }
state op_b { shape: text, initial: "-$180.40" }

view providers Col(width: .fill, gap: 12) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Providers", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "BA")
    TextRow(text: "Bank of America", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "MZ")
    TextRow(text: "Mizuho", width: .fill)
  }
}

view operations Col(width: .fill, gap: 12) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Operations", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "SC")
    Col(width: .fill) {
      TextRow(text: "Service Charge", width: .fill)
      TextCaption(text: "Bank services", width: .fill)
    }
    TextValue(value: op_a)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "SC")
    Col(width: .fill) {
      TextRow(text: "Service Charge", width: .fill)
      TextCaption(text: "Bank services", width: .fill)
    }
    TextValue(value: op_b)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Search", width: .fit)
    }
  }
  Field(text: q, placeholder: q_hint)
  providers
  operations
}
