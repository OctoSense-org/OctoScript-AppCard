theme camo_light

view healthrows Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .user)
    TextRow(text: "Infomation", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .zap)
    TextRow(text: "Calories", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .heart)
    TextRow(text: "Heart", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .activity)
    TextRow(text: "Activity", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .refresh)
    TextRow(text: "Cycle Tracking", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .plus)
    TextRow(text: "Medication", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .moon)
    TextRow(text: "Sleep", width: .fill)
    Icon(name: .chevron_right)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Health", width: .fill)
    Icon(name: .menu)
  }
  healthrows
  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .activity, label: "Item")
    Tab(icon: .heart, label: "Item")
    Tab(icon: .calendar, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
