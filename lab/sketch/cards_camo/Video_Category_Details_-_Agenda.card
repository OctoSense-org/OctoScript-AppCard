# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/b57c9da892df4c8c908f608e77071276f1f1cd3c.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/c8b10c444e213559bf61197ae390d8a8a811f80a.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/0ebbf5f7128ce0e75e1065e4c59d8af2fa6de2d2.png" }
state p4 { shape: text, initial: "http://127.0.0.1:8787/5da5bf3d01ba671bc646045b4851747f9e8bb24e.png" }
state tab { shape: enum[normal, active], initial: .active }

view appbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Action", width: .fit)
  }
}

view segment Panel {
  Row(width: .fill, gap: 6) {
    Chip(text: "Normal", active: tab == .normal, width: .fill)
    Chip(text: "Active", active: tab == .active, width: .fill)
  }
}

view filterbar Row(width: .fill, align: .center) {
  TextTitle(text: "Filter", width: .fill)
  Icon(name: .menu)
}

view movies Col(width: .fill, gap: 12) {
  Row(width: .fill, gap: 12) {
    Thumb(src: p1)
    Col(width: .fill, gap: 6) {
      TextRow(text: "Free Guy", width: .fill)
      TextCaption(text: "7.3/10 (140k)", glyph: "▮▮▮")
      TextCaption(text: "Action ‧ Adventure", width: .fill)
      TextCaption(text: "Director: Shawn Levy", width: .fill)
    }
  }
  Row(width: .fill, gap: 12) {
    Thumb(src: p2)
    Col(width: .fill, gap: 6) {
      TextRow(text: "Fast & Furious 8", width: .fill)
      TextCaption(text: "6.6/10 (220k)", glyph: "▮▮▮")
      TextCaption(text: "Action ‧ Adventure", width: .fill)
      TextCaption(text: "Director: F. Gary Gray", width: .fill)
    }
  }
  Row(width: .fill, gap: 12) {
    Thumb(src: p3)
    Col(width: .fill, gap: 6) {
      TextRow(text: "Fast and Furious 9", width: .fill)
      TextCaption(text: "5.2/10 (97k)", glyph: "▮▮")
      TextCaption(text: "Action ‧ Adventure", width: .fill)
      TextCaption(text: "Director: F. Gary Gray", width: .fill)
    }
  }
  Row(width: .fill, gap: 12) {
    Thumb(src: p4)
    Col(width: .fill, gap: 6) {
      TextRow(text: "Rampage", width: .fill)
      TextCaption(text: "5.2/10 (97k)", glyph: "▮▮")
      TextCaption(text: "Action ‧ Adventure", width: .fill)
      TextCaption(text: "Director: F. Gary Gray", width: .fill)
    }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 14) {
    appbar
    segment
    filterbar
    movies
  }
}
