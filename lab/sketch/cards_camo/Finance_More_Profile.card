# level: L0
# model: camo-app
theme camo

state email      { shape: text, initial: "Hello.carrotlabs@gmail.com" }
state email_hint { shape: text, initial: "Email" }
state phone      { shape: text, initial: "(+84) 999 999 999" }
state phone_hint { shape: text, initial: "Phone Number" }

view header Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Profile", width: .fit)
  }
  TextRow(text: "Exit", width: .fit)
}

view identity Col(align: .center, gap: 8, width: .fill) {
  Avatar(text: "LN")
  TextTitle(text: "Linh Nguyen", width: .fit)
  TextCaption(text: "Founder at CaDesign", width: .fit)
}

view fields Col(width: .fill, gap: 14) {
  Col(width: .fill, gap: 4) {
    TextEyebrow(text: "Email")
    Field(text: email, placeholder: email_hint)
  }
  Col(width: .fill, gap: 4) {
    TextEyebrow(text: "Phone Number")
    Field(text: phone, placeholder: phone_hint)
  }
}

view employer Row(width: .fill, align: .center, gap: 12) {
  Icon(name: .chevron_down)
  TextTitle(text: "Employer Infomation", width: .fill)
}

view root Surface(pad: .page) {
  header
  identity
  fields
  employer
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "Save", tone: .primary)
  }
}
