# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/f0b787dad6caadc59b0b536a3e2a99612abaff5d.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/0dc6cbab127560b83585acacdde87447a7bc8168.png" }
state price1 { shape: text, initial: "$9.99" }
state price2 { shape: text, initial: "$9.99" }

view topbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Cooks", width: .fit)
  }
  Icon(name: .heart)
}

view cook Row(width: .fill, align: .center, gap: 12) {
  Avatar(text: "A")
  Col(width: .fill, gap: 4) {
    TextRow(text: "Alberta", width: .fill)
    TextCaption(text: "24 Foods", width: .fill)
  }
  Icon(name: .star, size: .tile)
  TextCaption(text: "1.4k Review", width: .fit)
}

view cats Row(width: .fill, gap: 10) {
  Chip(text: "Appetizers", width: .fill)
  Chip(text: "Meat", width: .fill)
  Chip(text: "Fish & Seafoods", width: .fill)
}

view dish1 Col(width: .fill, gap: 10) {
  Thumb(src: p1, shape: .hero)
  Chip(text: "15%")
  TextTitle(text: "Sandwich with Bolied Egg", width: .fill)
  Row(width: .fill, gap: 6) {
    TextCaption(text: "24min •", width: .fit)
    Icon(name: .star, size: .tile)
    TextCaption(text: "4.5", width: .fit)
  }
  Row(width: .fill, gap: 8) {
    TextValue(value: price1)
    TextCaption(text: "$12.99", width: .fit)
  }
}

view dish2 Col(width: .fill, gap: 10) {
  Thumb(src: p2, shape: .hero)
  Chip(text: "15%")
  TextTitle(text: "Sandwich with Bolied Egg", width: .fill)
  Row(width: .fill, gap: 6) {
    TextCaption(text: "24min •", width: .fit)
    Icon(name: .star, size: .tile)
    TextCaption(text: "4.5", width: .fit)
  }
  Row(width: .fill, gap: 8) {
    TextValue(value: price2)
    TextCaption(text: "$12.99", width: .fit)
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 18) {
    topbar
    cook
    cats
    dish1
    dish2
  }
}
