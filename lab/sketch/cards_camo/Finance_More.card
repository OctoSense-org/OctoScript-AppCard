# level: L0
# model: camo-app
theme camo

state q { shape: text, initial: "Search for Setting…" }

view profilesection Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Profile", width: .fill)
    TextCaption(text: "Edit", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "LN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Linh Nguyen", width: .fill)
      TextCaption(text: "Founder at CaDesign", width: .fill)
    }
  }
}

view generalsection Col(width: .fill, gap: 14) {
  TextTitle(text: "General", width: .fill)
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .wifi)
    TextRow(text: "Internet", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .location)
    TextRow(text: "Location", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .bell)
    TextRow(text: "Notifications", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .lock)
    TextRow(text: "Security", width: .fill)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "More", width: .fill)
    Icon(name: .more)
  }
  Field(placeholder: q)
  profilesection
  generalsection
  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .search, label: "Item")
    Tab(icon: .chat, label: "Item")
    Tab(icon: .bell, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
