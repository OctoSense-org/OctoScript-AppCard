# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/aa1d09a274cbdd0628e0dd49bf58f11e3e363d5e.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/44676d5d91db51079b18bd536c9c19e63f23a504.png" }

view artists Grid(cols: 4) {
  Col(align: .center, gap: 6) {
    Avatar(text: "JB")
    TextCaption(text: "Justin Bieber", width: .fit)
  }
  Col(align: .center, gap: 6) {
    Avatar(text: "TS")
    TextCaption(text: "Taylor Swift", width: .fit)
  }
  Col(align: .center, gap: 6) {
    Avatar(text: "TW")
    TextCaption(text: "The Weeknd", width: .fit)
  }
  Col(align: .center, gap: 6) {
    Avatar(text: "ES")
    TextCaption(text: "Ed Sheeran", width: .fit)
  }
}

view singles Grid(cols: 2) {
  Col(width: .fill, gap: 6) {
    Thumb(src: p2, shape: .square)
    Row(width: .fill, align: .center, gap: 6) {
      Col(width: .fill, gap: 2) {
        TextRow(text: "Happier Than Ever", width: .fill)
        TextCaption(text: "Billie Eilish", width: .fill)
      }
      Icon(name: .play, size: .tile)
    }
  }
  Col(width: .fill, gap: 6) {
    Thumb(src: p2, shape: .square)
    Row(width: .fill, align: .center, gap: 6) {
      Col(width: .fill, gap: 2) {
        TextRow(text: "Montero", width: .fill)
        TextCaption(text: "Lil Nas X", width: .fill)
      }
      Icon(name: .play, size: .tile)
    }
  }
}

view tabbar Panel {
  Row(width: .fill, align: .center) {
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .search, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .play, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .heart, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .user, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "LN")
    Col(width: .fill, gap: 2) {
      TextCaption(text: "Good Morning", width: .fill)
      TextRow(text: "Hi, Linh Nguyen", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center) {
    TextTitle(text: "The Best", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Col(width: .fill, gap: 8) {
    Thumb(src: p1, shape: .hero)
    Row(width: .fill, align: .center, gap: 8) {
      Col(width: .fill, gap: 2) {
        TextTitle(text: "Justice", width: .fill)
        TextCaption(text: "Justin Bieber", width: .fill)
      }
      Icon(name: .play)
    }
  }
  Row(width: .fill, align: .center) {
    TextTitle(text: "Popular Artists", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  artists
  Row(width: .fill, align: .center) {
    TextTitle(text: "New Singles", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  singles
  Space()
  tabbar
}
