# level: L0
# model: camo-app
theme camo

state total_transfer { shape: text, initial: "$1004.00" }
state amt1 { shape: text, initial: "+$100.00" }
state amt2 { shape: text, initial: "-$1456.23" }

view header Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Spending", width: .fit)
  }
}

view filterbar Row(width: .fill, align: .center, gap: 8) {
  Chip(text: "Transfer $1004", active: .on)
  Icon(name: .plus)
}

view total Panel {
  Col(width: .fill, align: .center, gap: 10) {
    TextEyebrow(text: "Total Transfer")
    TextHero(value: total_transfer)
    TextCaption(text: "September", width: .fit)
  }
}

view people Row(width: .fill, gap: 10) {
  Panel {
    Row(align: .center, gap: 8) {
      Avatar(text: "AO")
      TextRow(text: "Alberta ($432.11)", width: .fit)
    }
  }
  Panel {
    Row(align: .center, gap: 8) {
      Avatar(text: "H")
      TextRow(text: "Harry ($360.86)", width: .fit)
    }
  }
}

view feed Col(width: .fill, gap: 12) {
  TextTitle(text: "Today, 27 Sep", width: .fill)
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "AO")
    Col(width: .fill, gap: 4) {
      TextRow(text: "Alberta Owens", width: .fill)
      TextCaption(text: "Today, 08:30 AM", width: .fill)
    }
    TextValue(value: amt1, tint: amt1)
  }
  Rule()
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "H")
    Col(width: .fill, gap: 4) {
      TextRow(text: "Harry", width: .fill)
      TextCaption(text: "Today, 08:30 AM", width: .fill)
    }
    TextValue(value: amt2, tint: amt2)
  }
}

view root Surface(pad: .page) {
  header
  filterbar
  total
  people
  feed
}
