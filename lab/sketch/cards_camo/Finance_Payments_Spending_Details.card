# level: L0
# model: camo-app
theme camo

state total       { shape: text, initial: "$1004.00" }
state amt_alberta { shape: text, initial: "+$100.00" }
state amt_harry   { shape: text, initial: "-$1456.23" }

view chart Panel {
  Col(width: .fill, align: .center, gap: 56) {
    TextCaption(text: "Total Transfer", width: .fit)
    TextHero(value: total)
    TextCaption(text: "September", width: .fit)
  }
}

view legend Grid(cols: 2) {
  Panel {
    Row(width: .fill, align: .center, gap: 10) {
      Avatar(text: "AO")
      TextRow(text: "Alberta ($432.11)", width: .fill)
    }
  }
  Panel {
    Row(width: .fill, align: .center, gap: 10) {
      Avatar(text: "HP")
      TextRow(text: "Harry ($360.86)", width: .fill)
    }
  }
}

view today Col(width: .fill, gap: 24) {
  TextTitle(text: "Today, 27 Sep", width: .fill)
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "AO")
    Col(width: .fill, gap: 6) {
      TextRow(text: "Alberta Owens", width: .fill)
      TextCaption(text: "Today, 08:30 AM", width: .fill)
    }
    TextValue(value: amt_alberta)
  }
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "HP")
    Col(width: .fill, gap: 6) {
      TextRow(text: "Harry", width: .fill)
      TextCaption(text: "Today, 08:30 AM", width: .fill)
    }
    TextValue(value: amt_harry)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Spending", width: .fit)
    }
  }
  Row(width: .fill, gap: 12) {
    Chip(text: "Transfer $1004")
  }
  chart
  legend
  today
}
