# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/c056fa857e05bee215dbf47c16ac8920b6258c8c.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/de63562bc8093ded0e9488ceb377c33a439c3ecf.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/ece6e23f75b852d77551192fbe84580123902df1.png" }
state p4 { shape: text, initial: "http://127.0.0.1:8787/02115466f222bf591863c8c54e7937140d2fbe61.png" }
state p5 { shape: text, initial: "http://127.0.0.1:8787/682f20a1bb86169f2d244fab18ffa4fc34e4ac06.png" }
state p6 { shape: text, initial: "http://127.0.0.1:8787/b559f0b5d3bdcb98c67db397481b9bf87d4728c7.png" }

view mosaic Grid(cols: 3) {
  Thumb(src: p1, shape: .square)
  Thumb(src: p2, shape: .square)
  Thumb(src: p3, shape: .square)
  Thumb(src: p4, shape: .square)
  Thumb(src: p5, shape: .square)
  Thumb(src: p6, shape: .square)
}

view copy Col(align: .center, gap: 10, width: .fill) {
  TextTitle(text: "Design Templates are Simple and Easy", width: .fit)
  TextBody(text: "Create a unique emotional story that describes better than words", width: .fit)
}

view footer Row(width: .fill, align: .center) {
  TextCaption(glyph: "—", width: .fill)
  Chip(text: "Next", tone: .primary, width: .fit)
}

view root Surface(pad: .page) {
  mosaic
  copy
  Space()
  footer
}
