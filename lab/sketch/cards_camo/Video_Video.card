# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/66d96c52c62c66c830a6b47853d99c124743b32a.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/a6a0084de9845d96ba58be9d81203b705e48892c.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/1884a576e2fcaa8b5bb8c7e524edbb378bec2337.png" }
state p4 { shape: text, initial: "http://127.0.0.1:8787/5fba4803fae6bf8a6794206dcc6b6bc1cfc64744.png" }

view soon Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Soon", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Grid(cols: 3) {
    Col(align: .center, gap: 6) {
      Thumb(src: p3, shape: .square)
      TextRow(text: "Into the Spider-Verse 2", width: .fill)
      TextCaption(text: "Released this Week", width: .fill)
    }
    Col(align: .center, gap: 6) {
      Thumb(src: p4, shape: .square)
      TextRow(text: "John Wick: Chapter 4", width: .fill)
      TextCaption(text: "Released this Week", width: .fill)
    }
    Col(align: .center, gap: 6) {
      Thumb(src: p1, shape: .square)
      TextRow(text: "Thor: Love and Thunder…", width: .fill)
      TextCaption(text: "Released this Week", width: .fill)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "LN")
    Col(width: .fill, gap: 2) {
      TextCaption(text: "Good Morning", width: .fill)
      TextRow(text: "Hi, Linh Nguyen", width: .fill)
    }
    Icon(name: .more)
  }
  Thumb(src: p1, shape: .hero)
  Thumb(src: p2)
  Col(width: .fill, align: .center, gap: 12) {
    TextCaption(text: "Action • Adventure", width: .fit)
    Row(width: .fill, align: .center, gap: 24) {
      Col(align: .center, gap: 4) {
        Icon(name: .plus)
        TextCaption(text: "Add", width: .fit)
      }
      Chip(text: "Play", tone: .primary)
      Col(align: .center, gap: 4) {
        Icon(name: .info)
        TextCaption(text: "Info", width: .fit)
      }
    }
  }
  soon
  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .search, label: "Item")
    Tab(icon: .video, label: "Item")
    Tab(icon: .bookmark, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
