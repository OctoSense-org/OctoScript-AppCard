# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/66d96c52c62c66c830a6b47853d99c124743b32a.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/a6a0084de9845d96ba58be9d81203b705e48892c.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/1884a576e2fcaa8b5bb8c7e524edbb378bec2337.png" }
state p4 { shape: text, initial: "http://127.0.0.1:8787/5fba4803fae6bf8a6794206dcc6b6bc1cfc64744.png" }
state p5 { shape: text, initial: "http://127.0.0.1:8787/66d96c52c62c66c830a6b47853d99c124743b32a.png" }

view hero Col(align: .center, gap: 8, width: .fill) {
  Thumb(src: p2)
  TextCaption(text: "Action • Adventure", width: .fit)
  Row(align: .center, gap: 14) {
    Col(align: .center, gap: 2) {
      Icon(name: .plus, size: .tile)
      TextCaption(text: "Add", width: .fit)
    }
    Chip(text: "Play", tone: .primary)
    Col(align: .center, gap: 2) {
      Icon(name: .info, size: .tile)
      TextCaption(text: "Info", width: .fit)
    }
  }
}

view soon Col(width: .fill, gap: 8) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Soon", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Grid(cols: 3) {
    Col(align: .center, gap: 6) {
      Thumb(src: p3, shape: .square)
      TextRow(text: "Into the Spider-Verse 2", width: .fit)
      TextCaption(text: "Released this Week", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Thumb(src: p4, shape: .square)
      TextRow(text: "John Wick: Chapter 4", width: .fit)
      TextCaption(text: "Released this Week", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Thumb(src: p5, shape: .square)
      TextRow(text: "Thor: Love and Thunder…", width: .fit)
      TextCaption(text: "Released this Week", width: .fit)
    }
  }
}

view tabbar Panel {
  Row(width: .fill, align: .center) {
    Col(align: .center, gap: 4, width: .fill) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 4, width: .fill) {
      Icon(name: .search, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 4, width: .fill) {
      Icon(name: .play, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 4, width: .fill) {
      Icon(name: .bookmark, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 4, width: .fill) {
      Icon(name: .user, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view root Photo(src: p1, pad: .page) {
  Row(width: .fill, align: .center, gap: 8) {
    Avatar(text: "LN")
    Col(width: .fill) {
      TextCaption(text: "Good Morning")
      TextRow(text: "Hi, Linh Nguyen", width: .fill)
    }
    Icon(name: .more)
  }
  hero
  soon
  tabbar
}
