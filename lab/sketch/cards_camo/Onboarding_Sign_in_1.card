# level: L0
# model: camo-app
theme camo

state email_value { shape: text, initial: "hello.carrotlabs@gmail.com" }
state email_label { shape: text, initial: "Email" }
state secret      { shape: text, initial: "••••••••" }

view header Col(width: .fill, gap: 10) {
  TextTitle(text: "Welcome Back to CaMo 2", width: .fill)
  TextBody(text: "Hello there, sign in to continue!", width: .fill)
}

view email_field Col(width: .fill, gap: 6) {
  TextCaption(text: "Email")
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .mail)
      Field(text: email_value, placeholder: email_label, width: .fill)
    }
  }
}

view password_field Panel {
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .lock)
    TextRow(text: secret, width: .fill)
    TextCaption(text: "Forgot?", width: .fit)
  }
}

view social Col(width: .fill, gap: 14) {
  Col(width: .fill, align: .center) {
    TextCaption(text: "Or continue with social account", width: .fit)
  }
  Chip(text: "Sign In with Google", width: .fill)
  Chip(text: "Sign In with Facebook", width: .fill)
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 14) {
    header
    email_field
    password_field
    Chip(text: "Login", tone: .primary, width: .fill)
    social
  }
  Space()
  Col(width: .fill, align: .center) {
    TextCaption(text: "Dont’s have an account? Sign up", width: .fit)
  }
}
