# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/9fd0b28ca61790e9dec3d9e7c69eb95bcf8db609.png" }

view root Photo(src: p1, pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Adress", width: .fit)
    }
    Row(align: .center, gap: 6) {
      Icon(name: .location, size: .row)
      TextCaption(text: "Hanoi", width: .fit)
    }
  }
  Space()
  Col(width: .fill, align: .center, gap: 12) {
    Chip(text: "Use Current Location", width: .fill)
    Chip(text: "Select Adress", tone: .primary, width: .fill)
  }
}
