# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/ad725d8f5c21c57030aac89d6072f9ca4d17da70.png" }
state b1 { shape: text, initial: "$1050.99" }
state b2 { shape: text, initial: "$1004.00" }
state b3 { shape: text, initial: "$484.00" }

view greeting Row(width: .fill, gap: 12) {
  Avatar(text: "LN")
  Col(width: .fill, gap: 2) {
    TextEyebrow(text: "Good Morning")
    TextRow(text: "Hi, Linh Nguyen", width: .fill)
  }
  Icon(name: .more)
}

view spending Card {
  Col(width: .fill, gap: 12) {
    Row(width: .fill) {
      Col(width: .fill, gap: 2) {
        TextEyebrow(text: "October Spending")
        TextHero(value: b1)
      }
      TextCaption(text: "See all", width: .fit)
    }
    Row(width: .fill, gap: 12) {
      Chip(text: "Deposit", width: .fill)
      Chip(text: "Withdraw", width: .fill)
    }
  }
}

view mycards Col(width: .fill, gap: 10) {
  TextTitle(text: "My Cards", width: .fill)
  Row(width: .fill, gap: 12) {
    Card {
      Col(width: .fill, gap: 6) {
        TextValue(value: b2)
        TextCaption(text: "Linh Nguyen")
        TextRow(text: "0000 **** **** 9999", width: .fill)
      }
    }
    Card(tint: .amber) {
      Col(width: .fill, gap: 6) {
        TextValue(value: b3)
        TextCaption(text: "Linh Nguyen")
        TextRow(text: "1111 **** **** 8888", width: .fill)
      }
    }
  }
}

view offers Col(width: .fill, gap: 10) {
  Row(width: .fill) {
    TextTitle(text: "Top Offers", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Panel {
    Row(width: .fill, gap: 12) {
      Thumb(src: p1, shape: .square)
      Col(width: .fill, gap: 4) {
        TextRow(text: "20%-40% Off", width: .fill)
        TextCaption(text: "Flat Discount on Every purchase!")
        Row(gap: 14) {
          TextCaption(text: "Food", width: .fit)
          TextCaption(text: "15 Days", width: .fit)
        }
      }
    }
  }
}

view tabbar Panel {
  Grid(cols: 5) {
    Col(align: .center, gap: 4) { Icon(name: .home, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .search, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .activity, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .bell, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .user, size: .tile) TextCaption(text: "Item", width: .fit) }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 18) {
    greeting
    spending
    mycards
    offers
  }
  Space()
  tabbar
}
