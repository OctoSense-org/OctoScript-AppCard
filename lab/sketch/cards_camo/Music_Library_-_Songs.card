# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/44676d5d91db51079b18bd536c9c19e63f23a504.png" }

view topbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) { TextTitle(text: "Songs", width: .fit) }
  Icon(name: .more)
}

view songs Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Stay", width: .fill)
      TextCaption(text: "The Kid LAROI, Justin Bieber", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Industry Baby", width: .fill)
      TextCaption(text: "Lil Nas X & Jack Harlow", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Bad Habits", width: .fill)
      TextCaption(text: "Ed Sheeran", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Fancy Like", width: .fill)
      TextCaption(text: "Walker Hayes", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Good 4 U", width: .fill)
      TextCaption(text: "Olivia Rodrigo", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Kiss Me More", width: .fill)
      TextCaption(text: "Doja Cat Featuring SZA", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Peaches", width: .fill)
      TextCaption(text: "Justin Bieber, Daniel Caesar", width: .fill)
    }
    Icon(name: .more)
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 18) {
    topbar
    Chip(text: "Shuffle", tone: .primary, width: .fill)
    songs
  }
}
