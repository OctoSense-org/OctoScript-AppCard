  Row(align: .center, gap: 6) {
    Icon(name: .star, size: .tile)
    TextRow(text: "8.2/10 (391k)", width: .fit)
  }
  Col(align: .center, width: .fill) {
    Chip(text: "Watch", tone: .primary)
  }
