# level: L0
# model: camo-app
theme camo_light

state fee1 { shape: text, initial: "$9.99" }
state fee2 { shape: text, initial: "$15.90" }
state fee3 { shape: text, initial: "$18.00" }

view bar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Dentist", width: .fit)
  }
}

view docone Panel {
  Col(gap: 18, width: .fill) {
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "JF")
      Col(width: .fill, gap: 8) {
        TextRow(text: "Jonathan Fields", width: .fill)
        Row(width: .fill, align: .center, gap: 4) {
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          TextCaption(text: "1.2K Reviews", width: .fill)
        }
      }
    }
    TextBody(text: "• Doctor of Qualification", width: .fill)
    TextBody(text: "• Work Experience: 12 years", width: .fill)
    TextValue(value: fee1)
    Chip(text: "Appointment a Doctor", width: .fill)
  }
}

view doctwo Panel {
  Col(gap: 18, width: .fill) {
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "JA")
      Col(width: .fill, gap: 8) {
        TextRow(text: "Joseph Atkins", width: .fill)
        Row(width: .fill, align: .center, gap: 4) {
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          TextCaption(text: "680 Reviews", width: .fill)
        }
      }
    }
    TextBody(text: "• Doctor of Qualification", width: .fill)
    TextBody(text: "• Work Experience: 10 years", width: .fill)
    TextValue(value: fee2)
    Chip(text: "Appointment a Doctor", width: .fill)
  }
}

view docthree Panel {
  Col(gap: 18, width: .fill) {
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "AC")
      Col(width: .fill, gap: 8) {
        TextRow(text: "Alma Cannon", width: .fill)
        Row(width: .fill, align: .center, gap: 4) {
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          Icon(name: .star, size: .tile)
          TextCaption(text: "680 Reviews", width: .fill)
        }
      }
    }
    TextBody(text: "• Doctor of Qualification", width: .fill)
    TextBody(text: "• Work Experience: 10 years", width: .fill)
    TextValue(value: fee3)
    Chip(text: "Appointment a Doctor", width: .fill)
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 16) {
    bar
    docone
    doctwo
    docthree
  }
}
