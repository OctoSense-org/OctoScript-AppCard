# level: L0
# model: camo-app
theme camo

state total     { shape: text, initial: "$1050.99" }
state amt_shop  { shape: text, initial: "-$240.00" }
state amt_soph  { shape: text, initial: "+$100.00" }
state amt_med   { shape: text, initial: "-$42.90" }

view chart Panel {
  Col(align: .center, gap: 56, width: .fill) {
    TextCaption(text: "Total Spending", width: .fit)
    TextHero(value: total)
    TextCaption(text: "September", width: .fit)
  }
}

view categories Col(width: .fill, gap: 12) {
  Row(width: .fill, gap: 12) {
    Chip(text: "Transfer $1004")
    Chip(text: "Shop $800.00")
  }
  Row(width: .fill, gap: 12) {
    Chip(text: "Entertaiment $360.86")
    Chip(text: "Internet $20.94")
  }
  Row(width: .fill, gap: 12) {
    Chip(text: "Cellular $120.00")
    Chip(text: "Medicine $432.11")
  }
}

view today Col(width: .fill, gap: 24) {
  TextTitle(text: "Today, 27 Sep", width: .fill)
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "SH")
    Col(width: .fill, gap: 6) {
      TextRow(text: "Shopping", width: .fill)
      TextCaption(text: "Today, 09:21 AM", width: .fill)
    }
    TextValue(value: amt_shop)
  }
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "SO")
    Col(width: .fill, gap: 6) {
      TextRow(text: "Sophie Owens", width: .fill)
      TextCaption(text: "Today, 08:30 AM", width: .fill)
    }
    TextValue(value: amt_soph)
  }
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "ME")
    Col(width: .fill, gap: 6) {
      TextRow(text: "Medicine", width: .fill)
      TextCaption(text: "Today, 08:00 AM", width: .fill)
    }
    TextValue(value: amt_med)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Spending", width: .fit)
    }
    Icon(name: .more)
  }
  chart
  categories
  today
}
