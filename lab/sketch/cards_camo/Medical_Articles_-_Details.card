# level: L0
# model: camo-app

theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/c3d350db8fe53ab62734582e96092f99c6c8e0c8.png" }

view topbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
}

view headline Col(width: .fill, gap: 10) {
  TextEyebrow(text: "7 September 2021")
  TextTitle(text: "WHO strengthens COVID-19 response by improving regional", width: .fill)
}

view story Col(width: .fill, gap: 12) {
  TextBody(text: "“Last week, the number of COVID-19 cases and deaths reported to WHO declined for the first time in more than two months.", width: .fill)
  TextBody(text: "This is obviously very welcome, but it doesn’t mean much. Around the world many countries are still seeing steep increases in cases and", width: .fill)
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 16) {
    topbar
    Thumb(src: p1, shape: .hero)
    headline
    Rule()
    story
    Thumb(src: p1, shape: .hero)
  }
}
