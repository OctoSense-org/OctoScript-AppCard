# level: L0
# model: camo-app
theme camo

state q { shape: text, initial: "Search for Name & Payments…" }

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Services", width: .fill)
    Icon(name: .more)
  }

  Field(placeholder: q)

  TextTitle(text: "Concerts", width: .fill)

  Card(tint: .blue) {
    Col(gap: 10) {
      TextTitle(text: "People from the Future", width: .fill)
      TextBody(text: "Is Time Travel, Especially Into the Past Possible?", width: .fill)
    }
  }

  Row(width: .fill, align: .center) {
    TextTitle(text: "Food", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }

  Col(width: .fill, gap: 12) {
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "MD")
      Col(width: .fill, gap: 2) {
        TextRow(text: "20%-40% Off", width: .fill)
        TextCaption(text: "McDonald's", width: .fill)
      }
    }
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "PH")
      Col(width: .fill, gap: 2) {
        TextRow(text: "Cashback 15%", width: .fill)
        TextCaption(text: "Pizza Hut", width: .fill)
      }
    }
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "KF")
      Col(width: .fill, gap: 2) {
        TextRow(text: "Discount 20%", width: .fill)
        TextCaption(text: "KFC", width: .fill)
      }
    }
  }

  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .search, label: "Item")
    Tab(icon: .zap, label: "Item")
    Tab(icon: .bell, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
