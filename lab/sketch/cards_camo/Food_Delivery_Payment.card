# level: L0
# model: camo-app
theme camo_light

state card_mask   { shape: text, initial: "**** 9999" }
state balance     { shape: text, initial: "$1004.00" }
state holder_name { shape: text, initial: "NGUYEN VAN LINH" }
state holder_hint { shape: text, initial: "Cardholder Name" }
state card_number { shape: text, initial: "0000 6666 8888 9999" }
state number_hint { shape: text, initial: "Card Number" }
state exp_date    { shape: text, initial: "02/2022" }
state date_hint   { shape: text, initial: "Date" }
state ccv_code    { shape: text, initial: "999" }
state ccv_hint    { shape: text, initial: "CCV" }

view topbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Payment", width: .fit)
  }
}

view modes Panel {
  Row(width: .fill, align: .center, gap: 8) {
    Chip(text: "Normal", width: .fill)
    Chip(text: "Active", width: .fill)
  }
}

view balancecard Card {
  Col(width: .fill, gap: 34) {
    Row(width: .fill, align: .center) {
      TextRow(text: "Linh Nguyen", width: .fill)
      TextValue(value: card_mask)
    }
    Col(width: .fill, gap: 10) {
      TextCaption(text: "Balance", width: .fill)
      TextHero(value: balance)
    }
  }
}

view form Col(width: .fill, gap: 20) {
  Field(text: holder_name, placeholder: holder_hint)
  Field(text: card_number, placeholder: number_hint)
  Row(width: .fill, align: .center, gap: 14) {
    Field(text: exp_date, placeholder: date_hint)
    Field(text: ccv_code, placeholder: ccv_hint)
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 26) {
    topbar
    modes
    balancecard
    form
  }
  Space()
  Col(width: .fill, align: .center) {
    Chip(text: "Pay", tone: .primary, width: .fill)
  }
}
