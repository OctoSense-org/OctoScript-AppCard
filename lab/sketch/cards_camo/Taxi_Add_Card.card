# level: L0
# model: camo-app
theme camo_light

state cardnum { shape: text, initial: "2018 8017 301 8888" }
state cardnum_ph { shape: text, initial: "Full name" }
state expiry { shape: text, initial: "10/2023" }
state expiry_ph { shape: text, initial: "Expiry date" }
state cvv { shape: text, initial: "999" }
state cvv_ph { shape: text, initial: "CVV" }

view cardlist Col(width: .fill, gap: 12) {
  TextTitle(text: "Credit Cards", width: .fill)
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "MC")
      Col(width: .fill, gap: 4) {
        TextRow(text: "MasterCard", width: .fill)
        TextCaption(text: "1236 **** **** 8888", width: .fill)
      }
      Icon(name: .chevron_right)
    }
  }
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Avatar(text: "VI")
      Col(width: .fill, gap: 4) {
        TextRow(text: "Visa", width: .fill)
        TextCaption(text: "1236 **** **** 6666", width: .fill)
      }
      Icon(name: .chevron_right)
    }
  }
}

view sheet Panel {
  Col(width: .fill, gap: 14) {
    Col(width: .fill, align: .center) {
      TextTitle(text: "Add Card", width: .fit)
    }
    Field(text: cardnum, placeholder: cardnum_ph)
    Row(width: .fill, gap: 12) {
      Field(text: expiry, placeholder: expiry_ph)
      Field(text: cvv, placeholder: cvv_ph)
    }
    Row(width: .fill, align: .center, gap: 8) {
      Icon(name: .check, size: .tile)
      TextCaption(text: "Set Default Payment", width: .fill)
    }
    Space()
    Col(width: .fill, align: .center) {
      Chip(text: "Add Card", tone: .primary, width: .fill)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Payment Method", width: .fit)
    }
    Space()
  }
  cardlist
  sheet
}
