# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/c17b19865a00dc3ccdd8be8a21a16fadbd41f93d.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/a7694d1ebda5af9565a3e0764b397e5bf2f5cff6.png" }

view profiles Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "MP")
    Col(width: .fill, gap: 4) {
      TextRow(text: "Main Profile", width: .fill)
      TextCaption(text: "Age limit 18+", width: .fill)
    }
  }
  Rule()
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "MP")
    Col(width: .fill, gap: 4) {
      TextRow(text: "Main Profile", width: .fill)
      TextCaption(text: "Age limit 12+", width: .fill)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Main Profile", width: .fit)
    }
    Icon(name: .chevron_left)
  }
  profiles
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "New Profile", tone: .primary, width: .fill)
  }
}
