# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/4f139605c1a81afb389982ef91d8854792a3e67f.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/3cdc62d2f10fb279debb789df4461c42e2eddc7f.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/1cca86e15d3c3d56c277796c3525119f21f17667.png" }
state p4 { shape: text, initial: "http://127.0.0.1:8787/27e7216916d6bb33a80ef2f49183e71ca7963f36.png" }
state p5 { shape: text, initial: "http://127.0.0.1:8787/66d96c52c62c66c830a6b47853d99c124743b32a.png" }
state p6 { shape: text, initial: "http://127.0.0.1:8787/5a1eb1d17e26f3ad8d6e80ac9f97be8c4950cadf.png" }

view tvseries Col(width: .fill, gap: 8) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "TV Series", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Grid(cols: 2) {
    Col(width: .fill, gap: 4) {
      Thumb(src: p1)
      TextRow(text: "Kingdom: Ashin of the North", width: .fill)
      Row(width: .fill, align: .center) {
        TextCaption(text: "Gruesome ‧ 1h 32min", width: .fill)
        TextCaption(text: "1:32:00", width: .fit)
      }
    }
    Col(width: .fill, gap: 4) {
      Thumb(src: p2)
      TextRow(text: "Squid Game", width: .fill)
      TextCaption(text: "Season 1 ‧ Episodes 1", width: .fill)
    }
  }
}

view films Col(width: .fill, gap: 8) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Films", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Grid(cols: 2) {
    Col(width: .fill, gap: 4) {
      Thumb(src: p3)
      TextRow(text: "Fast & Furious 8", width: .fill)
      Row(width: .fill, align: .center) {
        TextCaption(text: "Action ‧ Adventure", width: .fill)
        TextCaption(text: "2:16:00", width: .fit)
      }
    }
    Col(width: .fill, gap: 4) {
      Thumb(src: p4)
      TextRow(text: "Free Guy", width: .fill)
      TextCaption(text: "Action ‧ Adventure", width: .fill)
    }
  }
}

view recommended Col(width: .fill, gap: 8) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Recommended", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Grid(cols: 2) {
    Col(width: .fill, gap: 4) {
      Thumb(src: p5, shape: .square)
      TextRow(text: "Thor: Love & Thunder", width: .fill)
      TextCaption(text: "Action • Adventure", width: .fill)
    }
    Col(width: .fill, gap: 4) {
      Thumb(src: p6, shape: .square)
      TextRow(text: "Into the Spider-Verse", width: .fill)
      TextCaption(text: "Animation • Action", width: .fill)
    }
  }
}

view tabbar Panel {
  Grid(cols: 5) {
    Col(align: .center, gap: 4) { Icon(name: .home, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .search, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .video, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .bookmark, size: .tile) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 4) { Icon(name: .user, size: .tile) TextCaption(text: "Item", width: .fit) }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Look", width: .fill)
    Icon(name: .more)
  }
  tvseries
  films
  recommended
  tabbar
}
