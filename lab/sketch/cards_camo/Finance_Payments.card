# level: L0
# model: camo-app
theme camo

state search_ph { shape: text, initial: "Search for Name & Payments…" }

view contacts Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "My Contacts", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Grid(cols: 5) {
    Col(align: .center, gap: 6) {
      Avatar(text: "A")
      TextCaption(text: "Alberta", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Avatar(text: "F")
      TextCaption(text: "Frederick", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Avatar(text: "E")
      TextCaption(text: "Eugene", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Avatar(text: "I")
      TextCaption(text: "Isabella", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Avatar(text: "L")
      TextCaption(text: "Lucille", width: .fit)
    }
  }
}

view transfers Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Transfers", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Grid(cols: 2) {
    Card(tint: .blue) {
      Row(width: .fill, align: .center, gap: 10) {
        Icon(name: .settings)
        Col(width: .fill, gap: 4) {
          TextRow(text: "Card Number", width: .fill)
          TextCaption(text: "Enter card number", width: .fill)
        }
      }
    }
    Card(tint: .amber) {
      Row(width: .fill, align: .center, gap: 10) {
        Icon(name: .user)
        Col(width: .fill, gap: 4) {
          TextRow(text: "Account Number", width: .fill)
          TextCaption(text: "Enter Account", width: .fill)
        }
      }
    }
  }
}

view payments Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Payments", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .wifi)
    TextRow(text: "Internet", width: .fill)
    Icon(name: .chevron_right)
  }
  Rule()
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .zap)
    TextRow(text: "Electricity", width: .fill)
    Icon(name: .chevron_right)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Payments", width: .fill)
    Icon(name: .more)
  }
  Field(placeholder: search_ph)
  contacts
  transfers
  payments
  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .search, label: "Item")
    Tab(icon: .send, label: "Item")
    Tab(icon: .bell, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
