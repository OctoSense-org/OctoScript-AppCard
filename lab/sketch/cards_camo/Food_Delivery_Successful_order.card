# level: L0
# model: camo-app
theme camo_light

view root Surface(pad: .page) {
  Space()
  Col(align: .center, gap: 10) {
    Icon(name: .check, size: .hero)
    TextTitle(text: "Your Order is Successfully!", width: .fit)
  }
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "Continue Shopping", tone: .primary)
  }
}
