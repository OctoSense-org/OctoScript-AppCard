theme camo_light

view root Surface(pad: .page) {
  Space()
  Col(align: .center, gap: 40, width: .fill) {
    Col(align: .center, gap: 14, width: .fill) {
      Card {
        Col(align: .center, gap: 10, width: .fill) {
          Icon(name: .check, size: .hero)
        }
      }
      TextTitle(text: "Your Order is Successfully!", width: .fit)
    }
    Chip(text: "Continue Shopping", tone: .primary)
  }
  Space()
}
