theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/cc79b3df763c3bb43552231fd1b02049bdce86de.png" }

view profile Col(align: .center, gap: 14, width: .fill) {
  Thumb(src: p1, shape: .square)
  TextRow(text: "Linh Nguyen", width: .fit)
  Row(width: .fill, align: .center, gap: 12) {
    TextCaption(glyph: "●", width: .fit)
    TextCaption(glyph: "●", width: .fit)
    TextCaption(glyph: "●", width: .fit)
    TextCaption(glyph: "●", width: .fit)
  }
}

view keypad Panel {
  Grid(cols: 3) {
    Tile(label: "1")
    Tile(label: "2")
    Tile(label: "3")
    Tile(label: "4")
    Tile(label: "5")
    Tile(label: "6")
    Tile(label: "7")
    Tile(label: "8")
    Tile(label: "9")
    Tile(label: ".")
    Tile(label: "0")
    Col(align: .center, width: .fill) { Icon(name: .arrow_left) }
  }
}

view root Surface(pad: .page) {
  Space()
  profile
  Space()
  keypad
  Col(align: .center, width: .fill) {
    Chip(text: "Reset", tone: .primary)
  }
}
