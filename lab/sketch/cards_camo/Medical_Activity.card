# level: L0
# model: camo-app
theme camo_light

state cycling_dist  { shape: text, initial: "98.00" }
state cycling_time  { shape: text, initial: "50 min" }
state cycling_cal   { shape: text, initial: "186 Cal" }
state steps_count   { shape: text, initial: "1204" }
state steps_time    { shape: text, initial: "37 min" }
state steps_cal     { shape: text, initial: "328 Cal" }
state running_dist  { shape: text, initial: "30.24" }
state running_time  { shape: text, initial: "37 min" }
state running_cal   { shape: text, initial: "328 Cal" }

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) { TextTitle(text: "Activity", width: .fit) }
    Icon(name: .bell)
  }
  Row(width: .fill, gap: 8) {
    Chip(text: "Normal", width: .fill)
    Chip(text: "Normal", width: .fill)
    Chip(text: "Active", active: .on, width: .fill)
  }
  Col(width: .fill, gap: 16) {
    Panel {
      Row(width: .fill, align: .center, gap: 8) {
        Icon(name: .activity, size: .tile)
        TextTitle(text: "Cycling", width: .fill)
        TextCaption(text: "October", width: .fit)
      }
      TextValue(value: cycling_dist, unit: "Km")
      TextCaption(text: "Time:", value: cycling_time)
      TextCaption(text: "Calories burnt:", value: cycling_cal)
      Icon(name: .arrow_right)
    }
    Panel {
      Row(width: .fill, align: .center, gap: 8) {
        Icon(name: .activity, size: .tile)
        TextTitle(text: "Steps", width: .fill)
        TextCaption(text: "September", width: .fit)
      }
      TextValue(value: steps_count, unit: "Steps")
      TextCaption(text: "Time:", value: steps_time)
      TextCaption(text: "Calories burnt:", value: steps_cal)
      Icon(name: .arrow_right)
    }
    Panel {
      Row(width: .fill, align: .center, gap: 8) {
        Icon(name: .activity, size: .tile)
        TextTitle(text: "Ruuning", width: .fill)
        TextCaption(text: "September", width: .fit)
      }
      TextValue(value: running_dist, unit: "Km")
      TextCaption(text: "Time:", value: running_time)
      TextCaption(text: "Calories burnt:", value: running_cal)
      Icon(name: .arrow_right)
    }
  }
}
