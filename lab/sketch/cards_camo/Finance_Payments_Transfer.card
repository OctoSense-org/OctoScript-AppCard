# level: L0
# model: camo-app
theme camo

state amount_v { shape: text, initial: "$404.00" }
state balance_v { shape: text, initial: "$1004.00" }
state msg_ph { shape: text, initial: "Message" }

view header Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Transfer", width: .fit)
  }
}

view amount Col(width: .fill, align: .center, gap: 8) {
  TextCaption(text: "Amount", width: .fit)
  TextHero(value: amount_v)
}

view sourcecard Card {
  Col(width: .fill, gap: 10) {
    TextCaption(text: "Linh Nguyen")
    TextRow(text: "0000 **** **** 9999")
    TextCaption(text: "Balance")
    TextValue(value: balance_v)
  }
}

view recipient Row(width: .fill, align: .center, gap: 12) {
  Avatar(text: "AO")
  Col(width: .fill, gap: 4) {
    TextRow(text: "Alberta Owens", width: .fill)
    TextCaption(text: "Hello Linh", width: .fill)
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 24) {
    header
    amount
    sourcecard
    recipient
    Field(placeholder: msg_ph)
  }
  Space()
  Col(width: .fill, align: .center) {
    Chip(text: "Transfer", tone: .primary, width: .fill)
  }
}
