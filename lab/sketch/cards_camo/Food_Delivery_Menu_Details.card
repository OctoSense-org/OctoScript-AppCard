# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/f0b787dad6caadc59b0b536a3e2a99612abaff5d.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/0dc6cbab127560b83585acacdde87447a7bc8168.png" }
state price1 { shape: text, initial: "$9.99" }
state was1 { shape: text, initial: "$12.99" }
state price2 { shape: text, initial: "$9.99" }
state was2 { shape: text, initial: "$12.99" }

view bar Row(width: .fill, align: .center, gap: 8) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Appetizers", width: .fit)
  }
  Icon(name: .location, size: .tile)
  TextCaption(text: "Hanoi", width: .fit)
}

view tabs Row(width: .fill, gap: 8) {
  Chip(text: "Appetizers")
  Chip(text: "Meat")
  Chip(text: "Fish & Seafoods")
}

view toolbar Row(width: .fill, align: .center, gap: 8) {
  Icon(name: .filter, size: .tile)
  TextRow(text: "92 Foods", width: .fill)
  Icon(name: .image, size: .tile)
  Icon(name: .menu, size: .tile)
}

view item1 Col(width: .fill, gap: 6) {
  Thumb(src: p1, shape: .hero)
  Chip(text: "15%")
  TextTitle(text: "Sandwich with Bolied Egg", width: .fill)
  Row(width: .fill, gap: 6) {
    TextCaption(text: "24min •", width: .fit)
    TextCaption(text: "4.5", glyph: "★", width: .fit)
  }
  Row(width: .fill, gap: 8) {
    TextValue(value: price1)
    TextValue(value: was1)
  }
}

view item2 Col(width: .fill, gap: 6) {
  Thumb(src: p2, shape: .hero)
  Chip(text: "15%")
  TextTitle(text: "Sandwich with Bolied Egg", width: .fill)
  Row(width: .fill, gap: 6) {
    TextCaption(text: "24min •", width: .fit)
    TextCaption(text: "4.5", glyph: "★", width: .fit)
  }
  Row(width: .fill, gap: 8) {
    TextValue(value: price2)
    TextValue(value: was2)
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 12) {
    bar
    tabs
    toolbar
    item1
    item2
  }
}
