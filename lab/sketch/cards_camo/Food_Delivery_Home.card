# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/f0b787dad6caadc59b0b536a3e2a99612abaff5d.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/0dc6cbab127560b83585acacdde87447a7bc8168.png" }
state q1 { shape: text, initial: "Search for food…" }
state price1 { shape: text, initial: "$9.99" }
state price2 { shape: text, initial: "$9.99" }

view header Row(width: .fill, align: .center, gap: 10) {
  Avatar(text: "HV")
  Icon(name: .location, size: .tile)
  TextRow(text: "Hanoi, Vietnam", width: .fill)
}

view hero Card(tint: .neutral) {
  Col(width: .fill, gap: 24) {
    Col(width: .fill, align: .center) {
      TextTitle(text: "What do you want to eat today?", width: .fit)
    }
    Field(placeholder: q1)
  }
}

view category Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Popular Category", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Row(width: .fill, gap: 10) {
    Chip(text: "Hamburger", width: .fill)
    Chip(text: "Hotdog", width: .fill)
    Chip(text: "French fries", width: .fill)
  }
}

view food Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Popular Food", width: .fill)
    TextCaption(text: "See all (171)", width: .fit)
  }
  Grid(cols: 2) {
    Col(width: .fill, gap: 8) {
      Thumb(src: p1, shape: .square)
      Chip(text: "15%")
      TextRow(text: "Sandwich with Bolied Egg", width: .fill)
      Row(width: .fill, gap: 6) {
        TextCaption(text: "24min •", width: .fit)
        Icon(name: .star, size: .tile)
        TextCaption(text: "4.5", width: .fit)
      }
      Row(width: .fill, gap: 8) {
        TextValue(value: price1)
        TextCaption(text: "$12.99", width: .fit)
      }
    }
    Col(width: .fill, gap: 8) {
      Thumb(src: p2, shape: .square)
      Chip(text: "15%")
      TextRow(text: "Pancake with Orange", width: .fill)
      Row(width: .fill, gap: 6) {
        TextCaption(text: "24min •", width: .fit)
        Icon(name: .star, size: .tile)
        TextCaption(text: "4.5", width: .fit)
      }
      Row(width: .fill, gap: 8) {
        TextValue(value: price2)
        TextCaption(text: "$12.99", width: .fit)
      }
    }
  }
}

view tabbar Panel {
  Row(width: .fill, align: .center) {
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .home)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .search)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .heart)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .bell)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .user)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 18) {
    header
    hero
    category
    food
  }
  Space()
  tabbar
}
