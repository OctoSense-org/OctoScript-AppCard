# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/f0b787dad6caadc59b0b536a3e2a99612abaff5d.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/0dc6cbab127560b83585acacdde87447a7bc8168.png" }
state search_hint { shape: text, initial: "Search for food…" }
state price_a { shape: text, initial: "$9.99" }
state price_b { shape: text, initial: "$9.99" }

view header Row(width: .fill, align: .center, gap: 8) {
  Avatar(text: "HV")
  Icon(name: .location, size: .tile)
  TextRow(text: "Hanoi, Vietnam", width: .fill)
  Icon(name: .more)
}

view hero Card(tint: .blue) {
  Col(align: .center, gap: 12, width: .fill) {
    TextTitle(text: "What do you want to eat today?", width: .fit)
    Field(placeholder: search_hint)
  }
}

view category Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Popular Category", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  Row(width: .fill, gap: 8) {
    Chip(text: "Hamburger")
    Chip(text: "Hotdog")
    Chip(text: "French fries")
  }
}

view food Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Popular Food", width: .fill)
    TextCaption(text: "See all (171)", width: .fit)
  }
  Grid(cols: 2) {
    Panel {
      Col(width: .fill, gap: 6) {
        Thumb(src: p1)
        Chip(text: "15%")
        TextRow(text: "Sandwich with Bolied Egg", width: .fill)
        Row(width: .fill, gap: 6) {
          TextCaption(text: "24min •", width: .fit)
          TextCaption(text: "4.5", glyph: "★", width: .fit)
        }
        Row(width: .fill, align: .center, gap: 6) {
          TextValue(value: price_a)
          TextCaption(text: "$12.99", width: .fit)
        }
      }
    }
    Panel {
      Col(width: .fill, gap: 6) {
        Thumb(src: p2)
        Chip(text: "15%")
        TextRow(text: "Pancake with Orange", width: .fill)
        Row(width: .fill, gap: 6) {
          TextCaption(text: "24min •", width: .fit)
          TextCaption(text: "4.5", glyph: "★", width: .fit)
        }
        Row(width: .fill, align: .center, gap: 6) {
          TextValue(value: price_b)
          TextCaption(text: "$12.99", width: .fit)
        }
      }
    }
  }
}

view root Surface(pad: .page) {
  header
  hero
  category
  food
  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .search, label: "Item")
    Tab(icon: .heart, label: "Item")
    Tab(icon: .bell, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
