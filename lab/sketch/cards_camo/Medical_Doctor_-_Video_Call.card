# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/e5ce3e34062b6c5248b1f1b54cb6d8dfe9754e20.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/fe0f8e02f96b082b8007be11c0905d89b833a09c.png" }

view root Photo(src: p1, pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Space()
    Col(align: .center, gap: 8) {
      Thumb(src: p2)
      Icon(name: .video)
    }
  }
  Space()
  Col(align: .center, gap: 6, width: .fill) {
    TextTitle(text: "Dr. Joseph Atkins", width: .fit)
    TextCaption(text: "08:23", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 24) {
    Icon(name: .camera)
    Icon(name: .phone)
    Icon(name: .mic)
  }
}
