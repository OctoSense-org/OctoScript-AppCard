# level: L0
# model: camo-app
theme camo

state search_q { shape: text, initial: "Search for Name…" }

view chatlist Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "CB")
    Col(width: .fill, gap: 2) {
      TextRow(text: "CaMo Bank", width: .fill)
      TextCaption(text: "Welcome to Chat", width: .fill)
    }
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "AO")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Alberta Owens", width: .fill)
      TextCaption(text: "Hello Linh", width: .fill)
    }
    TextCaption(text: "5s", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "SG")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Stanley Graham", width: .fill)
      TextCaption(text: "Good Morning", width: .fill)
    }
    TextCaption(text: "24 mins", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "AO")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Alberta Owens", width: .fill)
      TextCaption(text: "How are you", width: .fill)
    }
    TextCaption(text: "34 mins", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "AO")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Alberta Owens", width: .fill)
      TextCaption(text: "I have transferred your …", width: .fill)
    }
    TextCaption(text: "2 hours", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "AO")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Alberta Owens", width: .fill)
      TextCaption(text: "Have you receive mone…", width: .fill)
    }
    TextCaption(text: "23 Sep", width: .fit)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Chat", width: .fill)
    Icon(name: .more)
  }
  Field(placeholder: search_q)
  chatlist
  TabBar {
    Tab(icon: .home, label: "Item")
    Tab(icon: .chat, label: "Item", active: .on)
    Tab(icon: .activity, label: "Item")
    Tab(icon: .bell, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
