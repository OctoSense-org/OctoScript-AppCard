# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }

view root Surface(pad: .page) {
  Col(align: .center, gap: 4, width: .fill) {
    TextTitle(text: "Design Templates are", width: .fit)
    TextTitle(text: "Simple and Easy", width: .fit)
  }
  Thumb(src: p1, shape: .hero)
  Col(align: .center, gap: 6, width: .fill) {
    TextBody(text: "Create a unique emotional story that", width: .fit)
    TextBody(text: "describes better than words", width: .fit)
  }
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "Get Started", tone: .primary)
  }
}
