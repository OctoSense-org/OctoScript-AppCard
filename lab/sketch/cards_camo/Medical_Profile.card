# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/cc79b3df763c3bb43552231fd1b02049bdce86de.png" }

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Profile", width: .fill)
    Icon(name: .more)
  }

  Row(width: .fill, align: .center) {
    TextTitle(text: "Profile", width: .fill)
    TextCaption(text: "Edit", width: .fit)
  }

  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "LN")
    Col(width: .fill, gap: 4) {
      TextRow(text: "Linh Nguyen", width: .fill)
      TextCaption(text: "Founder at CaDesign", width: .fill)
    }
    Icon(name: .chevron_right)
  }

  TextTitle(text: "My Devices", width: .fill)

  Row(width: .fill, align: .center) {
    TextRow(text: "Apple Watch", width: .fill)
    Icon(name: .chevron_right)
  }

  TextTitle(text: "Other", width: .fill)

  Row(width: .fill, align: .center) {
    TextRow(text: "Friends", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Add Accounts", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Feedback", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center) {
    TextRow(text: "Smart Analysis", width: .fill)
    Icon(name: .chevron_right)
  }

  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .activity, label: "Item")
    Tab(icon: .calendar, label: "Item")
    Tab(icon: .chat, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
