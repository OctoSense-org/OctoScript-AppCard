# level: L0
# model: camo-app
theme camo

state name { shape: text, initial: "Nguyen Van Linh" }
state name_hint { shape: text, initial: "Full name" }
state email { shape: text, initial: "hello.carrotlabs@gmail.com" }
state email_hint { shape: text, initial: "Email" }
state pass { shape: text, initial: "••••••" }
state pass_hint { shape: text, initial: "Password" }

view header Col(width: .fill, gap: 10) {
  TextTitle(text: "Get Started to CaMo 2", width: .fill)
  TextBody(text: "Hello there, sign in to continue!", width: .fill)
}

view form Col(width: .fill, gap: 12) {
  Field(text: name, placeholder: name_hint)
  Field(text: email, placeholder: email_hint)
  Row(width: .fill, align: .center, gap: 12) {
    Field(text: pass, placeholder: pass_hint)
    TextCaption(text: "Forgot?", width: .fit)
  }
}

view actions Col(align: .center, width: .fill, gap: 16) {
  Chip(text: "Start", tone: .primary, width: .fill)
  TextCaption(text: "Or continue with social account", width: .fit)
  Row(width: .fill, align: .center, gap: 12) {
    Chip(text: "Google", width: .fill)
    Chip(text: "Facebook", width: .fill)
  }
  TextCaption(text: "Already have an account? Sign in", width: .fit)
}

view root Surface(pad: .page) {
  header
  form
  Space()
  actions
}
