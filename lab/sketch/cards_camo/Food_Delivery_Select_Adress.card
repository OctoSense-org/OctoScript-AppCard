# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/9fd0b28ca61790e9dec3d9e7c69eb95bcf8db609.png" }
state city { shape: text, initial: "Hanoi" }
state street { shape: text, initial: "Hai Ba Trung" }
state house { shape: text, initial: "02" }
state flat { shape: text, initial: "02" }

view addressform Col(width: .fill, gap: 14) {
  Col(width: .fill, gap: 4) {
    TextEyebrow(text: "City")
    Field(text: city)
  }
  Col(width: .fill, gap: 4) {
    TextEyebrow(text: "Street")
    Field(text: street)
  }
  Grid(cols: 2) {
    Col(width: .fill, gap: 4) {
      TextEyebrow(text: "House")
      Field(text: house)
    }
    Col(width: .fill, gap: 4) {
      TextEyebrow(text: "Flat")
      Field(text: flat)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .start) { Icon(name: .chevron_left) }
  Thumb(src: p1, shape: .hero)
  Col(align: .center, width: .fill) {
    TextTitle(text: "Delivery Address", width: .fit)
  }
  addressform
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "Select Adress", tone: .primary)
  }
}
