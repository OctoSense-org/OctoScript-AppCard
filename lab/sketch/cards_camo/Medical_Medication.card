# level: L0
# model: camo-app
theme camo_light

state day   { shape: enum[mon, tue, wed, thu, fri, sat, sun], initial: .thu }
state dose1 { shape: text, initial: "2x (20mg)" }
state dose2 { shape: text, initial: "1x (14mg)" }
state dose3 { shape: text, initial: "1x (30mg)" }

view topbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Medication", width: .fit)
  }
  Icon(name: .user)
}

view week Grid(cols: 7) {
  Col(width: .fill, align: .center, gap: 14) {
    TextEyebrow(text: "Mon")
    Chip(text: "03", active: day == .mon, width: .fill)
  }
  Col(width: .fill, align: .center, gap: 14) {
    TextEyebrow(text: "Tue")
    Chip(text: "04", active: day == .tue, width: .fill)
  }
  Col(width: .fill, align: .center, gap: 14) {
    TextEyebrow(text: "Wed")
    Chip(text: "05", active: day == .wed, width: .fill)
  }
  Col(width: .fill, align: .center, gap: 14) {
    TextEyebrow(text: "Thu")
    Chip(text: "06", active: day == .thu, width: .fill)
  }
  Col(width: .fill, align: .center, gap: 14) {
    TextEyebrow(text: "Fri")
    Chip(text: "07", active: day == .fri, width: .fill)
  }
  Col(width: .fill, align: .center, gap: 14) {
    TextEyebrow(text: "Sat")
    Chip(text: "08", active: day == .sat, width: .fill)
  }
  Col(width: .fill, align: .center, gap: 14) {
    TextEyebrow(text: "Sun")
    Chip(text: "09", active: day == .sun, width: .fill)
  }
}

view med1 Panel {
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "AS")
    Col(width: .fill, gap: 40) {
      Row(width: .fill, align: .center, gap: 10) {
        TextRow(text: "Aspirin", width: .fit)
        TextValue(value: dose1)
      }
      Row(width: .fill, align: .center, gap: 10) {
        TextCaption(text: "08:30 AM", width: .fit)
        TextCaption(text: "Before Eating", width: .fit)
      }
    }
  }
}

view med2 Panel {
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "BE")
    Col(width: .fill, gap: 40) {
      Row(width: .fill, align: .center, gap: 10) {
        TextRow(text: "Bepridilo", width: .fit)
        TextValue(value: dose2)
      }
      Row(width: .fill, align: .center, gap: 10) {
        TextCaption(text: "10:00 AM", width: .fit)
        TextCaption(text: "After Eating", width: .fit)
      }
    }
  }
}

view med3 Panel {
  Row(width: .fill, align: .center, gap: 16) {
    Avatar(text: "PA")
    Col(width: .fill, gap: 40) {
      Row(width: .fill, align: .center, gap: 10) {
        TextRow(text: "Paracetamol", width: .fit)
        TextValue(value: dose3)
      }
      Row(width: .fill, align: .center, gap: 10) {
        TextCaption(text: "12:00 AM", width: .fit)
        TextCaption(text: "Before Eating", width: .fit)
      }
    }
  }
}

view meds Col(width: .fill, gap: 26) {
  med1
  med2
  med3
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 36) {
    topbar
    week
    meds
  }
  Space()
  Col(width: .fill, align: .center) {
    Chip(text: "Add New Medicine", tone: .primary, width: .fill)
  }
}
