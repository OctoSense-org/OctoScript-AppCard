# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/5243ac5e4144aa106d6aab1f356bbc013fc9cedc.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/c8b10c444e213559bf61197ae390d8a8a811f80a.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/5da5bf3d01ba671bc646045b4851747f9e8bb24e.png" }

view films Grid(cols: 2) {
  Col(gap: 6) {
    Thumb(src: p2, shape: .square)
    TextCaption(text: "Action • Adventure", width: .fill)
    TextRow(text: "Fast & Furious 8", width: .fill)
  }
  Col(gap: 6) {
    Thumb(src: p3, shape: .square)
    TextCaption(text: "Animation • Action", width: .fill)
    TextRow(text: "Rampage", width: .fill)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
  }
  Thumb(src: p1, shape: .hero)
  Col(align: .center, gap: 6, width: .fill) {
    TextTitle(text: "Dwayne Johnson", width: .fit)
    TextCaption(text: "Actor • Producer • Businessman", width: .fit)
  }
  Row(width: .fill, align: .center) {
    TextTitle(text: "Actor", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  films
}
