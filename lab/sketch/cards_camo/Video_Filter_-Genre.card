# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/_ph_dark.png" }

view genrelist Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☑", width: .fit) TextRow(text: "Action", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Adventure", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Comedy", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Arthouse", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Drama", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☑", width: .fit) TextRow(text: "Musical", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Horror", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Romance", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Fantasy", width: .fill) }
  Row(width: .fill, align: .center, gap: 14) { TextCaption(glyph: "☐", width: .fit) TextRow(text: "Adventure", width: .fill) }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) { TextTitle(text: "Genre", width: .fit) }
  }
  genrelist
  Space()
  Col(align: .center, width: .fill) { Chip(text: "Show Results", tone: .primary, width: .fill) }
}
