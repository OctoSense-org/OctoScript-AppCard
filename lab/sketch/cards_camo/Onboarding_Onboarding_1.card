# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/ad725d8f5c21c57030aac89d6072f9ca4d17da70.png" }

state october_total { shape: text, initial: "$1050.99" }
state card_one_bal  { shape: text, initial: "$1004.00" }
state card_two_bal  { shape: text, initial: "$484.00" }

view preview_header Row(width: .fill, align: .center, gap: 10) {
  Avatar(text: "LN")
  Col(width: .fill, gap: 2) {
    TextCaption(text: "Good Morning")
    TextRow(text: "Hi, Linh Nguyen", width: .fill)
  }
  Icon(name: .more)
}

view preview_spending Card {
  Col(width: .fill, gap: 12) {
    Row(width: .fill, align: .center) {
      Col(width: .fill, gap: 4) {
        TextCaption(text: "October Spending")
        TextValue(value: october_total)
      }
      TextCaption(text: "See all", width: .fit)
    }
    Row(width: .fill, align: .center, gap: 10) {
      Chip(text: "Deposit", width: .fill)
      Chip(text: "Withdraw", width: .fill)
    }
  }
}

view preview_cards Grid(cols: 2) {
  Card {
    Col(width: .fill, gap: 12) {
      Col(width: .fill, align: .center) {
        TextValue(value: card_one_bal)
      }
      Col(width: .fill, gap: 4) {
        TextCaption(text: "Linh Nguyen", width: .fill)
        TextRow(text: "0000 **** **** 9999", width: .fill)
      }
    }
  }
  Card(tint: .violet) {
    Col(width: .fill, gap: 12) {
      Col(width: .fill, align: .center) {
        TextValue(value: card_two_bal)
      }
      Col(width: .fill, gap: 4) {
        TextCaption(text: "Linh Nguyen", width: .fill)
        TextRow(text: "1111 **** **** 8888", width: .fill)
      }
    }
  }
}

view preview_offer Panel {
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p1, shape: .square)
    Col(width: .fill, gap: 6) {
      TextRow(text: "20%-40% Off", width: .fill)
      TextCaption(text: "Flat Discount on Every purchase!", width: .fill)
      Row(gap: 12) {
        TextCaption(text: "Food")
        TextCaption(text: "15 Days")
      }
    }
  }
}

view preview_tabs Panel {
  Grid(cols: 5) {
    Col(align: .center, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Icon(name: .search, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Icon(name: .activity, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Icon(name: .bell, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, gap: 6) {
      Icon(name: .user, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view preview Panel {
  Col(width: .fill, gap: 14) {
    preview_header
    preview_spending
    TextTitle(text: "My Cards", width: .fill)
    preview_cards
    Row(width: .fill, align: .center) {
      TextTitle(text: "Top Offers", width: .fill)
      TextCaption(text: "See all", width: .fit)
    }
    preview_offer
    preview_tabs
  }
}

view sheet Card {
  Col(width: .fill, align: .center, gap: 12) {
    TextTitle(text: "Design Templates are Simple and Easy", width: .fit)
    TextBody(text: "Create a unique emotional story that describes better than words", width: .fit)
    Row(width: .fill, align: .center) {
      TextRow(text: "Skip", width: .fill)
      TextRow(text: "Next", width: .fit)
    }
  }
}

view root Surface(pad: .page) {
  preview
  Space()
  sheet
}
