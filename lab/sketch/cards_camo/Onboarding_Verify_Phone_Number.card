# level: L0
# model: camo-app
theme camo

view root Surface(pad: .page) {
  Space()
  Col(align: .center, gap: 8) {
    TextTitle(text: "Verify Phone Number", width: .fit)
    TextCaption(text: "We have sent code to your number (+84) 999 999 999", width: .fit)
  }
  Col(align: .center, gap: 10) {
    Row(align: .center, gap: 12) {
      Chip(text: "0")
      Chip(text: "9")
      Chip(text: "")
    }
  }
  Space()
  Col(align: .center, width: .fill, gap: 10) {
    Chip(text: "Send code", tone: .primary, width: .fill)
    Chip(text: "Resend code", width: .fill)
  }
}
