# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/c3d350db8fe53ab62734582e96092f99c6c8e0c8.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/e2ec081420d6b59bd493d250d0844c165a6c955b.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/333eee4a8a50f50437a838bb6307395fdfe59dc2.png" }
state cases { shape: text, initial: "44.199.496" }
state tab { shape: enum[cases, vaccines, news], initial: .news }

view topbar Row(width: .fill, align: .center, gap: 8) {
  TextTitle(text: "Covid-19", width: .fill)
  Icon(name: .info)
  TextCaption(text: "Help")
}

view country Panel {
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "US")
    TextRow(text: "United States", width: .fill)
    TextValue(value: cases)
  }
}

view tabs Row(width: .fill, align: .center, gap: 6) {
  Chip(text: "Case", width: .fill, active: tab == .cases)
  Chip(text: "Vaccines", width: .fill, active: tab == .vaccines)
  Chip(text: "News", width: .fill, active: tab == .news)
}

view feature Col(width: .fill, gap: 12) {
  Thumb(src: p1, shape: .hero)
  TextTitle(text: "WHO strengthens COVID-19 response by improving regional vac…", width: .fill)
  TextCaption(text: "7 September 2021")
}

view newslist Col(width: .fill, gap: 18) {
  TextTitle(text: "Latest News", width: .fill)
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p2, shape: .square)
    Col(width: .fill, gap: 8) {
      TextRow(text: "WHO’s work towards vaccine equity continues in Africa and…", width: .fill)
      TextCaption(text: "30 September 2021")
    }
  }
  Row(width: .fill, align: .center, gap: 12) {
    Thumb(src: p3, shape: .square)
    Col(width: .fill, gap: 8) {
      TextRow(text: "The occupied Palestinian territory reforms its hospital se…", width: .fill)
      TextCaption(text: "30 September 2021")
    }
  }
}

view tabbar Panel {
  Row(width: .fill, align: .center, gap: 0) {
    Col(align: .center, width: .fill, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, width: .fill, gap: 6) {
      Icon(name: .search, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, width: .fill, gap: 6) {
      Icon(name: .activity, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, width: .fill, gap: 6) {
      Icon(name: .bell, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(align: .center, width: .fill, gap: 6) {
      Icon(name: .user, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 18) {
    topbar
    country
    tabs
    feature
    newslist
    tabbar
  }
}
