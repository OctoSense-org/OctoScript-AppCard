# level: L0
# model: camo-app
theme camo

view tile1 Col(width: .fill, gap: 10) {
  Card(tint: .amber) {
    Col(width: .fill, gap: 48) {
      TextTitle(text: "Best Dance Songs 2021", width: .fill)
      Row(width: .fill) {
        TextCaption(text: "CaMo", width: .fill)
        Icon(name: .play, size: .row)
      }
    }
  }
  TextRow(text: "Dance", width: .fill)
  TextCaption(text: "134 Songs", width: .fill)
}

view tile2 Col(width: .fill, gap: 10) {
  Card(tint: .green) {
    Col(width: .fill, gap: 48) {
      TextTitle(text: "Songs We Relaxed", width: .fill)
      Row(width: .fill) {
        TextCaption(text: "CaMo", width: .fill)
        Icon(name: .play, size: .row)
      }
    }
  }
  TextRow(text: "Relaxation", width: .fill)
  TextCaption(text: "213 Songs", width: .fill)
}

view tile3 Col(width: .fill, gap: 10) {
  Card(tint: .violet) {
    Col(width: .fill, gap: 48) {
      TextTitle(text: "Best Hip-Hop Songs 2021", width: .fill)
      Row(width: .fill) {
        TextCaption(text: "CaMo", width: .fill)
        Icon(name: .play, size: .row)
      }
    }
  }
  TextRow(text: "Hip-Hop", width: .fill)
  TextCaption(text: "48 Songs", width: .fill)
}

view tile4 Col(width: .fill, gap: 10) {
  Card(tint: .red) {
    Col(width: .fill, gap: 48) {
      TextTitle(text: "Best R&B Songs 2021", width: .fill)
      Row(width: .fill) {
        TextCaption(text: "CaMo", width: .fill)
        Icon(name: .play, size: .row)
      }
    }
  }
  TextRow(text: "R&B", width: .fill)
  TextCaption(text: "442 Songs", width: .fill)
}

view tile5 Col(width: .fill, gap: 10) {
  Card(tint: .green) {
    Col(width: .fill, gap: 48) {
      TextTitle(text: "Stay Home Stay Safe", width: .fill)
      Row(width: .fill) {
        TextCaption(text: "CaMo", width: .fill)
        Icon(name: .play, size: .row)
      }
    }
  }
  TextRow(text: "Stay Home", width: .fill)
  TextCaption(text: "48 Songs", width: .fill)
}

view tile6 Col(width: .fill, gap: 10) {
  Card(tint: .blue) {
    Col(width: .fill, align: .center, gap: 48) {
      Icon(name: .plus, size: .hero)
      Space()
    }
  }
}

view playlistgrid Grid(cols: 2) {
  tile1
  tile2
  tile3
  tile4
  tile5
  tile6
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Playlists", width: .fit)
    }
    Icon(name: .more)
  }
  playlistgrid
}
