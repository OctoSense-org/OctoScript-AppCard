# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/44676d5d91db51079b18bd536c9c19e63f23a504.png" }

view browse Col(width: .fill, gap: 20) {
  Row(width: .fill, align: .center, gap: 14) {
    Icon(name: .bookmark)
    TextRow(text: "Playlists", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 14) {
    Icon(name: .user)
    TextRow(text: "Artists", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 14) {
    Icon(name: .image)
    TextRow(text: "Albums", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 14) {
    Icon(name: .play)
    TextRow(text: "Songs", width: .fill)
  }
  Row(width: .fill, align: .center, gap: 14) {
    Icon(name: .menu)
    TextRow(text: "Collections", width: .fill)
  }
}

view recent Col(width: .fill, gap: 16) {
  Row(width: .fill, align: .center, gap: 14) {
    Thumb(src: p1)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Stay", width: .fill)
      TextCaption(text: "The Kid LAROI, Justin Bieber", width: .fill)
    }
    Icon(name: .more)
  }
  Row(width: .fill, align: .center, gap: 14) {
    Thumb(src: p1)
    Col(width: .fill, gap: 4) {
      TextRow(text: "Industry Baby", width: .fill)
      TextCaption(text: "Lil Nas X & Jack Harlow", width: .fill)
    }
    Icon(name: .more)
  }
}

view tabbar Panel {
  Row(width: .fill, align: .center) {
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 6) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Library", width: .fill)
    Icon(name: .more)
  }
  browse
  Row(width: .fill, align: .center) {
    TextTitle(text: "Recently Added", width: .fill)
    TextCaption(text: "See all", width: .fit)
  }
  recent
  Space()
  tabbar
}
