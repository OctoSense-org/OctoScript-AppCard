# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/cc79b3df763c3bb43552231fd1b02049bdce86de.png" }

view profile Col(width: .fill, gap: 14) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Profile", width: .fill)
    TextCaption(text: "Edit", width: .fit)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Avatar(text: "LN")
    Col(width: .fill, gap: 2) {
      TextRow(text: "Linh Nguyen", width: .fill)
      TextCaption(text: "Founder at CaDesign", width: .fill)
    }
    Icon(name: .chevron_right)
  }
}

view general Col(width: .fill, gap: 16) {
  TextTitle(text: "General", width: .fill)
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .zap)
    TextRow(text: "Evgenily", width: .fill)
    TextCaption(text: "999 999 999", width: .fit)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .bookmark)
    TextRow(text: "Preferences", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .location)
    TextRow(text: "City", width: .fill)
    TextCaption(text: "Hanoi, VN", width: .fit)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .map)
    TextRow(text: "Address", width: .fill)
    Icon(name: .chevron_right)
  }
  Row(width: .fill, align: .center, gap: 12) {
    Icon(name: .chat)
    TextRow(text: "Chat", width: .fill)
    Icon(name: .chevron_right)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "More", width: .fill)
    Icon(name: .more)
  }
  profile
  general
  TabBar {
    Tab(icon: .home, label: "Item")
    Tab(icon: .search, label: "Item")
    Tab(icon: .heart, label: "Item")
    Tab(icon: .bell, label: "Item")
    Tab(icon: .user, label: "Item", active: .on)
  }
}
