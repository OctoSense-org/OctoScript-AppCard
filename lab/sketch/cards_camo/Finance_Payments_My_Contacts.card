# level: L0
# model: camo-app

theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/5446c50b566e1093416e2e14d3327d4c61db15e4.png" }
state q1 { shape: text, initial: "Search for Name…" }

view appbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "My Contacts", width: .fit)
  }
}

