# level: L0
# model: camo-app

theme camo_light

state tab { shape: enum[first, second, third], initial: .third }

state carb_total   { shape: text, initial: "70%" }
state carb_aim     { shape: text, initial: "44%" }
state india_total  { shape: text, initial: "60%" }
state india_aim    { shape: text, initial: "32%" }
state brazil_total { shape: text, initial: "80%" }
state brazil_aim   { shape: text, initial: "20%" }

view topbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Calories", width: .fit)
  }
  Icon(name: .more)
}

view tabs Panel {
  Row(width: .fill, align: .center, gap: 8) {
    Chip(text: "Normal", active: tab == .first, width: .fill)
    Chip(text: "Normal", active: tab == .second, width: .fill)
    Chip(text: "Active", active: tab == .third, width: .fill)
  }
}

view ring Card {
  Col(width: .fill, align: .center, gap: 150) {
    Space()
    Icon(name: .activity, size: .hero)
    Space()
  }
}

view legend Panel {
  Col(width: .fill, gap: 24) {
    Row(width: .fill, align: .center, gap: 16) {
      TextCaption(text: "Infomation", width: .fill)
      TextCaption(text: "Total", width: .fit)
      TextCaption(text: "Aim", width: .fit)
    }
    Rule()
    Row(width: .fill, align: .center, gap: 16) {
      TextCaption(glyph: "●", width: .fit)
      TextRow(text: "Carbohydrates", width: .fill)
      TextValue(value: carb_total)
      TextValue(value: carb_aim)
    }
    Row(width: .fill, align: .center, gap: 16) {
      TextCaption(glyph: "●", width: .fit)
      TextRow(text: "India", width: .fill)
      TextValue(value: india_total)
      TextValue(value: india_aim)
    }
    Row(width: .fill, align: .center, gap: 16) {
      TextCaption(glyph: "●", width: .fit)
      TextRow(text: "Brazil", width: .fill)
      TextValue(value: brazil_total)
      TextValue(value: brazil_aim)
    }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 16) {
    topbar
    tabs
    ring
    legend
  }
}
