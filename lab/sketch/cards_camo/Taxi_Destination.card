# level: L0
# model: camo-app
theme camo_light

state p1 { shape: text, initial: "http://127.0.0.1:8787/c06798a2f89299479b974443b62d5171ff231060.png" }

view destcard Panel {
  Row(width: .fill, align: .center, gap: 10) {
    Icon(name: .location)
    TextRow(text: "Hai Ba Trung, Ha Noi, Viet Nam", width: .fill)
  }
  Rule()
  Row(width: .fill, align: .center, gap: 10) {
    Icon(name: .location)
    TextRow(text: "43 Hang Bai", width: .fill)
    Icon(name: .plus)
  }
}

view suggestions Col(width: .fill, gap: 8) {
  TextEyebrow(text: "SUGGESTIONS FOR YOU")
  Row(width: .fill, align: .center, gap: 10) {
    Icon(name: .location)
    Col(width: .fill, gap: 2) {
      TextRow(text: "43 Hang Bai", width: .fill)
      TextCaption(text: "43 Hang Bai, Hoan Kiem, HN", width: .fill)
    }
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) { TextTitle(text: "Destination", width: .fit) }
    Icon(name: .location)
  }
  destcard
  Thumb(src: p1, shape: .hero)
  suggestions
}
