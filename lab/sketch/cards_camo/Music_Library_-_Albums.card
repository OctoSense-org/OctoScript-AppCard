# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/44676d5d91db51079b18bd536c9c19e63f23a504.png" }

view header Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Albums", width: .fit)
  }
  Icon(name: .more)
}

view albums Grid(cols: 2) {
  Col(gap: 8) {
    Thumb(src: p1, shape: .square)
    Row(width: .fill, align: .center) {
      Col(width: .fill) {
        TextRow(text: "Happier Than Ever", width: .fill)
        TextCaption(text: "Billie Eilish", width: .fill)
      }
      Icon(name: .play)
    }
  }
  Col(gap: 8) {
    Thumb(src: p1, shape: .square)
    Row(width: .fill, align: .center) {
      Col(width: .fill) {
        TextRow(text: "Montero", width: .fill)
        TextCaption(text: "Lil Nas X", width: .fill)
      }
      Icon(name: .play)
    }
  }
  Col(gap: 8) {
    Thumb(src: p1, shape: .square)
    Row(width: .fill, align: .center) {
      Col(width: .fill) {
        TextRow(text: "Justice", width: .fill)
        TextCaption(text: "2021 • Album", width: .fill)
      }
      Icon(name: .play)
