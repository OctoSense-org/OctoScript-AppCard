# level: L0
# model: camo-app
theme camo_light

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    TextTitle(text: "Doctors", width: .fill)
    Icon(name: .menu)
  }
  Grid(cols: 2) {
    Panel {
      Col(gap: 6) {
        Icon(name: .cloud, size: .tile)
        TextRow(text: "Allergist", width: .fill)
        TextCaption(text: "+32 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .star, size: .tile)
        TextRow(text: "Dentist", width: .fill)
        TextCaption(text: "+22 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .zap, size: .tile)
        TextRow(text: "Dermatologist", width: .fill)
        TextCaption(text: "+532 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .alert, size: .tile)
        TextRow(text: "Epidemiologist", width: .fill)
        TextCaption(text: "+2423 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .activity, size: .tile)
        TextRow(text: "Neurologist", width: .fill)
        TextCaption(text: "+123 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .heart, size: .tile)
        TextRow(text: "Oncologist", width: .fill)
        TextCaption(text: "+879 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .user, size: .tile)
        TextRow(text: "Pediatrician", width: .fill)
        TextCaption(text: "+675 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .users, size: .tile)
        TextRow(text: "Therpapist", width: .fill)
        TextCaption(text: "+135 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .user, size: .tile)
        TextRow(text: "Pediatrician", width: .fill)
        TextCaption(text: "+675 Doctors", width: .fill)
      }
    }
    Panel {
      Col(gap: 6) {
        Icon(name: .users, size: .tile)
        TextRow(text: "Therpapist", width: .fill)
        TextCaption(text: "+135 Doctors", width: .fill)
      }
    }
  }
  TabBar {
    Tab(icon: .home, label: "Item", active: .on)
    Tab(icon: .search, label: "Item")
    Tab(icon: .calendar, label: "Item")
    Tab(icon: .chat, label: "Item")
    Tab(icon: .user, label: "Item")
  }
}
