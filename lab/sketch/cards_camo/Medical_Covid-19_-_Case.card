# level: L0
# model: camo-app

theme camo_light

state tab             { shape: enum[cases, vaccines, latest], initial: .cases }
state us_cases        { shape: text,   initial: "44.199.496" }
state total_cases     { shape: text,   initial: "44.199.496" }
state actives         { shape: text,   initial: "123.276" }
state actives_delta   { shape: number, initial: 123276 }
state deaths          { shape: text,   initial: "713.950" }
state deaths_delta    { shape: number, initial: -713950 }
state recovered       { shape: text,   initial: "33.634.702" }
state recovered_delta { shape: number, initial: 33634702 }

view header Row(width: .fill, align: .center, gap: 10) {
  TextTitle(text: "Covid-19", width: .fill)
  Icon(name: .info)
  TextCaption(text: "Help", width: .fit)
  TextCaption(glyph: "⤢", width: .fit)
}

view country Panel {
  Row(width: .fill, align: .center, gap: 10) {
    Avatar(text: "US")
    Icon(name: .chevron_down, size: .tile)
    TextRow(text: "United States", width: .fill)
    TextValue(value: us_cases)
  }
}

view mapcard Card(tint: .blue) {
  Grid(cols: 3) {
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .map, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
    Icon(name: .location, size: .hero)
  }
}

view tabs Col(width: .fill, gap: 10) {
  Row(width: .fill, align: .center, gap: 10) {
    Chip(text: "Case", active: tab == .cases, width: .fill)
    Chip(text: "Vaccines", active: tab == .vaccines, width: .fill)
    Chip(text: "New", active: tab == .latest, width: .fill)
  }
  Rule()
}

view stats Grid(cols: 3) {
  Col(width: .fill, gap: 10) {
    TextCaption(text: "Actives", width: .fit)
    TextStat(value: actives, tint: actives_delta)
  }
  Col(width: .fill, gap: 10) {
    TextCaption(text: "Deaths", width: .fit)
    TextStat(value: deaths, tint: deaths_delta)
  }
  Col(width: .fill, gap: 10) {
    TextCaption(text: "Recovered", width: .fit)
    TextStat(value: recovered, tint: recovered_delta)
  }
}

view tabbar Panel {
  Grid(cols: 5) {
    Col(align: .center, gap: 6) { Icon(name: .home) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 6) { Icon(name: .activity) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 6) { Icon(name: .search) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 6) { Icon(name: .bell) TextCaption(text: "Item", width: .fit) }
    Col(align: .center, gap: 6) { Icon(name: .user) TextCaption(text: "Item", width: .fit) }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 24) {
    header
    country
    mapcard
    tabs
    TextHero(text: "Total Cases", value: total_cases, unit: "+123.276")
    stats
    tabbar
  }
}
