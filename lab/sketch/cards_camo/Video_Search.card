# level: L0
# model: camo-app

theme camo

state search_hint { shape: text, initial: "Search for Films,TV Show…" }
state seg_active  { shape: bool, initial: true }

view searchbar Col(width: .fill, gap: 14) {
  Field(placeholder: search_hint, width: .fill)
  Row(width: .fill, gap: 8) {
    Chip(text: "Normal", width: .fill)
    Chip(text: "Active", active: seg_active, width: .fill)
  }
}

view genres Col(width: .fill, gap: 8) {
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .zap)
      Col(width: .fill, gap: 2) {
        TextRow(text: "Action", width: .fill)
        TextCaption(text: "100 Films", width: .fill)
      }
    }
  }
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .heart)
      Col(width: .fill, gap: 2) {
        TextRow(text: "Drama", width: .fill)
        TextCaption(text: "12 Films", width: .fill)
      }
    }
  }
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .star)
      Col(width: .fill, gap: 2) {
        TextRow(text: "Fantasy", width: .fill)
        TextCaption(text: "54 Films", width: .fill)
      }
    }
  }
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .map)
      Col(width: .fill, gap: 2) {
        TextRow(text: "Adventure", width: .fill)
        TextCaption(text: "146 Films", width: .fill)
      }
    }
  }
  Panel {
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .moon)
      Col(width: .fill, gap: 2) {
        TextRow(text: "Horror", width: .fill)
        TextCaption(text: "82 Films", width: .fill)
      }
    }
  }
}

view tabbar Panel {
  Row(width: .fill, align: .center) {
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .home, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .search, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .video, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .bookmark, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .user, size: .tile)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 16) {
    TextTitle(text: "Search", width: .fill)
    searchbar
    genres
  }
  Space()
  tabbar
}
