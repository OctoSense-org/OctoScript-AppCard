# level: L0
# model: camo-app
theme camo

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
  }
  Row(width: .fill, align: .center) {
    TextTitle(text: "Filter", width: .fill)
    TextCaption(text: "Reset", width: .fit)
  }
  Col(width: .fill, gap: 16) {
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .video)
      TextRow(text: "Genre", width: .fill)
    }
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .location)
      TextRow(text: "Country", width: .fill)
    }
    Row(width: .fill, align: .center, gap: 12) {
      Icon(name: .calendar)
      TextRow(text: "Year", width: .fill)
    }
  }
}
