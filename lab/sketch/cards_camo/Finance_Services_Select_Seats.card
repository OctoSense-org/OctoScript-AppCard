# level: L0
# model: camo-app
theme camo

view appbar Row(width: .fill, align: .center) {
  Icon(name: .chevron_left)
  Col(width: .fill, align: .center) {
    TextTitle(text: "Select Seats", width: .fit)
  }
}

view dates Row(width: .fill, gap: 8) {
  Chip(text: "Tue, 28 Sep", active: .on)
  Chip(text: "Wed, 29 Sep")
  Chip(text: "Thu, 30 Sep")
}

view times Col(width: .fill, gap: 6) {
  Row(width: .fill, align: .center, gap: 6) {
    TextCaption(text: "17:00", width: .fill)
    TextCaption(text: "18:30", width: .fill)
    Chip(text: "19:30", active: .on)
    TextCaption(text: "20:00", width: .fill)
    TextCaption(text: "21:00", width: .fit)
  }
  Rule()
}

view seats Grid(cols: 8) {
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "●", active: .on)
  Chip(text: "●", active: .on)
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "●")
  Chip(text: "●")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
