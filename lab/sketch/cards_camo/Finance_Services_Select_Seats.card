  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
  Chip(text: "○")
}

view legend Row(width: .fill, align: .center, gap: 14) {
  TextCaption(text: "Available", glyph: "○", width: .fit)
  TextCaption(text: "Reserved", glyph: "●", width: .fit)
  TextCaption(text: "Selected", glyph: "◼", width: .fit)
}

view buybar Row(width: .fill, align: .center) {
  Col(width: .fill, gap: 2) {
    TextCaption(text: "2 Seats", width: .fit)
    TextTitle(text: "$75.09", width: .fit)
  }
  Chip(text: "Buy Now", tone: .primary)
}

view root Surface(pad: .page) {
  appbar
  dates
  times
  seats
  legend
  Space()
  buybar
}
