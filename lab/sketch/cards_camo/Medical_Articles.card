# level: L0
# model: camo-app
theme camo_light

state cat { shape: text, initial: "Health & Life" }
state p1 { shape: text, initial: "http://127.0.0.1:8787/c3d350db8fe53ab62734582e96092f99c6c8e0c8.png" }
state p2 { shape: text, initial: "http://127.0.0.1:8787/e2ec081420d6b59bd493d250d0844c165a6c955b.png" }
state p3 { shape: text, initial: "http://127.0.0.1:8787/333eee4a8a50f50437a838bb6307395fdfe59dc2.png" }

view latest Col(width: .fill, gap: 16) {
  Row(width: .fill, align: .center, gap: 14) {
    Thumb(src: p2, shape: .square)
    Col(width: .fill, gap: 8) {
      TextRow(text: "WHO’s work towards vaccine equity continues in Africa and…", width: .fill)
      TextCaption(text: "30 September 2021", width: .fill)
    }
  }
  Row(width: .fill, align: .center, gap: 14) {
    Thumb(src: p3, shape: .square)
    Col(width: .fill, gap: 8) {
      TextRow(text: "The occupied Palestinian territory reforms its hospital se…", width: .fill)
      TextCaption(text: "30 September 2021", width: .fill)
    }
  }
}

view tabbar Panel {
  Row(width: .fill, align: .center) {
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .home)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .search)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .bookmark)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .bell)
      TextCaption(text: "Item", width: .fit)
    }
    Col(width: .fill, align: .center, gap: 4) {
      Icon(name: .user)
      TextCaption(text: "Item", width: .fit)
    }
  }
}

view root Surface(pad: .page) {
  Col(width: .fill, gap: 16) {
    Row(width: .fill, align: .center) {
      TextTitle(text: "Articles", width: .fill)
      Icon(name: .menu)
    }
    Row(width: .fill, align: .center) {
      TextTitle(text: "Category", width: .fill)
      TextCaption(text: "See all", width: .fit)
    }
    Row(width: .fill, gap: 10) {
      Chip(text: "Covid-19", active: cat == "Covid-19")
      Chip(text: "Health & Life", active: cat == "Health & Life")
      Chip(text: "Dentist", active: cat == "Dentist")
    }
    Thumb(src: p1, shape: .hero)
    Col(width: .fill, gap: 10) {
      TextTitle(text: "WHO strengthens COVID-19 response by improving regional vac…", width: .fill)
      TextCaption(text: "7 September 2021", width: .fill)
    }
    TextTitle(text: "Latest News", width: .fill)
    latest
  }
  Space()
  tabbar
}
