# level: L0
# model: camo-app
theme camo

state p1 { shape: text, initial: "http://127.0.0.1:8787/8bfd21bf5261f228145093483a5a654bad0f491e.png" }
state amount_v { shape: text, initial: "$404.00" }
state card_no { shape: text, initial: "0000 **** **** 9999" }

view card Panel {
  Col(align: .center, gap: 8, width: .fill) {
    Thumb(src: p1, shape: .square)
    TextTitle(text: "Bank of America", width: .fit)
    TextEyebrow(text: "Score CaMo Bank")
    TextValue(value: card_no)
  }
}

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Transfer", width: .fit)
    }
    Space()
  }
  Col(align: .center, gap: 6, width: .fill) {
    TextEyebrow(text: "Score CaMo Bank")
    TextHero(value: amount_v)
  }
  card
  Col(align: .center, gap: 8, width: .fill) {
    Icon(name: .plus, size: .hero)
    TextCaption(text: "Submit a Receipt", width: .fit)
  }
  Space()
  Col(align: .center, width: .fill) {
    Chip(text: "Done", tone: .primary)
  }
}
