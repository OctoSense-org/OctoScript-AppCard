# level: L0
# model: camo-app
theme camo_light

state q { shape: text, initial: "Search for Questions" }

view root Surface(pad: .page) {
  Row(width: .fill, align: .center) {
    Icon(name: .chevron_left)
    Col(width: .fill, align: .center) {
      TextTitle(text: "Help Center", width: .fit)
    }
    Space()
  }
  Field(placeholder: q)
  Row(width: .fill, align: .center) {
    TextTitle(text: "Topics", width: .fill)
    TextCaption(text: "View all", width: .fit)
  }
  Panel {
    Col(gap: 6) {
      TextRow(text: "How to add a new card to CaMo?", width: .fill)
      TextCaption(text: "You can add payment methods including credit and debit cards, PayPal, ...", width: .fill)
    }
  }
  Panel {
    Col(gap: 6) {
      TextRow(text: "How do I create a trip?", width: .fill)
      TextCaption(text: "If your trip was booked directly with an airline, hotel or another travel site, you may also forward...", width: .fill)
    }
  }
  Panel {
    Col(gap: 6) {
      TextRow(text: "Canceling a ride", width: .fill)
      TextCaption(text: "Canceling a trip · 1. Tap the menu icon in the bottom right corner · 2. Tap the three dot icon...", width: .fill)
    }
  }
  Panel {
    Col(gap: 6) {
      TextRow(text: "I left my phone in a vehicle", width: .fill)
      TextCaption(text: "If you left your phone in a vehicle and can't sign in to your account, fill out the form below to let us k...", width: .fill)
    }
  }
}
