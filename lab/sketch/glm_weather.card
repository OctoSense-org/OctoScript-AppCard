# level: L0
# model: weather-app
theme camo

source place sys.geocode(name: "上海")
source now sys.weather(lat: place.lat, lon: place.lon, fields: [temp, feels, hi, lo, cond, humidity, wind, uv])
source week sys.weather(lat: place.lat, lon: place.lon, days: 7, fields: [dayname, cond, hi, lo])

view root Surface(pad: .page) {
  Col(gap: 20, width: .fill) {

    Col(align: .center, gap: 2) {
      TextTitle(text: "上海")
      TextHero(value: now.temp, unit: "°")
      Row(gap: 8, align: .center) {
        WeatherIcon(cond: now.cond, size: .row)
        TextBody(text: now.cond)
      }
      Row(gap: 14, align: .center) {
        TextCaption(text: "最高", value: now.hi, suffix: "°")
        TextCaption(text: "最低", value: now.lo, suffix: "°")
        TextCaption(text: "体感", value: now.feels, suffix: "°")
      }
    }

    Panel {
      Col(gap: 12) {
        TextEyebrow(text: "每日预报")
        for d, i in week.days key d.dayname {
          Row(gap: 12) {
            TextRow(text: d.dayname, width: 64)
            WeatherIcon(cond: d.cond, size: .row)
            Space()
            TextRow(text: d.lo, width: 44)
            TextRow(text: d.hi, width: 44)
          }
        }
      }
    }

    Grid(cols: 3) {
      Tile(label: "紫外线", value: now.uv, glyph: .uv, shape: .card)
      Tile(label: "湿度", value: now.humidity, unit: "%", glyph: .humidity, shape: .card)
      Tile(label: "风速", value: now.wind, unit: "km/h", glyph: .wind, shape: .card)
    }
  }
}
