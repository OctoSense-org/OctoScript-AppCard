# level: L0
# model: weather-app
theme atro

source place sys.geocode(name: "上海")
source now sys.weather(lat: place.lat, lon: place.lon,
                       fields: [temp, feels, hi, lo, cond, humidity, wind, uv])
source week sys.weather(lat: place.lat, lon: place.lon, days: 7,
                        fields: [dayname, cond, hi, lo])

view root Surface(pad: .page) {
  Col(width: .fill, gap: 16) {

    // 当前天气
    Col(width: .fill, align: .center, gap: 4) {
      TextTitle(text: "上海")
      Row(align: .center, gap: 8) {
        WeatherIcon(cond: now.cond, size: .hero)
        TextBody(text: now.cond)
      }
      TextHero(value: now.temp, unit: "°")
      Row(align: .center, gap: 16) {
        TextCaption(text: "最高", value: now.hi, suffix: "°")
        TextCaption(text: "最低", value: now.lo, suffix: "°")
      }
    }

    // 7 天预报
    Card {
      Col(width: .fill, gap: 10) {
        TextEyebrow(text: "7 天预报")
        for d, i in week.days key d.dayname {
          Row(width: .fill, align: .center, gap: 12) {
            TextRow(text: d.dayname, width: 64)
            WeatherIcon(cond: d.cond, size: .row)
            Space()
            TextValue(value: d.lo, unit: "°")
            TextValue(value: d.hi, unit: "°")
          }
        }
      }
    }

    // 卫星云图
    Card {
      Col(width: .fill, gap: 8) {
        TextEyebrow(text: "卫星云图")
        Row(align: .center, gap: 8) {
          Icon(name: .cloud, size: .row)
          TextBody(text: "实时云层影像")
        }
      }
    }

    // 空气质量图
    Card {
      Col(width: .fill, gap: 8) {
        TextEyebrow(text: "空气质量图")
        Row(align: .center, gap: 8) {
          Icon(name: .map, size: .row)
          TextBody(text: "实时空气质量分布")
        }
      }
    }

    // 详情四宫格
    Grid(cols: 2) {
      Tile(label: "体感温度", value: now.feels, unit: "°", glyph: .thermometer, shape: .card)
      Tile(label: "紫外线", value: now.uv, glyph: .sun, shape: .card)
      Tile(label: "湿度", value: now.humidity, unit: "%", glyph: .droplet, shape: .card)
      Tile(label: "风速", value: now.wind, unit: "km/h", glyph: .wind, shape: .card)
    }
  }
}
