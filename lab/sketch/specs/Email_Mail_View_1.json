in interface design, in an environment commonly referred to as a Graphical User Interface (GUI). This has included web design and software design, when end user interactivity is a design consideration of the layout or interface. Combining visual communication skills with an understanding of user interaction and online branding, graphic designers often work with software developers and web developers to create the look and feel of a web site or software application. An important aspect of interface design is icon design.", "run": {"font": "Montserrat-Regular", "size": 20, "c": {"hex": "#6c7b8a", "a": 1}, "align": 0}}}]}, {"cls": "text", "name": "\u270f\ufe0ftitle", "x": 69.1, "y": 456.0, "w": 526.7, "h": 20.0, "text": {"string": "Interface design", "run": {"font": "Montserrat-Medium", "size": 20, "c": {"hex": "#6c7b8a", "a": 1}, "align": 0}}}, {"cls": "text", "name": "\u270f\ufe0fname", "x": 69.1, "y": 410.0, "w": 182.2, "h": 30.0, "text": {"string": "Mollie Stevenson", "run": {"font": "Montserrat-SemiBold", "size": 25, "c": {"hex": "#140f26", "a": 1}, "align": 0}}}, {"cls": "symbolInstance", "name": "Badge/Bullet/Red", "x": 24.0, "y": 414.0, "w": 20.0, "h": 20.0, "children": [{"cls": "rectangle", "name": "\u2b06\ufe0f Elevation", "x": 27.0, "y": 417.0, "w": 14.0, "h": 14.0, "radius": 100.0}, {"cls": "rectangle", "name": "\ud83c\udfa8background", "x": 27.0, "y": 417.0, "w": 14.0, "h": 14.0, "gradient": {"type": 0, "from": [0.1254964983842246, -0.8648106308217365], "to": [0.7177598495644393, 1.2678018380710654], "stops": [{"c": {"hex": "#2dc9eb", "a": 1}, "p": 0}, {"c": {"hex": "#14d2b8", "a": 1}, "p": 1}]}, "radius": 100.0}]}]}, {"cls": "symbolInstance", "name": "Content/List-Message", "x": -1, "y": 572, "w": 751, "h": 190, "children": [{"cls": "rectangle", "name": "\ud83c\udfa8background", "x": -1.0, "y": 572.0, "w": 751.0, "h": 190.0}, {"cls": "symbolInstance", "name": "Misc/\ud83d\udccfDivider/Dark", "x": -1.0, "y": 760.0, "w": 751.0, "h": 2.0, "children": [{"cls"