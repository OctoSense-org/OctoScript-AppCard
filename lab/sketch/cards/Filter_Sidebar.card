# level: L0
# model: atro-translation
# source-artboard: ⟶ [Filter] Sidebar

theme dark

view root Surface(pad: .page) {
    TextCaption(text: "refine search")
    TextCaption(text: "Staff picks")
    TextCaption(text: "New items")
  TextCaption(text: "Rating")
      TextCaption(text: "5 star")
      TextCaption(text: "4 star")
    Row(gap: 8, align: .center) {
      TextCaption(text: "Price")
      TextCaption(text: "$230 - $520")
    }
  TextCaption(text: "Type")
      TextCaption(text: "Illustration")
      TextCaption(text: "Image")
    Row(gap: 8, align: .center) {
      TextCaption(text: "Width (px)")
      TextEyebrow(text: "3840 PX")
    }
    Row(gap: 8, align: .center) {
      TextCaption(text: "Height (px)")
      TextEyebrow(text: "2160 PX")
    }
  Panel {
    TextCaption(text: "Show results")
  }
}
