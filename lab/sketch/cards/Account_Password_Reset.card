# level: L0
# model: atro-translation
# source-artboard: ⟶ [Account] Password Reset

theme dark

view root Surface(pad: .page) {
    TextBody(text: "Forgot password")
  Panel {
    TextBody(text: "alan@gmail.com")
  }
  TextCaption(text: "OR")
  Panel {
    TextBody(text: "Enter your phone number")
  }
  Panel {
    TextBody(text: "Reset password")
  }
  TextBody(text: "Enter your email address or phone number to reset the password.", width: .fill)
}
