# level: L0
# model: atro-translation
# source-artboard: ⟶ [Account] Success Overlay

theme dark

view root Surface(pad: .page) {
    Row(gap: 8, align: .center) {
      Panel {
        TextTitle(text: "Your password has been reset", width: .fill)
        TextBody(text: "You will shortly receive an email with a link to a web page where you will be able to set up a new password for your account.", width: .fill)
        Panel {
          TextBody(text: "Close")
        }
      }
    }
}
