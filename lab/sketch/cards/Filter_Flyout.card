theme dark

view root Surface(pad: .page) {
  Panel {
      TextCaption(text: "filter content by:")
    TextCaption(text: "Licence")
        TextCaption(text: "Creative")
        TextCaption(text: "Editorial")
      Row(gap: 8, align: .center) {
        TextCaption(text: "Size")
        TextCaption(text: "3mb - 50mb")
      }
      TextCaption(text: "Best match")
      TextCaption(text: "Newest")
      TextCaption(text: "Staff picks")
    Panel {
      TextCaption(text: "Show results")
    }
  }
}
