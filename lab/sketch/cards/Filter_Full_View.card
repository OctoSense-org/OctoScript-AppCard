# level: L0
# model: atro-translation
# source-artboard: ⟶ [Filter] Full View 

theme dark

view root Surface(pad: .page) {
    Row(gap: 8, align: .center) {
      TextBody(text: "products")
      TextBody(text: "Clear")
    }
    TextCaption(text: "Sort by")
    TextCaption(text: "Best match")
    TextCaption(text: "Newest")
    TextCaption(text: "Rating")
      TextCaption(text: "5 star")
    TextCaption(text: "filter by")
    TextCaption(text: "Licence")
      TextCaption(text: "Creative")
      TextCaption(text: "Editorial")
    TextCaption(text: "Height (px)")
      TextCaption(text: "600")
    TextCaption(text: "Width (px)")
      TextCaption(text: "800")
    TextCaption(text: "Display black and white images", width: .fill)
  Panel {
    TextBody(text: "show results", width: .fill)
  }
}
