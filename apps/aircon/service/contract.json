{
  "schema_version": 1,
  "id": "aircon-service-cards",
  "locale": "zh-CN",
  "simulation": true,
  "controller": {
    "module": "controller.py",
    "api": [
      "initial_state(fixture?)",
      "reduce(state,event)",
      "view_model(state)",
      "demo_states()"
    ],
    "event": {
      "id": "unique string; duplicate exact event is no-op; same id different content is rejected",
      "action": "actions[].id",
      "actor": "user|provider; locally validated, not authentication",
      "payload": "action-specific object"
    },
    "persistence": "caller serializes each instance; CLI uses atomic file replacement"
  },
  "ownership": {
    "shopping": [
      "order"
    ],
    "logistics": [
      "delivery"
    ],
    "installation": [
      "booking",
      "technician",
      "installation_progress"
    ],
    "calendar": [
      "calendar_events",
      "calendar_acknowledgement"
    ],
    "payment": [
      "invoice",
      "receipt"
    ]
  },
  "actions": [
    {
      "id": "calendar.acknowledge",
      "actor": "user",
      "reads": [
        "calendar.installation_event"
      ],
      "writes": [
        "calendar.acknowledged"
      ],
      "description": "确认已看到更新，不重复创建日程",
      "payload": {}
    },
    {
      "id": "calendar.restore",
      "actor": "user",
      "reads": [
        "installation"
      ],
      "writes": [
        "calendar.installation_event",
        "calendar.installation_sync"
      ],
      "description": "使用稳定事件 id 恢复日程，不重新预约",
      "payload": {}
    },
    {
      "id": "calendar.undo",
      "actor": "user",
      "reads": [
        "calendar.installation_event"
      ],
      "writes": [
        "calendar.installation_event",
        "calendar.installation_sync"
      ],
      "description": "只撤销安装日程，预约继续有效",
      "payload": {}
    },
    {
      "id": "card.dismiss",
      "actor": "user",
      "reads": [
        "visible_cards"
      ],
      "writes": [
        "ui.dismissed_cards"
      ],
      "description": "收起卡片，不取消任何服务",
      "payload": {
        "card_id": "visible stable owner:entity id"
      }
    },
    {
      "id": "installation.cancel",
      "actor": "user",
      "reads": [
        "installation"
      ],
      "writes": [
        "installation",
        "calendar.installation_event",
        "ui"
      ],
      "description": "显式取消未出发的安装预约并删除关联日程",
      "payload": {}
    },
    {
      "id": "installation.choose_day",
      "actor": "user",
      "reads": [
        "fixture.installation.days"
      ],
      "writes": [
        "installation.selected_day",
        "installation.selected_slot_id"
      ],
      "description": "选择日期，清除旧日期下的草稿时段",
      "payload": {
        "date": "2026-09-19|2026-09-20"
      }
    },
    {
      "id": "installation.choose_slot",
      "actor": "user",
      "reads": [
        "calendar.events",
        "fixture.installation.slots"
      ],
      "writes": [
        "installation.selected_slot_id"
      ],
      "description": "仅选择无冲突时段",
      "payload": {
        "slot_id": "morning|afternoon"
      }
    },
    {
      "id": "installation.close_slots",
      "actor": "user",
      "reads": [
        "installation.booked_slot_id"
      ],
      "writes": [
        "ui",
        "installation.selected_slot_id",
        "installation.selected_day"
      ],
      "description": "撤销草稿，保留旧预约",
      "payload": {}
    },
    {
      "id": "installation.completed",
      "actor": "provider",
      "reads": [
        "installation",
        "fixture.payment"
      ],
      "writes": [
        "installation.status",
        "payment.status"
      ],
      "description": "安装完成并创建唯一待支付请求，不扣款",
      "payload": {}
    },
    {
      "id": "installation.confirm",
      "actor": "user",
      "reads": [
        "calendar.events",
        "fixture.authorizations"
      ],
      "writes": [
        "installation",
        "calendar.installation_event",
        "ui"
      ],
      "description": "再次校验冲突，提交预约并按已有授权同步日历",
      "payload": {}
    },
    {
      "id": "installation.defer",
      "actor": "user",
      "reads": [
        "installation.booked_slot_id"
      ],
      "writes": [
        "ui",
        "installation.selected_slot_id"
      ],
      "description": "暂不预约，仅收起预约入口",
      "payload": {}
    },
    {
      "id": "installation.open_slots",
      "actor": "user",
      "reads": [
        "installation",
        "calendar"
      ],
      "writes": [
        "ui",
        "installation.selected_slot_id",
        "installation.selected_day"
      ],
      "description": "展开安装时段",
      "payload": {}
    },
    {
      "id": "installation.reschedule",
      "actor": "user",
      "reads": [
        "installation",
        "calendar"
      ],
      "writes": [
        "ui",
        "installation.selected_slot_id",
        "installation.selected_day"
      ],
      "description": "编辑已有预约的草稿",
      "payload": {}
    },
    {
      "id": "installation.technician_departed",
      "actor": "provider",
      "reads": [
        "installation"
      ],
      "writes": [
        "installation.status"
      ],
      "description": "已有预约的师傅出发，不倒退完成状态",
      "payload": {}
    },
    {
      "id": "logistics.delivered",
      "actor": "provider",
      "reads": [
        "order"
      ],
      "writes": [
        "delivery",
        "installation.status"
      ],
      "description": "服务回传收货并提供安装入口",
      "payload": {}
    },
    {
      "id": "logistics.out_for_delivery",
      "actor": "provider",
      "reads": [
        "order"
      ],
      "writes": [
        "delivery"
      ],
      "description": "服务回传派送进度，不倒退已送达状态",
      "payload": {}
    },
    {
      "id": "navigation.desktop",
      "actor": "user",
      "reads": [
        "order"
      ],
      "writes": [
        "ui"
      ],
      "description": "返回系统桌面",
      "payload": {}
    },
    {
      "id": "navigation.open_app",
      "actor": "user",
      "reads": [
        "ui"
      ],
      "writes": [
        "ui"
      ],
      "description": "打开所属应用，交由宿主展示详情",
      "payload": {
        "app": "shopping|logistics|installation|calendar|payment",
        "page": "optional string"
      }
    },
    {
      "id": "order.purchase_demo",
      "actor": "user",
      "reads": [
        "fixture.order"
      ],
      "writes": [
        "order",
        "ui"
      ],
      "description": "创建已有付款的演示订单",
      "payload": {}
    },
    {
      "id": "payment.cancel",
      "actor": "user",
      "reads": [
        "payment"
      ],
      "writes": [
        "payment.status"
      ],
      "description": "只撤销待支付请求，不能退款或取消安装",
      "payload": {}
    },
    {
      "id": "payment.pay",
      "actor": "user",
      "reads": [
        "fixture.payment",
        "payment"
      ],
      "writes": [
        "payment"
      ],
      "description": "明确用户动作，校验单号/整数分/币种，创建唯一模拟回执",
      "payload": {
        "invoice_id": "invoice-materials-aircon-001",
        "amount_minor": 13000,
        "currency": "CNY"
      }
    },
    {
      "id": "payment.reopen",
      "actor": "user",
      "reads": [
        "payment"
      ],
      "writes": [
        "payment.status"
      ],
      "description": "重新打开已撤销但未付款的请求",
      "payload": {}
    }
  ],
