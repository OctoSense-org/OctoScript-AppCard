  "data_relations": [
    {
      "from": "order",
      "to": "delivery",
      "key": "order.id",
      "purpose": "订单触发配送进度"
    },
    {
      "from": "delivery.delivered",
      "to": "installation",
      "purpose": "收货事件触发预约入口"
    },
    {
      "from": "calendar.events",
      "to": "installation.slots",
      "purpose": "即时检查时间冲突，提交前重新检查"
    },
    {
      "from": "installation.booking",
      "to": "calendar.installation_event",
      "key": "booking.id + stable calendar_event_id",
      "purpose": "已有授权时先更新日程，再呈现确认与撤销"
    },
    {
      "from": "installation.completed",
      "to": "payment.invoice",
      "key": "installation.id + stable invoice_id",
      "purpose": "材料费待支付，由用户确认后生成唯一模拟回执"
    }
  ],
  "invariants": [
    "Money is integer minor units; invoice display and payment payload must match",
    "Calendar undo never cancels a booking",
    "Explicit booking cancellation removes only its own calendar event",
    "Calendar restore and rescheduling use stable IDs",
    "Day/slot changes only affect drafts until confirmed",
    "Provider updates are monotonic and never authorize payment",
    "Pending payment cancellation is not refund",
    "Card body navigation never changes domain records",
    "Native controls bind semantic actions and enabled state; frame_id only names design reference"
  ],
  "native_binding": {
    "card_identity": "view.cards[].id",
    "label": "view.cards[].title and data fields",
    "buttons": "view.cards[].actions with enabled and payload",
    "card_body": "view.cards[].body_action",
    "route": "view.app_route (host must implement detail layout)",
    "live_state": "view.bindings",
    "native_validation": "Makepad Studio instrument click + widget state + screenshot; reducer tests are separate"
  },
