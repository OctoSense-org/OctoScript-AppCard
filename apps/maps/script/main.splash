let origin = {lat: 37.3350 lon: -121.8850 name: "San Jose (downtown)" picked: false}
let q = ""
let loaded_q = ""
let hits = []
let place = nil
let screen = "search"   // search | place | route | drive | origin
let mode = "drive"
let recents = []
let shown_route = ""
let finding = ""        // "" | "origin": the search picks the start instead

fn fix_origin(){
    if origin.picked { return }
    if sys.gps("ok") >= 1 {
        origin = {lat: sys.gps("lat") lon: sys.gps("lon") name: "Your location" picked: false}
    }
}
fn load_recents(){
    if fs.exists("recents.json") {
        let v = fs.read("recents.json").parse_json()
        if v != nil { recents = v }
    }
}
fn remember(p){
    recents.retain(|r| r.name != p.name)
    recents.push(p)
    if recents.len() > 8 { recents.remove(0) }
    fs.write("recents.json", recents.to_json())
}
fn search_for(text){
    q = ("" + text).trim()
    loaded_q = ""
    hits = []
    ui.results.render()
}
fn read_hits(){
    if q == "" || loaded_q == q { return }
    let n = sys.searchnum(q, 0, "count")
    if n < 0 { return }
    hits = []
    for i in n {
        if i < 6 {
            hits.push({name: sys.search(q, i, "name") cat: sys.search(q, i, "cat") label: sys.search(q, i, "label")
                lat: sys.searchnum(q, i, "lat") lon: sys.searchnum(q, i, "lon")})
        }
    }
    loaded_q = q
    ui.results.render()
}
fn pick(p){
    if finding == "origin" {
        origin = {lat: p.lat lon: p.lon name: p.name picked: true}
        finding = ""
        show("route")
        return
    }
    place = p
    remember(p)
    show("place")
}
fn use_my_location(){
    origin = {lat: origin.lat lon: origin.lon name: "Your location" picked: false}
    fix_origin()
    finding = ""
    show("route")
}
fn show(s){
    screen = s
    shown_route = ""
    ui.search_panel.set_visible(s == "search" || s == "origin")
    ui.place_panel.set_visible(s == "place")
    ui.route_panel.set_visible(s == "route")
    ui.plan_box.set_visible(s != "drive")
    ui.drive_box.set_visible(s == "drive")
    ui.drive_bar.set_visible(s == "drive")
    if s == "place" {
        ui.pname.set_text(place.name)
        ui.pcat.set_text(place.cat)
        ui.paddr.set_text(place.label)
        ui.peta.set_text("")
    }
    if s == "route" {
        ui.rfrom.set_text(origin.name)
        ui.rto.set_text(place.name)
        ui.modes.render()
    }
    if s == "search" || s == "origin" {
        if s == "origin" { ui.search_hint.set_text("Choose a start") } else { ui.search_hint.set_text("Where to?") }
        ui.results.render()
    }
    tick()
}
fn set_mode(m){ mode = m; shown_route = ""; ui.modes.render(); tick() }
fn eta_field(){
    if mode == "walk" { return "walk" }
    if mode == "bike" { return "bike" }
    "min"
}
fn route_key(){ "" + origin.lat + "," + origin.lon + ">" + place.lat + "," + place.lon + ":" + mode }
fn draw_route(map){
    let key = route_key()
    if shown_route == key { return }
    let line = sys.navroute(origin.lat, origin.lon, place.lat, place.lon, "polyline")
    if line == "" { return }
    map.set_nav_polyline(line)
    map.set_route_markers("" + origin.lat + "," + origin.lon + ",0;" + place.lat + "," + place.lon + ",2")
    shown_route = key
}
fn progress(){
    if sys.gps("ok") >= 1 {
        return sys.navprog(origin.lat, origin.lon, place.lat, place.lon, sys.gps("lat"), sys.gps("lon"))
    }
    // No fix: the demo vehicle drives the route at 34 mph.
    let km = sys.navroutenum(origin.lat, origin.lon, place.lat, place.lon, "km", "")
    if km <= 0 { return 0 }
    sys.navsecs(km * 1000 / 15.2) * 15.2
}
fn tick(){
    fix_origin()
    if screen == "search" || screen == "origin" { read_hits() }
    if screen == "place" {
        ui.peta.set_text(sys.navroute(origin.lat, origin.lon, place.lat, place.lon, "min") + "  ·  " + sys.navroute(origin.lat, origin.lon, place.lat, place.lon, "km"))
        draw_route(ui.plan_map)
    }
    if screen == "route" {
        ui.reta.set_text(sys.navroute(origin.lat, origin.lon, place.lat, place.lon, eta_field()))
        ui.rdist.set_text(sys.navroute(origin.lat, origin.lon, place.lat, place.lon, "km"))
        ui.rfrom.set_text(origin.name)
        draw_route(ui.plan_map)
    }
    if screen == "drive" {
        draw_route(ui.drive_map)
        let d = progress()
        ui.instr.set_text(sys.navstep(origin.lat, origin.lon, place.lat, place.lon, d, "instr"))
        ui.arrow.set_text(sys.navstep(origin.lat, origin.lon, place.lat, place.lon, d, "arrow"))
        ui.ndist.set_text(sys.navstep(origin.lat, origin.lon, place.lat, place.lon, d, "dist"))
        ui.remain.set_text(sys.navstep(origin.lat, origin.lon, place.lat, place.lon, d, "remmin") + " min  ·  " + sys.navstep(origin.lat, origin.lon, place.lat, place.lon, d, "rem"))
    }
}
fn boot(){
    load_recents()
    fix_origin()
    show("search")
}
start_timeout(0.05, || boot())
start_interval(0.5, || tick())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #x1a73e8

let Pill = ButtonFlat{height: 34 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 17.0 color: #xf1f3f4 color_hover: #xe8eaed color_down: #xdadce0 border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
let PillOn = Pill{
    draw_bg +: {color: accent color_hover: accent color_down: #x1557b0}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}
}
let Primary = ButtonFlat{height: 44 width: Fill align: Align{x: 0.5 y: 0.5}
    draw_bg +: {border_radius: 22.0 color: accent color_hover: #x1765cc color_down: #x1557b0 border_size: 0.0}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: theme.font_bold{font_size: 15}}
}
let Link = ButtonFlat{height: 32 padding: Inset{left: 8 right: 8}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 14}}
}
let Panel = RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 14 bottom: 18} spacing: 8
    new_batch: true show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 18.0
}
let HitRow = GestureView{width: Fill height: Fit flow: Down padding: Inset{top: 8 bottom: 8} spacing: 2
    name := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
    label := Label{width: Fill text: "" max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 12}
}

View{width: Fill height: Fill flow: Overlay show_bg: true draw_bg.color: #xe8eaed
    plan_box := View{width: Fill height: Fill
        plan_map := MapView{width: Fill height: Fill nav_mode: "plan" nav_route_width: 36.0 zoom: 13.0 min_zoom: 3.0 max_zoom: 18.0
            center_lat: 37.3350 center_lon: -121.8850 use_network: true use_local_mbtiles: false debug_cam: false}
    }
    drive_box := View{visible: false width: Fill height: Fill
        drive_map := MapView{width: Fill height: Fill nav_mode: "3d" nav_period: 100 nav_route_width: 14.0 zoom: 15.0 min_zoom: 3.0 max_zoom: 19.0
            center_lat: 37.3350 center_lon: -121.8850 use_network: true use_local_mbtiles: false debug_cam: false}
    }
    View{width: Fill height: Fill flow: Down padding: Inset{left: 10 right: 10 top: 10 bottom: 16}
        search_panel := Panel{
            search_hint := Label{text: "Where to?" draw_text.color: secondary draw_text.text_style.font_size: 12}
            TextInput{width: Fill height: 40 empty_text: "Search Maps"
                on_return: |text| search_for(text)
                draw_bg +: {color: #xf1f3f4 color_hover: #xf1f3f4 color_focus: #xf1f3f4 color_empty: #xf1f3f4
                    border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                    border_radius: 20.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
            }
            results := View{width: Fill height: Fit flow: Down on_render: || {
                if screen == "origin" { Link{text: "◎  Your location" on_click: || use_my_location()} }
                if q != "" && loaded_q != q { Label{text: "Searching…" draw_text.color: secondary draw_text.text_style.font_size: 12} }
                else if q != "" && hits.len() == 0 { Label{text: "No places found." draw_text.color: secondary draw_text.text_style.font_size: 12} }
                for h in hits { HitRow{on_tap: |x, y| pick(h) name.text: h.name label.text: h.label} }
                if q == "" && recents.len() > 0 {
                    Label{text: "Recent" draw_text.color: secondary draw_text.text_style.font_size: 11}
                    for r in recents { HitRow{on_tap: |x, y| pick(r) name.text: r.name label.text: r.label} }
                }
            }}
        }
        View{width: Fill height: Fill}
        place_panel := Panel{visible: false
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                pname := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                Link{text: "Close" on_click: || show("search")}
            }
            pcat := Label{width: Fill text: "" draw_text.color: #xe37400 draw_text.text_style.font_size: 12}
            paddr := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            peta := Label{width: Fill text: "" draw_text.color: #x188038 draw_text.text_style.font_size: 13}
            Primary{text: "Directions" on_click: || show("route")}
        }
        route_panel := Panel{visible: false
            modes := View{width: Fill height: Fit flow: Right spacing: 6 on_render: || {
                if mode == "drive" { PillOn{text: "Drive"} } else { Pill{text: "Drive" on_click: || set_mode("drive")} }
                if mode == "walk" { PillOn{text: "Walk"} } else { Pill{text: "Walk" on_click: || set_mode("walk")} }
                if mode == "bike" { PillOn{text: "Bike"} } else { Pill{text: "Bike" on_click: || set_mode("bike")} }
            }}
            View{width: Fill height: Fit flow: Right align: Align{y: 1.0} spacing: 8
                reta := Label{text: "" draw_text.color: #x188038 draw_text.text_style: theme.font_bold{font_size: 22}}
                rdist := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
            }
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                Label{text: "From  " draw_text.color: secondary draw_text.text_style.font_size: 12}
                rfrom := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style.font_size: 14}
                Link{text: "Change" on_click: || { finding = "origin"; q = ""; hits = []; show("origin") }}
            }
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                Label{text: "To  " draw_text.color: secondary draw_text.text_style.font_size: 12}
                rto := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style.font_size: 14}
            }
            View{width: Fill height: Fit flow: Right spacing: 8
                Link{text: "‹ Back" on_click: || show("place")}
                Primary{text: "Start" on_click: || show("drive")}
            }
        }
    }
    drive_bar := View{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 10 right: 10 top: 10 bottom: 16}
        banner := RoundedView{width: Fill height: Fit flow: Right spacing: 12 padding: 14 align: Align{y: 0.5}
            new_batch: true show_bg: true draw_bg.color: #x0b8043 draw_bg.border_radius: 16.0
            arrow := Label{text: "" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 30}}
            View{width: Fill height: Fit flow: Down spacing: 2
                ndist := Label{text: "" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 20}}
                instr := Label{width: Fill text: "" draw_text.color: #xffffff draw_text.text_style.font_size: 14}
            }
        }
        View{width: Fill height: Fill}
        Panel{flow: Right align: Align{y: 0.5}
            remain := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
            Link{text: "End" on_click: || show("route")}
        }
    }
}
