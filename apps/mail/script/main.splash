let account = nil          // {id, address}
let messages = []
let total = 0
let open_id = ""
let reading = nil
let busy = false
let folder = {id: "INBOX" name: "Inbox"}
let folders = []

fn status(text){ ui.status.set_text(text) }
fn pane(name){
    ui.welcome.set_visible(name == "welcome")
    ui.inbox.set_visible(name == "inbox")
    ui.reader.set_visible(name == "reader")
    ui.composer.set_visible(name == "composer")
    ui.folders.set_visible(name == "folders")
}
fn load_accounts(){
    host.request("mail.accounts", {}, fn(r){
        if r.is_ok && r.data.len() > 0 {
            account = r.data[0]
            ui.address.set_text(account.address)
            pane("inbox")
            list()
            sync()
            load_folders()
        } else {
            pane("welcome")
        }
    })
}
fn add_account(){
    ui.welcome_note.set_text("Sign in on the sheet OctoSense shows.")
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok { load_accounts() } else { ui.welcome_note.set_text(r.error) }
    })
}
fn sync(){
    if account == nil || busy { return }
    busy = true
    status("Checking for mail…")
    host.request("mail.sync", {account: account.id folder: folder.id}, fn(r){
        busy = false
        if r.is_ok {
            if r.data.new == 1 { status("1 new message") }
            else if r.data.new > 0 { status("" + r.data.new + " new messages") }
            else { status("Up to date") }
            list()
        } else { status(r.error) }
    })
}
fn list(){
    host.request("mail.list", {account: account.id folder: folder.id offset: 0 limit: 100}, fn(r){
        if r.is_ok {
            messages = r.data.messages
            total = r.data.total
            ui.rows.render()
        } else { status(r.error) }
    })
}
fn open_message(m){
    open_id = m.id
    host.request("mail.message", {account: account.id folder: folder.id message: m.id}, fn(r){
        if r.is_ok {
            reading = r.data
            ui.r_subject.set_text(r.data.subject)
            ui.r_sender.set_text(r.data.sender + "  <" + r.data.address + ">")
            ui.r_time.set_text(r.data.time)
            // Formatted mail shows as the host rebuilt it: text, links and
            // lists, nothing remote.
            let formatted = r.data.html != ""
            ui.r_html.set_visible(formatted)
            ui.r_body.set_visible(!formatted)
            if formatted { ui.r_html.set_text(r.data.html) } else { ui.r_body.set_text(r.data.body) }
            let names = ""
            for a in r.data.attachments {
                if names != "" { names = names + ", " }
                names = names + a.filename + " (" + kb(a.size) + ")"
            }
            ui.r_attachments.set_visible(names != "")
            ui.r_attachments.set_text("Attachments: " + names)
            pane("reader")
            m.unread = false
        } else { status(r.error) }
    })
}
fn compose(to, subject, body){
    ui.c_to.set_text(to)
    ui.c_subject.set_text(subject)
    ui.c_body.set_text(body)
    ui.c_note.set_text("")
    pane("composer")
}
fn reply(){
    if reading == nil { return }
    let subject = reading.subject
    if subject.search("Re:") != 0 { subject = "Re: " + subject }
    compose(reading.address, subject, "\n\n> " + reading.body.replace("\n", "\n> "))
}
fn send(){
    ui.c_note.set_text("Sending…")
    host.request("mail.send", {account: account.id to: ui.c_to.text() subject: ui.c_subject.text() body: ui.c_body.text()}, fn(r){
        if r.is_ok { status("Sent"); pane("inbox"); ui.rows.render() } else { ui.c_note.set_text(r.error) }
    })
}
fn remove_account(){
    host.request("mail.remove_account", {account: account.id}, fn(r){
        account = nil
        messages = []
        folders = []
        folder = {id: "INBOX" name: "Inbox"}
        ui.title.set_text("Inbox")
        pane("welcome")
    })
}
fn back_to_inbox(){ pane("inbox"); ui.rows.render() }
fn kb(n){
    if n > 1000000 { return "" + floor(n / 100000) / 10 + " MB" }
    return "" + (floor(n / 1000) + 1) + " KB"
}
fn load_folders(){
    host.request("mail.folders", {account: account.id}, fn(r){
        if r.is_ok { folders = r.data; ui.folder_rows.render() }
    })
}
fn show_folders(){ pane("folders"); ui.folder_rows.render() }
fn open_folder(f){
    folder = f
    messages = []
    ui.title.set_text(f.name)
    pane("inbox")
    ui.rows.render()
    list()
    sync()
}

start_timeout(0.05, || load_accounts())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #x007aff
let Bar = ButtonFlat{height: 36 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}
}
let Field = TextInput{width: Fill height: 40
    draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7
        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000 border_radius: 10.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
}
let Row = GestureView{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 10} spacing: 2
    top := View{width: Fill height: Fit flow: Right
        sender := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
        time := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
    }
    subject := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style.font_size: 14}
    preview := Label{width: Fill text: "" max_lines: 2 draw_text.color: secondary draw_text.text_style.font_size: 13}
}
let RowRead = Row{top +: {sender +: {draw_text.text_style: theme.font_regular{font_size: 15}}}}

SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: #xffffff
    welcome := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 12 padding: 32
        Label{text: "Mail" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 32}}
        Label{width: Fill align: Align{x: 0.5} text: "Add an account to read and send mail. OctoSense keeps your password; Mail never sees it."
            draw_text.color: secondary draw_text.text_style.font_size: 13}
        ButtonFlat{text: "Add account" height: 44 padding: Inset{left: 22 right: 22} on_click: || add_account()
            draw_bg +: {border_radius: 22.0 color: #x007aff color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style +: {font_size: 15}}}
        welcome_note := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
    }
    inbox := View{visible: false width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8 top: 8}
            Bar{text: "Folders" on_click: || show_folders()}
            Bar{text: "Refresh" on_click: || sync()}
            View{width: Fill height: 1}
            Bar{text: "Compose" on_click: || compose("", "", "")}
        }
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 bottom: 6} spacing: 2
            title := Label{text: "Inbox" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 30}}
            address := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            status := Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
        }
        rows := ScrollYView{width: Fill height: Fill flow: Down on_render: || {
            if messages.len() == 0 {
                View{width: Fill height: 160 align: Align{x: 0.5 y: 0.5}
                    Label{text: "No mail yet." draw_text.color: secondary draw_text.text_style.font_size: 13}}
            }
            else for m in messages {
                if m.unread {
                    Row{on_tap: |x, y| open_message(m) top.sender.text: m.sender top.time.text: m.time subject.text: m.subject preview.text: m.preview}
                } else {
                    RowRead{on_tap: |x, y| open_message(m) top.sender.text: m.sender top.time.text: m.time subject.text: m.subject preview.text: m.preview}
                }
                Hr{}
            }
        }}
        View{width: Fill height: Fit padding: Inset{left: 8 bottom: 8}
            ButtonFlat{text: "Remove account" on_click: || remove_account()
                draw_bg +: {color: #x00000000 color_hover: #x00000000 color_down: #x00000000 border_size: 0.0}
                draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style +: {font_size: 12}}}
        }
    }
    reader := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #xffffff
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8 top: 8}
            Bar{text: "‹ Back" on_click: || back_to_inbox()}
            View{width: Fill height: 1}
            Bar{text: "Reply" on_click: || reply()}
        }
        ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 6
            r_subject := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            r_sender := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
            r_time := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            Hr{}
            r_attachments := Label{visible: false width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
            r_body := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 15}
            r_html := Html{visible: false width: Fill height: Fit padding: 0 font_color: ink font_size: 15
                draw_text +: {color: ink}
                text_style_normal +: {font_size: 15} text_style_bold +: {font_size: 15}
                text_style_italic +: {font_size: 15} text_style_bold_italic +: {font_size: 15} text_style_fixed +: {font_size: 14}}
        }
    }
    folders := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #xffffff
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8 top: 8}
            Bar{text: "‹ Back" on_click: || back_to_inbox()}
        }
        View{width: Fill height: Fit padding: Inset{left: 16 right: 16 bottom: 6}
            Label{text: "Folders" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 30}}
        }
        folder_rows := ScrollYView{width: Fill height: Fill flow: Down on_render: || {
            if folders.len() == 0 {
                View{width: Fill height: 120 align: Align{x: 0.5 y: 0.5}
                    Label{text: "Looking for folders…" draw_text.color: secondary draw_text.text_style.font_size: 13}}
            }
            else for f in folders {
                GestureView{width: Fill height: 48 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 16} on_tap: |x, y| open_folder(f)
                    Label{width: Fill text: f.name draw_text.color: ink draw_text.text_style.font_size: 16}
                }
                Hr{}
            }
        }}
    }
    composer := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #xffffff padding: Inset{left: 12 right: 12 top: 8} spacing: 8
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Bar{text: "Cancel" on_click: || back_to_inbox()}
            View{width: Fill height: 1}
            Bar{text: "Send" on_click: || send()}
        }
        c_to := Field{empty_text: "To"}
        c_subject := Field{empty_text: "Subject"}
        c_body := Field{height: 260 empty_text: "Message"}
        c_note := Label{width: Fill text: "" draw_text.color: #xff3b30 draw_text.text_style.font_size: 12}
    }
}

